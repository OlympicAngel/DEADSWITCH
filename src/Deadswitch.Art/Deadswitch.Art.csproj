       data to Meshes; tools/basepreview renders the same data with three.js for headless review. -->
  <ItemGroup>
    <ProjectReference Include="..\Deadswitch.Sim\Deadswitch.Sim.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Deadswitch.Art</AssemblyName>
  </PropertyGroup>
</Project>
