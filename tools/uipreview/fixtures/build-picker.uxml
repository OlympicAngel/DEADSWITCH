<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <!-- Static mirror of SlotSheet.Empty build picker (SPEC-042 finding 7) -->
  <Style src="Base.uss" />
  <ui:VisualElement class="ds-sheet sheet">
    <ui:VisualElement class="ds-sheet__grip" />
    <ui:VisualElement class="sheet__head"><ui:VisualElement class="sheet__well"><ui:VisualElement class="ds-icon ds-icon--plus sheet__icon" /></ui:VisualElement><ui:VisualElement class="sheet__titles"><ui:Label text="OPEN PLOT" class="sheet__title" /><ui:Label text="PLOT 4  //  CHOOSE WHAT TO BUILD" class="sheet__level" /></ui:VisualElement><ui:VisualElement class="ds-iconbtn"><ui:VisualElement class="ds-icon ds-icon--close ds-iconbtn__icon" /></ui:VisualElement></ui:VisualElement>
    <ui:VisualElement class="ds-seg build-tabs"><ui:VisualElement class="ds-seg__item build-tab is-selected"><ui:VisualElement class="ds-icon ds-icon--bolt build-tab__icon" /><ui:Label text="POWER" class="build-tab__label" /></ui:VisualElement><ui:VisualElement class="ds-seg__item build-tab"><ui:VisualElement class="ds-icon ds-icon--chip build-tab__icon" /><ui:Label text="COMPUTE" class="build-tab__label" /></ui:VisualElement><ui:VisualElement class="ds-seg__item build-tab"><ui:VisualElement class="ds-icon ds-icon--people build-tab__icon" /><ui:Label text="PEOPLE" class="build-tab__label" /></ui:VisualElement><ui:VisualElement class="ds-seg__item build-tab"><ui:VisualElement class="ds-icon ds-icon--shield build-tab__icon" /><ui:Label text="DEFENSE" class="build-tab__label" /></ui:VisualElement></ui:VisualElement>
    <ui:VisualElement class="build-grid"><ui:VisualElement class="build-card "><ui:VisualElement class="build-card__top"><ui:VisualElement class="build-card__well"><ui:VisualElement class="ds-icon ds-icon--bolt build-card__icon" /></ui:VisualElement></ui:VisualElement><ui:Label text="GENERATOR" class="build-card__name" /><ui:Label text="+120 ENERGY/H" class="build-card__out" /><ui:VisualElement class="cost"><ui:Label text="E 400" class="cost__item" /></ui:VisualElement><ui:Label text="BUILD 30M" class="build-card__foot" /></ui:VisualElement><ui:VisualElement class="build-card is-recommended"><ui:VisualElement class="build-card__top"><ui:VisualElement class="build-card__well"><ui:VisualElement class="ds-icon ds-icon--sun build-card__icon" /></ui:VisualElement><ui:Label text="SUGGESTED" class="build-card__tag" /></ui:VisualElement><ui:Label text="SOLAR FIELD" class="build-card__name" /><ui:Label text="+90 ENERGY/H BY DAY" class="build-card__out" /><ui:VisualElement class="cost"><ui:Label text="E 300  C 20" class="cost__item" /></ui:VisualElement><ui:Label text="BUILD 45M" class="build-card__foot" /></ui:VisualElement><ui:VisualElement class="build-card is-waiting"><ui:VisualElement class="build-card__top"><ui:VisualElement class="build-card__well"><ui:VisualElement class="ds-icon ds-icon--battery build-card__icon" /></ui:VisualElement></ui:VisualElement><ui:Label text="BATTERY BANK" class="build-card__name" /><ui:Label text="+250 ENERGY STORAGE" class="build-card__out" /><ui:VisualElement class="cost"><ui:Label text="E 620" class="cost__item is-short" /></ui:VisualElement><ui:Label text="IN 2H 10M" class="build-card__foot" /></ui:VisualElement><ui:VisualElement class="build-card is-locked"><ui:VisualElement class="build-card__top"><ui:VisualElement class="build-card__well"><ui:VisualElement class="ds-icon ds-icon--lock build-card__icon" /></ui:VisualElement></ui:VisualElement><ui:Label text="REACTOR" class="build-card__name" /><ui:Label text="+600 ENERGY/H" class="build-card__out" /><ui:Label text="LOCKED // TIER 3" class="build-card__foot" /></ui:VisualElement></ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>