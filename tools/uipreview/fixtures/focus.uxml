<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <!-- Static mirror of focus mode (SPEC-039 C): selected label, quick-action tiles (UI/Base/QuickActions), compact sheet -->
  <Style src="Base.uss" />
  <ui:VisualElement style="flex-grow: 1;">
    <ui:VisualElement class="lbl is-selected" style="left: 540px; top: 640px;">
      <ui:Label text="GENERATOR" class="lbl__name" />
      <ui:VisualElement class="lbl__sub"><ui:VisualElement class="ds-pip" /><ui:Label text="LVL 2" class="lbl__level" /></ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement class="lbl is-faded" style="left: 220px; top: 520px;"><ui:Label text="SERVER RACK" class="lbl__name" /><ui:VisualElement class="lbl__sub"><ui:Label text="LVL 1" class="lbl__level" /></ui:VisualElement></ui:VisualElement>
    <ui:VisualElement class="lbl lbl--empty is-faded" style="left: 860px; top: 560px;"><ui:Label text="OPEN PLOT" class="lbl__name" /><ui:VisualElement class="lbl__sub"><ui:Label text="+ BUILD" class="lbl__level" /></ui:VisualElement></ui:VisualElement>
    <ui:VisualElement class="qa" style="left: 540px; top: 860px;">
      <ui:VisualElement class="ds-tile ds-tile--primary is-disabled"><ui:VisualElement class="ds-icon ds-icon--up ds-tile__icon" /><ui:Label text="UPGRADE" class="ds-tile__label" /><ui:Label text="NEED 140 E" class="ds-tile__cost is-short" /></ui:VisualElement>
      <ui:VisualElement class="ds-tile"><ui:VisualElement class="ds-icon ds-icon--power ds-tile__icon" /><ui:Label text="POWER OFF" class="ds-tile__label" /></ui:VisualElement>
      <ui:VisualElement class="ds-tile"><ui:VisualElement class="ds-icon ds-icon--info ds-tile__icon" /><ui:Label text="DETAILS" class="ds-tile__label" /></ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement class="ds-sheet sheet">
      <ui:VisualElement class="ds-sheet__grip" />
      <ui:VisualElement class="sheet__head">
        <ui:VisualElement class="sheet__well"><ui:VisualElement class="ds-icon ds-icon--bolt sheet__icon" /></ui:VisualElement>
        <ui:VisualElement class="sheet__titles"><ui:Label text="GENERATOR" class="sheet__title" /><ui:Label text="LEVEL 2 / 5" class="sheet__level" /></ui:VisualElement>
        <ui:VisualElement class="ds-iconbtn"><ui:VisualElement class="ds-icon ds-icon--close ds-iconbtn__icon" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement class="sheet__chips"><ui:VisualElement class="ds-chip ds-chip--phosphor"><ui:Label text="POWERED" class="ds-chip__label" /></ui:VisualElement><ui:VisualElement class="ds-chip"><ui:Label text="CREWED 2" class="ds-chip__label" /></ui:VisualElement><ui:VisualElement class="ds-chip"><ui:Label text="PRIORITY #1" class="ds-chip__label" /></ui:VisualElement></ui:VisualElement>
      <ui:Label text="Scavenged plant. Everything else runs on what this makes." class="sheet__blurb" />
      <ui:VisualElement class="sheet__tiles">
        <ui:VisualElement class="sheet__tile"><ui:VisualElement class="sheet__tile-top"><ui:VisualElement class="ds-icon ds-icon--trendup sheet__tile-icon" /><ui:Label text="OUTPUT" class="sheet__tile-key" /></ui:VisualElement><ui:Label text="+120 ENERGY/H" class="sheet__tile-value" /><ui:Label text="NEXT  +180 ENERGY/H" class="sheet__tile-next" /></ui:VisualElement>
        <ui:VisualElement class="sheet__tile"><ui:VisualElement class="sheet__tile-top"><ui:VisualElement class="ds-icon ds-icon--bolt sheet__tile-icon" /><ui:Label text="UPKEEP" class="sheet__tile-key" /></ui:VisualElement><ui:Label text="12/H" class="sheet__tile-value" /><ui:Label text="NEXT  18/H" class="sheet__tile-next" /></ui:VisualElement>
        <ui:VisualElement class="sheet__tile is-last"><ui:VisualElement class="sheet__tile-top"><ui:VisualElement class="ds-icon ds-icon--people sheet__tile-icon" /><ui:Label text="CREW" class="sheet__tile-key" /></ui:VisualElement><ui:Label text="2" class="sheet__tile-value" /><ui:Label text="NEXT  3" class="sheet__tile-next" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement class="ds-btn ds-btn--ghost sheet__more"><ui:Label text="ALL DETAILS AND ACTIONS" class="ds-btn__label" /></ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
