  <ui:VisualElement class="cmenu"><ui:VisualElement class="cmenu__backdrop" />
    <ui:VisualElement class="cmenu__drawer">
      <ui:VisualElement class="cmenu__head"><ui:VisualElement class="cmenu__titles"><ui:Label text="COMMAND" class="cmenu__title" /><ui:Label text="HUB S-17 // TIER 1 // DAY 03" class="cmenu__status" /></ui:VisualElement><ui:VisualElement class="ds-iconbtn"><ui:VisualElement class="ds-icon ds-icon--close ds-iconbtn__icon" /></ui:VisualElement></ui:VisualElement>
      <ui:VisualElement class="ds-section"><ui:VisualElement class="ds-icon ds-icon--people ds-section__icon" /><ui:Label text="THE HUB" class="ds-section__title" /><ui:VisualElement class="ds-section__rule" /></ui:VisualElement><ui:VisualElement class="cmenu__item"><ui:VisualElement class="cmenu__well"><ui:VisualElement class="ds-icon ds-icon--people cmenu__icon" /></ui:VisualElement><ui:VisualElement class="cmenu__body"><ui:Label text="WORKFORCE" class="cmenu__name" /><ui:Label text="Your people: workers, defenders, loyalty and hard choices." class="cmenu__meaning" /></ui:VisualElement><ui:VisualElement class="ds-icon ds-icon--chevron cmenu__chev" /></ui:VisualElement><ui:VisualElement class="cmenu__item"><ui:VisualElement class="cmenu__well"><ui:VisualElement class="ds-icon ds-icon--mail cmenu__icon" /></ui:VisualElement><ui:VisualElement class="cmenu__body"><ui:Label text="DISPATCH" class="cmenu__name" /><ui:Label text="Ultimatums and dilemmas waiting for your answer." class="cmenu__meaning" /></ui:VisualElement><ui:VisualElement class="cmenu__badge"><ui:Label text="1" class="cmenu__badge-label" /></ui:VisualElement><ui:VisualElement class="ds-icon ds-icon--chevron cmenu__chev" /></ui:VisualElement><ui:VisualElement class="cmenu__item"><ui:VisualElement class="cmenu__well"><ui:VisualElement class="ds-icon ds-icon--report cmenu__icon" /></ui:VisualElement><ui:VisualElement class="cmenu__body"><ui:Label text="LAST REPORT" class="cmenu__name" /><ui:Label text="The latest fight, with the evidence." class="cmenu__meaning" /></ui:VisualElement><ui:VisualElement class="cmenu__badge"><ui:Label text="1" class="cmenu__badge-label" /></ui:VisualElement><ui:VisualElement class="ds-icon ds-icon--chevron cmenu__chev" /></ui:VisualElement><ui:VisualElement class="ds-section"><ui:VisualElement class="ds-icon ds-icon--book ds-section__icon" /><ui:Label text="RECORDS" class="ds-section__title" /><ui:VisualElement class="ds-section__rule" /></ui:VisualElement><ui:VisualElement class="cmenu__item"><ui:VisualElement class="cmenu__well"><ui:VisualElement class="ds-icon ds-icon--book cmenu__icon" /></ui:VisualElement><ui:VisualElement class="cmenu__body"><ui:Label text="STORY" class="cmenu__name" /><ui:Label text="Chapters and the memory fragments you recovered." class="cmenu__meaning" /></ui:VisualElement><ui:VisualElement class="ds-icon ds-icon--chevron cmenu__chev" /></ui:VisualElement><ui:VisualElement class="cmenu__item"><ui:VisualElement class="cmenu__well"><ui:VisualElement class="ds-icon ds-icon--cycle cmenu__icon" /></ui:VisualElement><ui:VisualElement class="cmenu__body"><ui:Label text="LEGACY" class="cmenu__name" /><ui:Label text="Your score, perks, and moving to a new Hub." class="cmenu__meaning" /></ui:VisualElement><ui:VisualElement class="ds-icon ds-icon--chevron cmenu__chev" /></ui:VisualElement><ui:VisualElement class="ds-section"><ui:VisualElement class="ds-icon ds-icon--gear ds-section__icon" /><ui:Label text="HELP AND SETTINGS" class="ds-section__title" /><ui:VisualElement class="ds-section__rule" /></ui:VisualElement><ui:VisualElement class="cmenu__item"><ui:VisualElement class="cmenu__well"><ui:VisualElement class="ds-icon ds-icon--book cmenu__icon" /></ui:VisualElement><ui:VisualElement class="cmenu__body"><ui:Label text="FIELD GUIDE" class="cmenu__name" /><ui:Label text="Every term in plain words: workers, defenders, heat, override..." class="cmenu__meaning" /></ui:VisualElement><ui:VisualElement class="ds-icon ds-icon--chevron cmenu__chev" /></ui:VisualElement><ui:VisualElement class="cmenu__item"><ui:VisualElement class="cmenu__well"><ui:VisualElement class="ds-icon ds-icon--star cmenu__icon" /></ui:VisualElement><ui:VisualElement class="cmenu__body"><ui:Label text="REWARD TRACK" class="cmenu__name" /><ui:Label text="Themes, AI voices and lore, earned by play." class="cmenu__meaning" /></ui:VisualElement><ui:VisualElement class="ds-icon ds-icon--chevron cmenu__chev" /></ui:VisualElement><ui:VisualElement class="cmenu__item"><ui:VisualElement class="cmenu__well"><ui:VisualElement class="ds-icon ds-icon--gear cmenu__icon" /></ui:VisualElement><ui:VisualElement class="cmenu__body"><ui:Label text="SETTINGS" class="cmenu__name" /><ui:Label text="Comfort, accessibility, camera and backup." class="cmenu__meaning" /></ui:VisualElement><ui:VisualElement class="ds-icon ds-icon--chevron cmenu__chev" /></ui:VisualElement>
