<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <!-- Static mirror of the next-goal card (UI/Hud/GoalCard) and a celebration banner (UI/Hud/Celebrations), SPEC-043 s5 -->
  <Style src="Hud.uss" />
  <ui:VisualElement style="position: absolute; left: 0; right: 0; top: 0; bottom: 0;">
    <ui:VisualElement class="celeb celeb--tier">
      <ui:VisualElement class="celeb__band">
        <ui:VisualElement class="celeb__well"><ui:VisualElement class="ds-icon ds-icon--up celeb__icon" /></ui:VisualElement>
        <ui:VisualElement class="celeb__body">
          <ui:Label text="TIER REACHED" class="celeb__kicker" />
          <ui:Label text="TIER 2 // DISTRICT" class="celeb__title" />
          <ui:Label text="+4 PLOTS. 6 people left to settle the new ground. We are bigger now. Bigger is louder." class="celeb__line" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement class="celeb celeb--module" style="top: 700px;">
      <ui:VisualElement class="celeb__band">
        <ui:VisualElement class="celeb__well"><ui:VisualElement class="ds-icon ds-icon--memory celeb__icon" /></ui:VisualElement>
        <ui:VisualElement class="celeb__body">
          <ui:Label text="MEMORY RESTORED" class="celeb__kicker" />
          <ui:Label text="SUPPLY ROUTING" class="celeb__title" />
          <ui:Label text="Generators and solar fields make 10% more energy." class="celeb__line" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement style="position: absolute; left: 0; right: 0; bottom: 420px;">
      <ui:VisualElement class="hud-goal">
        <ui:VisualElement class="hud-goal__well"><ui:VisualElement class="ds-icon ds-icon--up hud-goal__icon" /></ui:VisualElement>
        <ui:VisualElement class="hud-goal__body">
          <ui:Label text="NEXT GOAL // TIER 2 DISTRICT" class="hud-goal__title" />
          <ui:VisualElement class="row hud-goal__gates">
            <ui:VisualElement class="row hud-goal__gate"><ui:VisualElement class="ds-icon ds-icon--hammer hud-goal__gate-icon" /><ui:Label text="LEVELS 7/10" class="hud-goal__gate-label" /></ui:VisualElement>
            <ui:VisualElement class="row hud-goal__gate is-met"><ui:VisualElement class="ds-icon ds-icon--bolt hud-goal__gate-icon" /><ui:Label text="POWER +64/+40 H" class="hud-goal__gate-label" /></ui:VisualElement>
            <ui:VisualElement class="row hud-goal__gate"><ui:VisualElement class="ds-icon ds-icon--memory hud-goal__gate-icon" /><ui:Label text="SUPPLY ROUTING" class="hud-goal__gate-label" /></ui:VisualElement>
            <ui:VisualElement class="row hud-goal__gate is-met"><ui:VisualElement class="ds-icon ds-icon--people hud-goal__gate-icon" /><ui:Label text="6 PEOPLE" class="hud-goal__gate-label" /></ui:VisualElement>
          </ui:VisualElement>
          <ui:VisualElement class="ds-progress ds-progress--amber hud-goal__bar"><ui:VisualElement class="ds-progress__fill" style="width: 67%;" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="ds-icon ds-icon--chevron hud-goal__chev" />
      </ui:VisualElement>
      <ui:VisualElement class="hud-goal is-ready" style="margin-top: 16px;">
        <ui:VisualElement class="hud-goal__well"><ui:VisualElement class="ds-icon ds-icon--up hud-goal__icon" /></ui:VisualElement>
        <ui:VisualElement class="hud-goal__body">
          <ui:Label text="READY // ADVANCE TO TIER 2 DISTRICT" class="hud-goal__title" />
          <ui:VisualElement class="row hud-goal__gates">
            <ui:VisualElement class="row hud-goal__gate is-met"><ui:VisualElement class="ds-icon ds-icon--hammer hud-goal__gate-icon" /><ui:Label text="LEVELS 10/10" class="hud-goal__gate-label" /></ui:VisualElement>
            <ui:VisualElement class="row hud-goal__gate is-met"><ui:VisualElement class="ds-icon ds-icon--bolt hud-goal__gate-icon" /><ui:Label text="POWER +64/+40 H" class="hud-goal__gate-label" /></ui:VisualElement>
            <ui:VisualElement class="row hud-goal__gate is-met"><ui:VisualElement class="ds-icon ds-icon--memory hud-goal__gate-icon" /><ui:Label text="SUPPLY ROUTING" class="hud-goal__gate-label" /></ui:VisualElement>
            <ui:VisualElement class="row hud-goal__gate is-met"><ui:VisualElement class="ds-icon ds-icon--people hud-goal__gate-icon" /><ui:Label text="6 PEOPLE" class="hud-goal__gate-label" /></ui:VisualElement>
          </ui:VisualElement>
          <ui:VisualElement class="ds-progress ds-progress--amber hud-goal__bar"><ui:VisualElement class="ds-progress__fill" style="width: 100%;" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="ds-icon ds-icon--chevron hud-goal__chev" />
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
