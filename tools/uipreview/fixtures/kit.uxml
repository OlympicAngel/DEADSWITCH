<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:VisualElement class="ds-root" style="flex-grow: 1; padding: 64px 48px;">
    <ui:Label text="COMPONENT KIT" class="ds-display" />
    <ui:Label text="FIELD TERMINAL // REV 0.1" class="ds-label" style="margin-bottom: 40px;" />

    <ui:VisualElement class="ds-panel" style="margin-bottom: 32px;">
      <ui:VisualElement class="ds-panel__header">
        <ui:Label text="ENERGY" class="ds-label grow" />
        <ui:VisualElement class="ds-chip ds-chip--phosphor"><ui:Label text="+60 / H" class="ds-chip__label" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement class="row--baseline">
        <ui:Label text="0262" class="ds-value ds-value--hero t-phosphor" />
        <ui:Label text="/ 500" class="ds-unit" />
      </ui:VisualElement>
      <ui:VisualElement class="ds-meter" />
      <ui:VisualElement class="ds-sparkline" style="margin-top: 16px;" />
    </ui:VisualElement>

    <ui:VisualElement class="row" style="margin-bottom: 32px; align-items: stretch;">
      <ui:VisualElement class="ds-panel grow" style="margin-right: 24px;">
        <ui:Label text="CORE INTEGRITY" class="ds-label" style="margin-bottom: 12px;" />
        <ui:VisualElement class="row">
          <ui:VisualElement class="ds-gauge" style="align-items: center; justify-content: center;">
            <ui:Label text="23%" class="ds-value t-phosphor" style="font-size: 34px;" />
          </ui:VisualElement>
          <ui:VisualElement style="margin-left: 20px;">
            <ui:Label text="CORRUPTION" class="ds-label" />
            <ui:Label text="STABLE" class="ds-title t-phosphor" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement class="ds-panel ds-panel--amber grow">
        <ui:Label text="INCOMING" class="ds-label" style="margin-bottom: 12px;" />
        <ui:Label text="RAID" class="ds-title t-amber" />
        <ui:Label text="T-17:42" class="ds-value t-amber" />
        <ui:Label text="EST. STRENGTH 34" class="ds-label" style="margin-top: 8px;" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement class="ds-banner" style="margin-bottom: 32px;">
      <ui:VisualElement class="ds-pip ds-pip--amber ds-pip--diamond" />
      <ui:Label text="RAID SIGNATURE DETECTED // NORTH APPROACH" class="ds-label t-amber grow" />
      <ui:Label text="17:42" class="ds-value t-amber" style="font-size: 34px;" />
    </ui:VisualElement>

    <ui:VisualElement class="row" style="margin-bottom: 20px;">
      <ui:VisualElement class="ds-btn ds-btn--primary grow" style="margin-right: 16px;"><ui:Label text="UPGRADE" class="ds-btn__label" /></ui:VisualElement>
      <ui:VisualElement class="ds-btn grow" style="margin-right: 16px;"><ui:Label text="DEFEND" class="ds-btn__label" /></ui:VisualElement>
      <ui:VisualElement class="ds-btn ds-btn--warn grow"><ui:Label text="OVERRIDE" class="ds-btn__label" /></ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement class="ds-btn ds-btn--ghost" style="margin-bottom: 32px;"><ui:Label text="CANCEL" class="ds-btn__label" /></ui:VisualElement>

    <ui:VisualElement class="row" style="margin-bottom: 32px;">
      <ui:VisualElement class="ds-chip" style="margin-right: 12px;"><ui:VisualElement class="ds-pip" /><ui:Label text="POWERED" class="ds-chip__label" /></ui:VisualElement>
      <ui:VisualElement class="ds-chip ds-chip--amber" style="margin-right: 12px;"><ui:VisualElement class="ds-pip ds-pip--amber ds-pip--diamond" /><ui:Label text="UNMANNED" class="ds-chip__label" /></ui:VisualElement>
      <ui:VisualElement class="ds-chip ds-chip--red"><ui:VisualElement class="ds-pip ds-pip--red" style="rotate: 45deg; width: 0; height: 0;" /><ui:Label text="SHED" class="ds-chip__label" /></ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement class="ds-panel ds-panel--sunken">
      <ui:VisualElement class="ds-kv"><ui:Label text="Generation" class="ds-kv__key" /><ui:Label text="+480 /h" class="ds-kv__value t-phosphor" /></ui:VisualElement>
      <ui:VisualElement class="ds-kv"><ui:Label text="Core upkeep" class="ds-kv__key" /><ui:Label text="-240 /h" class="ds-kv__value" /></ui:VisualElement>
      <ui:VisualElement class="ds-kv"><ui:Label text="Facilities" class="ds-kv__key" /><ui:Label text="-180 /h" class="ds-kv__value" /></ui:VisualElement>
      <ui:VisualElement class="ds-kv" style="border-bottom-width: 0;"><ui:Label text="Net" class="ds-kv__key" /><ui:Label text="+60 /h" class="ds-kv__value t-phosphor" /></ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement class="spacer" />
    <ui:VisualElement class="ds-tabbar" style="margin: 0 -48px -64px -48px;">
      <ui:VisualElement class="ds-tab is-active"><ui:Label text="BASE" class="ds-tab__label" /></ui:VisualElement>
      <ui:VisualElement class="ds-tab"><ui:Label text="MAP" class="ds-tab__label" /></ui:VisualElement>
      <ui:VisualElement class="ds-tab"><ui:Label text="CORE" class="ds-tab__label" /></ui:VisualElement>
      <ui:VisualElement class="ds-tab"><ui:Label text="OPS" class="ds-tab__label" /></ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
