<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <!-- Static mirror of Base/AttackCinematic (title card mid-sequence) -->
  <Style src="Cinematic.uss" />
  <ui:VisualElement class="cine">
    <ui:VisualElement class="cine-bar cine-bar--top" style="height: 11%;" />
    <ui:VisualElement class="cine-card cine-card--red">
      <ui:VisualElement class="row"><ui:VisualElement class="ds-pip ds-pip--red cine-card__pip" /><ui:Label text="SIEGE" class="cine-card__kind" /></ui:VisualElement>
      <ui:Label text="CONTACT // NORTH GATE // VANGUARD" class="cine-card__line" />
    </ui:VisualElement>
    <ui:VisualElement class="cine-bar cine-bar--bottom" style="height: 11%;"><ui:Label text="TAP TO SKIP" class="cine-skip" /></ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
