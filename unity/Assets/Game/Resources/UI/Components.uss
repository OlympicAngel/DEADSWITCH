/* DEADSWITCH component kit: the AI's field terminal. Uses Tokens.uss variables only. */

/* ---------- Typography ---------- */
.ds-display {
    -unity-font-definition: resource("Fonts/ChakraPetch-Bold");
    font-size: var(--fs-lg);
    letter-spacing: var(--ls-label);
    color: var(--c-text);
}

.ds-title {
    -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold");
    font-size: var(--fs-md);
    letter-spacing: var(--ls-wide);
    color: var(--c-text);
}

.ds-label {
    -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold");
    font-size: var(--fs-micro);
    letter-spacing: var(--ls-wide);
    color: var(--c-text-dim);
}

.ds-body {
    -unity-font-definition: resource("Fonts/ChakraPetch-Regular");
    font-size: var(--fs-xs);
    color: var(--c-text);
    white-space: normal;
}

.ds-value {
    -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold");
    font-size: var(--fs-lg);
    color: var(--c-text);
}

.ds-value--hero {
    font-size: var(--fs-xl);
}

.ds-unit {
    -unity-font-definition: resource("Fonts/IBMPlexMono-Medium");
    font-size: var(--fs-xs);
    color: var(--c-text-dim);
    margin-left: var(--s-1);
    padding-bottom: var(--s-1);
}

.ds-mono {
    -unity-font-definition: resource("Fonts/IBMPlexMono-Regular");
}

.t-phosphor { color: var(--c-phosphor); text-shadow: 0 0 10px var(--c-phosphor-glow); }
.t-amber { color: var(--c-amber); text-shadow: 0 0 10px var(--c-amber-glow); }
.t-red { color: var(--c-red); text-shadow: 0 0 10px var(--c-red-glow); }
.t-magenta { color: var(--c-magenta); }
.t-dim { color: var(--c-text-dim); }
.t-faint { color: var(--c-text-faint); }

/* Unity labels carry theme padding; the kit owns spacing (same specificity as the theme rule, loaded later). */
.unity-label {
    padding: 0;
    margin: 0;
}

/* ---------- Layout helpers ---------- */
.row { flex-direction: row; align-items: center; }
.row--baseline { flex-direction: row; align-items: flex-end; }
.col { flex-direction: column; }
.grow { flex-grow: 1; }
.spacer { flex-grow: 1; }
.gap-r > * { margin-right: var(--s-3); }

/* ---------- Panel with corner brackets ---------- */
.ds-panel {
    background-color: var(--c-elev-1);
    border-width: 0;
    border-top-width: 1px;
    border-color: var(--c-edge-hi);
    border-radius: var(--r-lg);
    padding: var(--s-5);
}

.ds-panel--raised { background-color: var(--c-panel-raised); }
.ds-panel--sunken { background-color: var(--c-panel-sunken); }

.ds-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--c-cyan-dim);
}

.ds-corner--tl { left: -1px; top: -1px; border-left-width: var(--bw); border-top-width: var(--bw); }
.ds-corner--tr { right: -1px; top: -1px; border-right-width: var(--bw); border-top-width: var(--bw); }
.ds-corner--bl { left: -1px; bottom: -1px; border-left-width: var(--bw); border-bottom-width: var(--bw); }
.ds-corner--br { right: -1px; bottom: -1px; border-right-width: var(--bw); border-bottom-width: var(--bw); }

.ds-panel--amber { border-left-width: 6px; border-color: var(--c-amber); border-top-color: var(--c-edge-hi); }
.ds-panel--amber > .ds-corner { border-color: var(--c-amber); }
.ds-panel--red { border-left-width: 6px; border-color: var(--c-red); border-top-color: var(--c-edge-hi); }
.ds-panel--red > .ds-corner { border-color: var(--c-red); }

.ds-panel__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--s-3);
}

.ds-divider {
    height: 1px;
    background-color: var(--c-line);
    margin: var(--s-3) 0;
}

/* ---------- Buttons v2 (SPEC-041): tonal surfaces, one clear primary, accents as a left bar not a box ---------- */
.ds-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: var(--touch);
    padding: var(--s-2) var(--s-6);
    border-width: 0;
    border-radius: var(--r-lg);
    background-color: var(--c-elev-2);
    --sheen-color: var(--c-sheen-strong);
    transition-property: scale, background-color, border-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-cubic;
}

.ds-btn:hover { background-color: var(--c-panel-raised); }
.ds-btn:active { scale: 0.97 0.97; }

.ds-btn__label {
    -unity-font-definition: resource("Fonts/ChakraPetch-Bold");
    font-size: var(--fs-sm);
    letter-spacing: var(--ls-label);
    color: var(--c-text);
    /* long labels (large text sizes, prices) wrap inside the button instead of clipping */
    white-space: normal;
    -unity-text-align: middle-center;
}

.ds-btn--primary { background-color: var(--c-cyan); --sheen-color: rgba(255, 255, 255, 0.28); }
.ds-btn--primary:hover { background-color: var(--c-cyan); }
.ds-btn--primary > .ds-btn__label { color: var(--c-world); }

.ds-btn--warn { background-color: var(--c-amber-wash); --sheen-color: var(--c-amber-wash); }
.ds-btn--warn > .ds-btn__label { color: var(--c-amber); }

.ds-btn--ghost { background-color: rgba(0, 0, 0, 0); border-width: 1px; border-color: var(--c-line-mid); --sheen-color: rgba(0, 0, 0, 0); }
.ds-btn--ghost > .ds-btn__label { color: var(--c-text-dim); }

.ds-btn.is-disabled { opacity: 0.38; }

/* ---------- Segmented meter ---------- */
.ds-meter {
    flex-direction: row;
    height: 14px;
    margin-top: var(--s-2);
}

.ds-meter__seg {
    flex-grow: 1;
    margin-right: 3px;
    background-color: rgba(168, 213, 138, 0.1);
}

.ds-meter__seg.is-on { background-color: var(--c-phosphor); }
.ds-meter--amber > .ds-meter__seg.is-on { background-color: var(--c-amber); }
.ds-meter--red > .ds-meter__seg.is-on { background-color: var(--c-red); }
.ds-meter--magenta > .ds-meter__seg.is-on { background-color: var(--c-magenta); }
.ds-meter--white > .ds-meter__seg.is-on { background-color: var(--c-white); }

/* ---------- Chips v2: tonal pills, no outline (SPEC-041) ---------- */
.ds-chip {
    flex-direction: row;
    align-items: center;
    padding: var(--s-1) var(--s-3);
    border-width: 0;
    border-radius: 20px;
    background-color: var(--c-panel-sunken);
}

.ds-chip__label {
    -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold");
    font-size: var(--fs-nano);
    letter-spacing: var(--ls-tight);
    color: var(--c-text-dim);
}

.ds-chip--amber { background-color: var(--c-amber-wash); }
.ds-chip--amber > .ds-chip__label { color: var(--c-amber); }
.ds-chip--phosphor { background-color: var(--c-phosphor-wash); }
.ds-chip--phosphor > .ds-chip__label { color: var(--c-phosphor); }
.ds-chip--red { background-color: var(--c-red-wash); }
.ds-chip--red > .ds-chip__label { color: var(--c-red); }

/* Status pip: shape + color (colorblind-safe). */
.ds-pip {
    width: 12px;
    height: 12px;
    margin-right: var(--s-2);
    background-color: var(--c-phosphor);
}

.ds-pip--diamond { rotate: 45deg; }
.ds-pip--amber { background-color: var(--c-amber); }
.ds-pip--red { background-color: var(--c-red); }
.ds-pip--off { background-color: var(--c-text-faint); }

/* ---------- Alert banner ---------- */
.ds-banner {
    flex-direction: row;
    align-items: center;
    padding: var(--s-3) var(--s-4);
    border-left-width: 6px;
    border-color: var(--c-amber);
    background-color: rgba(52, 38, 14, 0.92);
}

.ds-banner--red { border-color: var(--c-red); background-color: rgba(58, 18, 16, 0.92); }

/* ---------- Tab bar ---------- */
.ds-tabbar {
    flex-direction: row;
    background-color: var(--c-panel-solid);
    border-top-width: 1px;
    border-color: var(--c-line-mid);
}

.ds-tab {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    justify-content: center;
    min-height: 132px;
    border-top-width: 4px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-color;
    transition-duration: 0.24s;
}

.ds-tab__icon {
    width: 44px;
    height: 44px;
    margin-bottom: var(--s-2);
}

.ds-tab__label {
    -unity-font-definition: resource("Fonts/ChakraPetch-Bold");
    font-size: var(--fs-micro);
    letter-spacing: var(--ls-wide);
    color: var(--c-text-dim);
}

.ds-tab.is-active { border-color: var(--c-phosphor); background-color: rgba(168, 213, 138, 0.07); }
.ds-tab.is-active > .ds-tab__label { color: var(--c-phosphor); }

/* ---------- Bottom sheet ---------- */
.ds-sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    /* SPEC-046 r6: a decision sheet is solid; text under it must not read through */
    background-color: var(--c-panel-solid);
    border-top-width: 1px;
    border-color: var(--c-cyan-line);
    border-top-left-radius: var(--r-xl);
    border-top-right-radius: var(--r-xl);
    padding: var(--s-3) var(--s-6) var(--s-8) var(--s-6);
    --sheen-color: var(--c-cyan-wash);
    --sheen-reach: 0.25;
    transition-property: translate, opacity;
    transition-duration: 0.28s;
    transition-timing-function: ease-out-cubic;
}

.ds-sheet.is-hidden { translate: 0 110%; opacity: 0; }

.ds-sheet__grip {
    align-self: center;
    width: 96px;
    height: 6px;
    border-radius: 3px;
    background-color: var(--c-cyan-dim);
    margin-bottom: var(--s-4);
}

/* ---------- Key/value rows ---------- */
.ds-kv {
    flex-direction: row;
    align-items: center;
    min-height: 56px;
    border-bottom-width: 1px;
    border-color: var(--c-line);
}

.ds-kv__key { flex-grow: 1; color: var(--c-text-dim); font-size: var(--fs-sm); }
.ds-kv__value { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-sm); color: var(--c-text); }

/* ---------- Custom drawn ---------- */
.ds-gauge { width: 132px; height: 132px; --track-color: var(--c-line-mid); --fill-color: var(--c-phosphor); }
.ds-gauge--amber { --fill-color: var(--c-amber); }
.ds-gauge--red { --fill-color: var(--c-red); }
.ds-gauge--magenta { --fill-color: var(--c-magenta); }

/* ---------- ScrollView: thin terminal rail instead of the default grey scrollbar ---------- */
.unity-scroller--vertical { width: 10px; margin-left: var(--s-2); border-width: 0; background-color: rgba(0, 0, 0, 0); }
.unity-scroller--vertical > .unity-scroller__low-button, .unity-scroller--vertical > .unity-scroller__high-button { display: none; }
.unity-scroller--vertical > .unity-scroller__slider { margin: 0; }
.unity-scroller--vertical .unity-base-slider__tracker { left: 3px; right: 3px; border-width: 0; background-color: var(--c-line); }
.unity-scroller--vertical .unity-base-slider__dragger { left: 0; width: 10px; border-width: 0; background-color: var(--c-line-strong); }

/* =====================================================================================
   SPEC-039 living interface kit: depth, grouping, icons, accents. Tokens only.
   ===================================================================================== */

/* ---------- Screen header: icon + title + one-line status ---------- */
.ds-head {
    flex-direction: row;
    align-items: center;
    padding: var(--s-3) var(--s-5) var(--s-3) var(--s-5);
    border-bottom-width: 1px;
    border-color: var(--c-cyan-line);
    background-color: var(--c-elev-1);
}

.ds-head__well {
    width: 64px;
    height: 64px;
    align-items: center;
    justify-content: center;
    margin-right: var(--s-4);
    border-width: 1px;
    border-radius: var(--r-md);
    border-color: var(--c-cyan-dim);
    background-color: var(--c-cyan-wash);
}

.ds-head__icon { width: 38px; height: 38px; --icon-color: var(--c-cyan); }
/* SPEC-046 r7: one line. Taglines are hidden; a status that carries data (--data) sits right of the title. */
.ds-head__body { flex-grow: 1; flex-shrink: 1; flex-direction: row; align-items: center; justify-content: space-between; }
.ds-head__title { flex-shrink: 0; -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-lg); letter-spacing: var(--ls-wide); color: var(--c-text); }
.ds-head__status { display: none; flex-shrink: 1; margin-left: var(--s-4); overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-right; -unity-font-definition: resource("Fonts/IBMPlexMono-Medium"); font-size: var(--fs-xs); letter-spacing: var(--ls-tight); color: var(--c-cyan); }
.ds-head__status--data { display: flex; }

/* ---------- Card v2: tone and light instead of outlines (SPEC-041) ---------- */
.ds-card {
    background-color: var(--c-elev-1);
    border-width: 0;
    border-top-width: 1px;
    border-radius: var(--r-lg);
    border-color: var(--c-edge-hi);
    padding: var(--s-5);
    margin-bottom: var(--s-4);
    --sheen-color: var(--c-sheen);
}

.ds-card--raised { background-color: var(--c-elev-2); }
.ds-card--holo { background-color: var(--c-glass); border-top-color: var(--c-cyan-dim); --sheen-color: var(--c-cyan-wash); }
.ds-card--amber { border-left-width: 6px; border-color: var(--c-amber); border-top-color: var(--c-edge-hi); background-color: var(--c-elev-1); --sheen-color: var(--c-amber-wash); }
.ds-card--red { border-left-width: 6px; border-color: var(--c-red); border-top-color: var(--c-edge-hi); background-color: var(--c-elev-1); --sheen-color: var(--c-red-wash); }
.ds-card--violet { border-left-width: 6px; border-color: var(--c-violet); border-top-color: var(--c-edge-hi); background-color: var(--c-elev-1); --sheen-color: var(--c-violet-wash); }

.ds-card__head { flex-direction: row; align-items: center; margin-bottom: var(--s-4); }
.ds-card__well {
    width: 60px;
    height: 60px;
    align-items: center;
    justify-content: center;
    margin-right: var(--s-4);
    border-radius: var(--r-lg);
    background-color: var(--c-cyan-wash);
}

.ds-card__icon { width: 34px; height: 34px; --icon-color: var(--c-cyan); }
.ds-card--amber .ds-card__well { background-color: var(--c-amber-wash); }
.ds-card--amber .ds-card__icon { --icon-color: var(--c-amber); }
.ds-card--red .ds-card__well { background-color: var(--c-red-wash); }
.ds-card--red .ds-card__icon { --icon-color: var(--c-red); }
.ds-card--violet .ds-card__well { background-color: var(--c-violet-wash); }
.ds-card--violet .ds-card__icon { --icon-color: var(--c-violet); }

.ds-card__titles { flex-grow: 1; flex-shrink: 1; }
.ds-card__title { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-sm); letter-spacing: var(--ls-label); color: var(--c-text); }
.ds-card__sub { -unity-font-definition: resource("Fonts/ChakraPetch-Regular"); font-size: var(--fs-micro); color: var(--c-text-dim); white-space: normal; margin-top: 2px; }
.ds-card__body { -unity-font-definition: resource("Fonts/ChakraPetch-Regular"); font-size: var(--fs-xs); color: var(--c-text); white-space: normal; margin-bottom: var(--s-3); }

/* ---------- Section label between cards ---------- */
.ds-section {
    flex-direction: row;
    align-items: center;
    margin: var(--s-2) 0 var(--s-3) 0;
}

.ds-section__icon { width: 26px; height: 26px; margin-right: var(--s-2); --icon-color: var(--c-cyan-dim); }
.ds-section__title { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-micro); letter-spacing: var(--ls-wide); color: var(--c-text-dim); }
.ds-section__rule { flex-grow: 1; height: 1px; margin-left: var(--s-3); background-color: var(--c-cyan-line); }

/* ---------- Progress bar with a glowing head ---------- */
.ds-progress {
    height: 14px;
    border-radius: var(--r-sm);
    background-color: var(--c-panel-sunken);
    border-width: 1px;
    border-color: var(--c-line);
    overflow: hidden;
}

.ds-progress__fill {
    height: 100%;
    width: 40%;
    background-color: var(--c-cyan-dim);
    border-right-width: 4px;
    border-color: var(--c-cyan);
}

.ds-progress--amber > .ds-progress__fill { background-color: var(--c-amber-dim); border-color: var(--c-amber); }
.ds-progress--phosphor > .ds-progress__fill { background-color: var(--c-phosphor-dim); border-color: var(--c-phosphor); }
.ds-progress--red > .ds-progress__fill { background-color: var(--c-red-glow); border-color: var(--c-red); }

/* ---------- Delta pill: +12/h, -30/h ---------- */
.ds-delta {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    padding: 0 var(--s-2);
    border-radius: var(--r-sm);
    background-color: var(--c-phosphor-wash);
}

.ds-delta__icon { width: 20px; height: 20px; margin-right: 2px; --icon-color: var(--c-phosphor); }
.ds-delta__label { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-micro); color: var(--c-phosphor); }
.ds-delta--down { background-color: var(--c-red-wash); }
.ds-delta--down > .ds-delta__icon { --icon-color: var(--c-red); }
.ds-delta--down > .ds-delta__label { color: var(--c-red); }
.ds-delta--flat { background-color: var(--c-panel-sunken); }
.ds-delta--flat > .ds-delta__icon { --icon-color: var(--c-text-dim); }
.ds-delta--flat > .ds-delta__label { color: var(--c-text-dim); }

/* ---------- Count badge ---------- */
.ds-badge {
    position: absolute;
    top: 6px;
    right: 18px;
    min-width: 34px;
    height: 34px;
    padding: 0 var(--s-2);
    border-radius: 17px;
    align-items: center;
    justify-content: center;
    background-color: var(--c-amber);
}

.ds-badge__label { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-micro); color: var(--c-world); }
.ds-badge--red { background-color: var(--c-red); }
.ds-badge--cyan { background-color: var(--c-cyan); }
.ds-badge.is-hidden { display: none; }

/* ---------- Action tile: icon over a short label (quick actions, grids) ---------- */
.ds-tile {
    flex-grow: 1;
    flex-basis: 0;
    min-height: var(--touch);
    align-items: center;
    justify-content: center;
    margin: 0 var(--s-1);
    padding: var(--s-2) var(--s-1);
    border-width: 0;
    border-top-width: 1px;
    border-radius: var(--r-lg);
    border-color: var(--c-edge-hi);
    background-color: var(--c-elev-2);
    --sheen-color: var(--c-sheen-strong);
    transition-property: scale, background-color, border-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-cubic;
}

.ds-tile:active { scale: 0.95 0.95; background-color: var(--c-cyan-wash); }
.ds-tile__icon { width: 44px; height: 44px; --icon-color: var(--c-cyan); }
.ds-tile__label { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-micro); letter-spacing: var(--ls-label); color: var(--c-text); margin-top: var(--s-1); }
.ds-tile__cost { -unity-font-definition: resource("Fonts/IBMPlexMono-Medium"); font-size: var(--fs-micro); color: var(--c-text-dim); }
.ds-tile--primary { border-top-color: var(--c-cyan); background-color: var(--c-cyan-wash); }
.ds-tile--warn { border-top-color: var(--c-amber); background-color: var(--c-amber-wash); }
.ds-tile--warn > .ds-tile__icon { --icon-color: var(--c-amber); }
.ds-tile.is-disabled { opacity: 0.8; border-color: var(--c-line-mid); background-color: var(--c-elev-1); }
.ds-tile.is-disabled > .ds-tile__icon { --icon-color: var(--c-text-dim); }
.ds-tile__cost.is-short { color: var(--c-red); }

/* ---------- Toasts ---------- */
.ds-toasts {
    position: absolute;
    left: var(--s-6);
    right: var(--s-6);
    top: 262px; /* under the HUD status row (SPEC-046 type floor) */
    align-items: center;
}

.ds-toast {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--s-2);
    padding: var(--s-2) var(--s-4) var(--s-2) var(--s-2);
    border-width: 1px;
    border-left-width: 4px;
    border-radius: var(--r-md);
    border-color: var(--c-cyan-line);
    border-left-color: var(--c-cyan);
    background-color: var(--c-panel-solid);
    transition-property: opacity, translate;
    transition-duration: 0.24s;
    transition-timing-function: ease-out-cubic;
}

.ds-toast.is-gone { opacity: 0; translate: 0 -24px; }
.ds-toast__icon { width: 36px; height: 36px; margin-right: var(--s-2); --icon-color: var(--c-cyan); }
.ds-toast__label { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-xs); letter-spacing: var(--ls-label); color: var(--c-text); }
.ds-toast--good { border-left-color: var(--c-phosphor); }
.ds-toast--good > .ds-toast__icon { --icon-color: var(--c-phosphor); }
.ds-toast--warn { border-left-color: var(--c-amber); }
.ds-toast--warn > .ds-toast__icon { --icon-color: var(--c-amber); }
.ds-toast--bad { border-left-color: var(--c-red); }
.ds-toast--bad > .ds-toast__icon { --icon-color: var(--c-red); }

/* ---------- Accent text and focus ---------- */
.t-cyan { color: var(--c-cyan); text-shadow: 0 0 10px var(--c-cyan-glow); }
.t-violet { color: var(--c-violet); }
.ds-btn--ai { border-color: var(--c-cyan); background-color: var(--c-cyan-wash); }
.ds-btn--ai > .ds-btn__label { color: var(--c-cyan); }
.ds-btn--ai:active { background-color: var(--c-cyan-line); }

/* ---------- Long-press hint card (SPEC-039 idea 59) ---------- */
.hint { position: absolute; width: 600px; padding: var(--s-3) var(--s-4); border-width: 1px; border-radius: var(--r-md); border-color: var(--c-cyan); background-color: var(--c-elev-2); }
.hint.is-hidden { display: none; }
.hint__title { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-xs); letter-spacing: var(--ls-label); color: var(--c-cyan); }
.hint__body { font-size: var(--fs-micro); color: var(--c-text); white-space: normal; margin-top: var(--s-1); }

/* ---------- Motion kit (SPEC-040): ripples clip inside their control; primary actions shimmer ---------- */
.ds-btn, .ds-tile, .ai-chip, .hud-tab { overflow: hidden; }
.ds-ripple { position: absolute; background-color: var(--c-white); opacity: 0; }
.ds-shimmer { position: absolute; top: 0; bottom: 0; left: -120px; width: 70px; background-color: var(--c-white); opacity: 0.14; }
.ds-sheet { transition-timing-function: ease-out-back; transition-duration: 0.34s; }

/* ---------- Page tabs (SPEC-040 idea 70) ---------- */
.ds-pager { flex-grow: 1; }
.ds-pager__tabs { flex-direction: row; margin-bottom: var(--s-4); border-bottom-width: 1px; border-color: var(--c-line); flex-shrink: 0; }
.ds-pager__tab { flex-grow: 1; flex-basis: 0; min-height: 96px; align-items: center; justify-content: center; padding: var(--s-1) var(--s-1); }
.ds-pager__icon { width: 34px; height: 34px; margin-bottom: 2px; --icon-color: var(--c-text-dim); }
.ds-pager__label { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-nano); letter-spacing: var(--ls-label); color: var(--c-text-dim); }
.ds-pager__tab.is-active .ds-pager__label { color: var(--c-cyan); }
.ds-pager__tab.is-active .ds-pager__icon { --icon-color: var(--c-cyan); }
.ds-pager__rail { position: absolute; bottom: -2px; height: 4px; left: 0; width: 0; background-color: var(--c-cyan); }
.ds-pager__badge { position: absolute; top: 6px; right: 12px; min-width: 28px; height: 28px; border-radius: 14px; align-items: center; justify-content: center; background-color: var(--c-amber); }
.ds-pager__badge.is-hidden { display: none; }
.ds-pager__badge-label { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-nano); color: var(--c-world); }
.ds-page { flex-shrink: 0; }
.ds-page__title, .ds-page__glyph { display: none; }

/* ---------- Foldable cards (SPEC-040 idea 71) ---------- */
.ds-fold__head { min-height: 72px; }
.ds-card.is-folded > .ds-card__head { margin-bottom: 0; }
.ds-fold__chev { width: 30px; height: 30px; margin-left: var(--s-2); --icon-color: var(--c-text-dim); transition-property: rotate; transition-duration: 0.2s; }
.ds-card.is-folded { padding-top: var(--s-2); padding-bottom: var(--s-2); }

/* ---------- Depth: sheen and scrims (SPEC-041, drawn by UI/Sheen) ---------- */
.ds-sheen { --sheen-reach: 0.6; }
.ds-scrim { position: absolute; left: 0; right: 0; --sheen-color: var(--c-scrim-edge); --sheen-reach: 1; }

/* =====================================================================================
   SPEC-041 controls: switch, segmented track, icon button, list row (no outlined boxes)
   ===================================================================================== */

/* Switch: a pill track with a knob (Kit adds .ds-switch__knob); the ON/OFF word stays for accessibility */
.ds-switch { width: 160px; height: 64px; min-height: 64px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: flex-end; padding: 0 var(--s-4); border-width: 0; border-radius: 32px; background-color: var(--c-panel-sunken); transition-property: background-color; transition-duration: 0.2s; }
.ds-switch > .unity-label { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-nano); letter-spacing: var(--ls-label); color: var(--c-text-faint); }
.ds-switch__knob { position: absolute; left: 6px; top: 6px; width: 52px; height: 52px; border-radius: 26px; background-color: var(--c-text-dim); transition-property: left, background-color; transition-duration: 0.22s; transition-timing-function: ease-out-back; }
.ds-switch.is-on { justify-content: flex-start; background-color: var(--c-cyan-line); }
.ds-switch.is-on > .unity-label { color: var(--c-cyan); }
.ds-switch.is-on > .ds-switch__knob { left: 102px; background-color: var(--c-cyan); }

/* Segmented track: one sunken rail, the chosen item is a lit raised pill */
.ds-seg { flex-direction: row; padding: 6px; border-width: 0; border-radius: var(--r-lg); background-color: var(--c-panel-sunken); }
.ds-seg__item { flex-grow: 1; flex-basis: 0; min-height: 84px; align-items: center; justify-content: center; margin: 0; border-width: 0; border-radius: var(--r-md); background-color: rgba(0, 0, 0, 0); transition-property: background-color; transition-duration: 0.18s; }
.ds-seg__item .unity-label { color: var(--c-text-dim); }
.ds-seg__item.is-selected, .ds-seg__item.is-on, .ds-seg__item.is-active { background-color: var(--c-elev-2); border-top-width: 1px; border-color: var(--c-cyan-dim); }
.ds-seg__item.is-selected .unity-label, .ds-seg__item.is-on .unity-label, .ds-seg__item.is-active .unity-label { color: var(--c-cyan); }

/* Icon button: round, borderless (close, back, info) */
/* a full screen covers the 3D base edge to edge, safe-area strips included (F-112) */
.ds-layer-hud.is-opaque { background-color: var(--c-world); }

/* icons keep their size next to long text */
.ds-icon { flex-shrink: 0; }
.ds-iconbtn { width: 88px; height: 88px; align-items: center; justify-content: center; border-width: 0; border-radius: 44px; background-color: var(--c-panel-sunken); }
.ds-iconbtn:active { background-color: var(--c-cyan-wash); scale: 0.94 0.94; }
.ds-iconbtn__icon { width: 36px; height: 36px; --icon-color: var(--c-text-dim); }

/* List row: content on the surface, a hairline divider between rows instead of a box per row */
.ds-row { flex-direction: row; align-items: center; min-height: 72px; padding: var(--s-2) 0; border-width: 0; border-bottom-width: 1px; border-color: var(--c-line); background-color: rgba(0, 0, 0, 0); }
.ds-row.is-last { border-bottom-width: 0; }
.ds-row__icon { width: 34px; height: 34px; margin-right: var(--s-3); --icon-color: var(--c-cyan); }

/* Readable prose: mixed case in the regular face */
.ds-prose { -unity-font-definition: resource("Fonts/ChakraPetch-Regular"); font-size: var(--fs-xs); color: var(--c-text-dim); white-space: normal; letter-spacing: 0; }
