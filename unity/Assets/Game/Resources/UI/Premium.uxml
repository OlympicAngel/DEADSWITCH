<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="Premium.uss" />
  <!-- FULL GAME (F-036, ADR-0006): free Tier 1 demo, one-time premium unlock, optional ads for cosmetics only.
       Nothing sold or watched grants safety, defense, timer skips or combat power. -->
  <ui:VisualElement name="premium" class="prm">
    <ui:VisualElement class="row prm-head">
      <ui:Label text="FULL GAME" class="ds-title grow" />
      <ui:VisualElement name="prm-close" class="prm-close"><ui:Label text="X" class="prm-close__x" /></ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="prm-card" class="ds-panel prm-card">
      <ui:Label name="prm-state" text="FREE DEMO // TIER 1" class="ds-label t-amber" />
      <ui:Label text="DEADSWITCH // FULL CORE ACCESS" class="prm-card__title" />
      <ui:VisualElement class="prm-list">
        <ui:Label text="+  TIER 2 DISTRICT AND EVERY TIER AFTER" class="prm-list__item" />
        <ui:Label text="+  THE REST OF THE MODULE TREE AND THE AI'S MEMORY" class="prm-list__item" />
        <ui:Label text="+  IRONMAN RUNS AND FUTURE CONTENT" class="prm-list__item" />
      </ui:VisualElement>
      <ui:Label text="One payment. No timers sold, no defense sold, no power sold. The demo is the whole of Tier 1, yours to keep." class="ds-body t-dim prm-card__note" />
      <ui:VisualElement class="row prm-actions">
        <ui:VisualElement name="prm-buy" class="ds-btn ds-btn--primary grow"><ui:Label name="prm-buy-label" text="UNLOCK FULL GAME" class="ds-btn__label" /></ui:VisualElement>
        <ui:VisualElement name="prm-restore" class="ds-btn ds-btn--ghost prm-gap"><ui:Label text="RESTORE" class="ds-btn__label" /></ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:Label text="HUD THEME" class="ds-label prm-section" />
    <ui:VisualElement name="prm-themes" class="prm-seg">
      <ui:VisualElement name="theme-0" class="prm-theme is-selected"><ui:VisualElement class="prm-swatch prm-swatch--phosphor" /><ui:Label text="PHOSPHOR" class="prm-theme__label" /></ui:VisualElement>
      <ui:VisualElement name="theme-1" class="prm-theme"><ui:VisualElement class="prm-swatch prm-swatch--cold" /><ui:Label name="theme-1-label" text="COLD SIGNAL" class="prm-theme__label" /></ui:VisualElement>
      <ui:VisualElement name="theme-2" class="prm-theme"><ui:VisualElement class="prm-swatch prm-swatch--bone" /><ui:Label name="theme-2-label" text="BONE" class="prm-theme__label" /></ui:VisualElement>
      <ui:VisualElement name="theme-3" class="prm-theme is-locked"><ui:VisualElement class="prm-swatch prm-swatch--verdigris" /><ui:Label text="VERDIGRIS" class="prm-theme__label" /></ui:VisualElement>
      <ui:VisualElement name="theme-4" class="prm-theme is-locked"><ui:VisualElement class="prm-swatch prm-swatch--ash" /><ui:Label text="ASH" class="prm-theme__label" /></ui:VisualElement>
    </ui:VisualElement>
    <ui:Label text="Themes are cosmetic. Unlock one by watching an optional ad (never while the Hub is under threat) or earn more on the season track." class="ds-body t-dim prm-note" />
    <ui:VisualElement class="row prm-actions">
      <ui:VisualElement name="ad-1" class="ds-btn ds-btn--ghost grow"><ui:Label name="ad-1-label" text="WATCH AD // COLD SIGNAL" class="ds-btn__label" /></ui:VisualElement>
      <ui:VisualElement name="ad-2" class="ds-btn ds-btn--ghost grow prm-gap"><ui:Label name="ad-2-label" text="WATCH AD // BONE" class="ds-btn__label" /></ui:VisualElement>
    </ui:VisualElement>
    <!-- convenience grants (doc 10 s1.1): never safety, defense, timer skips or combat power -->
    <ui:VisualElement class="prm-actions">
      <ui:VisualElement name="ad-3" class="ds-btn ds-btn--ghost"><ui:Label name="ad-3-label" text="AD // SALVAGE +120 E +12 F (DAILY)" class="ds-btn__label" /></ui:VisualElement>
      <ui:VisualElement name="ad-4" class="ds-btn ds-btn--ghost prm-stack"><ui:Label name="ad-4-label" text="AD // STORAGE +15% FOR 24 H" class="ds-btn__label" /></ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="prm-season" class="ds-btn ds-btn--ghost prm-season"><ui:Label name="prm-season-label" text="SEASON TRACK // RANK 0 / 20" class="ds-btn__label" /></ui:VisualElement>
    <ui:Label name="prm-reason" text="" class="ds-body t-amber prm-reason" />
  </ui:VisualElement>
</ui:UXML>
