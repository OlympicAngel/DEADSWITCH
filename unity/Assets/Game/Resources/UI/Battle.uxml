<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="Battle.uss" />
  <!-- LIVE BATTLE (F-037, SPEC-020, SPEC-039): command the fight at the wall. The 3D fight shows through the middle.
       Defender versus attacker on top, ability tiles below. Every ability states its cost and effect; each is spent once. Sample values are for the preview. -->
  <ui:VisualElement name="battle" class="bat">
    <ui:VisualElement class="ds-panel ds-panel--amber bat-top">
      <ui:VisualElement class="row bat-headrow">
        <ui:VisualElement class="bat-headwell"><ui:VisualElement class="ds-icon ds-icon--swords bat-headicon" /></ui:VisualElement>
        <ui:VisualElement name="bat-pip" class="ds-pip ds-pip--amber ds-pip--diamond bat-pip" />
        <ui:Label name="bat-title" text="CONTACT // SIEGE // NORTH RIDGE" class="bat-title grow" />
        <ui:VisualElement class="bat-clock"><ui:VisualElement class="ds-icon ds-icon--clock bat-clock__icon" /><ui:Label name="bat-time" text="0:42" class="ds-value t-amber bat-time" /></ui:VisualElement>
      </ui:VisualElement>

      <ui:VisualElement class="row bat-forces">
        <ui:VisualElement class="bat-side bat-side--def">
          <ui:VisualElement class="row"><ui:VisualElement class="ds-icon ds-icon--shield bat-side__icon bat-side__icon--def" /><ui:Label text="OUR DEFENSE" class="bat-side__label" /></ui:VisualElement>
          <ui:Label name="bat-def" text="48" class="bat-num t-phosphor" />
        </ui:VisualElement>
        <ui:VisualElement class="bat-vs"><ui:Label text="VS" class="bat-vs__label" /></ui:VisualElement>
        <ui:VisualElement class="bat-side bat-side--att bat-side--right">
          <ui:VisualElement class="row bat-side__row--right"><ui:Label name="bat-att-label" text="THEIR STRENGTH (AI EST)" class="bat-side__label" /><ui:VisualElement class="ds-icon ds-icon--skull bat-side__icon bat-side__icon--att" /></ui:VisualElement>
          <ui:Label name="bat-att" text="~61" class="bat-num t-red" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement class="bat-bar">
        <ui:VisualElement name="bat-bar-def" class="bat-bar__def" />
        <ui:VisualElement name="bat-bar-att" class="bat-bar__att" />
      </ui:VisualElement>

      <ui:VisualElement class="bat-advice">
        <ui:VisualElement class="ds-icon ds-icon--chip bat-advice__icon" />
        <ui:Label name="bat-read" text="AI: We are outgunned. Spend what you have." class="bat-read grow" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement class="grow" />

    <ui:VisualElement class="ds-panel bat-bottom">
      <ui:VisualElement class="row bat-sect"><ui:Label text="COMMANDS // EACH SPENT ONCE" class="bat-sect__title" /><ui:VisualElement class="bat-sect__rule" /></ui:VisualElement>
      <ui:VisualElement class="row bat-abilities">
        <ui:VisualElement name="ab-0" class="bat-ab"><ui:VisualElement class="bat-ab__well"><ui:VisualElement class="ds-icon ds-icon--target bat-ab__icon" /></ui:VisualElement><ui:Label text="FOCUS FIRE" class="bat-ab__name" /><ui:Label name="ab-0-fx" text="DEF +25%" class="bat-ab__fx" /><ui:Label name="ab-0-cost" text="20 COMPUTE" class="bat-ab__cost" /></ui:VisualElement>
        <ui:VisualElement name="ab-1" class="bat-ab"><ui:VisualElement class="bat-ab__well"><ui:VisualElement class="ds-icon ds-icon--flame bat-ab__icon" /></ui:VisualElement><ui:Label text="MORTAR BARRAGE" class="bat-ab__name" /><ui:Label name="ab-1-fx" text="THEM -20%" class="bat-ab__fx" /><ui:Label name="ab-1-cost" text="120 ENERGY" class="bat-ab__cost" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement class="row bat-abilities">
        <ui:VisualElement name="ab-2" class="bat-ab bat-ab--override"><ui:VisualElement class="bat-ab__well"><ui:VisualElement class="ds-icon ds-icon--hand bat-ab__icon" /></ui:VisualElement><ui:Label text="MANUAL TAKEOVER" class="bat-ab__name" /><ui:Label name="ab-2-fx" text="DEF +40%" class="bat-ab__fx" /><ui:Label name="ab-2-cost" text="OVERRIDE 2/3" class="bat-ab__cost" /></ui:VisualElement>
        <ui:VisualElement name="ab-3" class="bat-ab bat-ab--override"><ui:VisualElement class="bat-ab__well"><ui:VisualElement class="ds-icon ds-icon--bolt bat-ab__icon" /></ui:VisualElement><ui:Label text="MACHINE SEIZURE" class="bat-ab__name" /><ui:Label name="ab-3-fx" text="THEM -35% // CORRUPTS ME" class="bat-ab__fx" /><ui:Label name="ab-3-cost" text="OVERRIDE 2/3" class="bat-ab__cost" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement class="row bat-foot">
        <ui:VisualElement name="bat-slow" class="bat-toggle"><ui:VisualElement class="ds-icon ds-icon--clock bat-toggle__icon" /><ui:Label name="bat-slow-label" text="SLOW-MO OFF" class="bat-toggle__label" /></ui:VisualElement>
        <ui:VisualElement name="bat-posture" class="ds-btn grow bat-gap"><ui:Label text="STANCE AND DEFENDERS" class="ds-btn__label" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:Label name="bat-reason" text="" class="ds-body t-amber bat-reason" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
