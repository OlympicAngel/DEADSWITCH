/* DEADSWITCH design tokens (doc 11 palette, provisional - tune).
   Reference resolution 1080 x 1920 (portrait): 1 UI px is roughly 1 device px on a phone.
   Feature styles use only these variables: no raw hex or magic numbers elsewhere. */

.ds-root {
    /* Surfaces */
    --c-world: #12171A;            /* world charcoal, cooled toward blue-black (SPEC-039 accent pass) */
    --c-void: #000000;             /* true black: the opening before the core wakes (SPEC-043 s4) */
    --c-panel: rgba(14, 20, 23, 0.88);
    --c-panel-solid: #161D21;
    --c-panel-raised: #1F282D;     /* panel graphite */
    --c-panel-sunken: rgba(5, 9, 11, 0.74);
    --c-scrim: rgba(4, 7, 9, 0.66);

    /* Depth (SPEC-039): USS has no shadows, so elevation is a light top edge, a dark bottom edge and a tone step */
    --c-elev-1: rgba(17, 24, 28, 0.92);
    --c-elev-2: rgba(26, 35, 40, 0.95);
    --c-edge-hi: rgba(210, 240, 245, 0.10);
    --c-edge-lo: rgba(0, 0, 0, 0.55);
    --c-glass: rgba(12, 30, 36, 0.66);

    /* Lines */
    --c-line: rgba(168, 213, 138, 0.16);
    --c-line-mid: rgba(168, 213, 138, 0.32);
    --c-line-strong: rgba(168, 213, 138, 0.62);

    /* Text */
    --c-text: #D8D1BC;             /* field paper */
    --c-text-dim: #9DA197;         /* dust grey */
    --c-text-faint: rgba(157, 161, 151, 0.55);

    /* Signals (meaning locked by doc 10; swatches provisional) */
    --c-phosphor: #A8D58A;
    --c-phosphor-dim: rgba(168, 213, 138, 0.55);
    --c-phosphor-glow: rgba(168, 213, 138, 0.35);
    --c-amber: #E8B45C;
    --c-amber-dim: rgba(232, 180, 92, 0.5);
    --c-amber-glow: rgba(232, 180, 92, 0.35);
    --c-red: #D85B52;
    --c-red-glow: rgba(216, 91, 82, 0.4);
    --c-magenta: #C176B4;
    --c-white: #F0EBDD;
    --c-blue: #82AEB6;
    --c-phosphor-wash: rgba(168, 213, 138, 0.08);
    --c-amber-wash: rgba(232, 180, 92, 0.10);
    --c-red-wash: rgba(216, 91, 82, 0.12);

    /* AI tech accent (owner 2026-10-05: restrained cyberpunk, on AI surfaces, focus and interactables only) */
    --c-cyan: #46DCE6;
    --c-cyan-dim: rgba(70, 220, 230, 0.5);
    --c-cyan-glow: rgba(70, 220, 230, 0.35);
    --c-cyan-line: rgba(70, 220, 230, 0.22);
    --c-cyan-wash: rgba(70, 220, 230, 0.08);
    --c-violet: #9C8CFF;            /* intel, story and legacy surfaces */
    --c-violet-dim: rgba(156, 140, 255, 0.5);
    --c-violet-wash: rgba(156, 140, 255, 0.10);

    /* Spacing: 4 px grid */
    --s-1: 4px;
    --s-2: 8px;
    --s-3: 12px;
    --s-4: 16px;
    --s-5: 20px;
    --s-6: 24px;
    --s-8: 32px;
    --s-10: 40px;
    --s-12: 48px;

    /* Type scale v3 (SPEC-046): the UI scales from a 1080 px reference (3 px per dp), so 33 px is the 11 dp floor;
       body 13 dp, decision numbers 15 dp and up. nano and micro are the same floor step. */
    --fs-nano: 33px;
    --fs-micro: 33px;
    --fs-xs: 36px;
    --fs-sm: 39px;
    --fs-md: 45px;
    --fs-lg: 54px;
    --fs-xl: 72px;
    --fs-hero: 104px;

    /* Tracking: labels breathe, they do not shout */
    --ls-tight: 1px;
    --ls-label: 2px;
    --ls-wide: 3px;

    /* Depth sheen (gradient light from the top edge; drawn by UI/Sheen) */
    --c-sheen: rgba(150, 230, 240, 0.07);
    --c-sheen-strong: rgba(150, 230, 240, 0.14);
    --c-scrim-edge: rgba(4, 8, 10, 0.86);

    /* Shape */
    --r-sm: 2px;
    --r-md: 4px;
    --r-lg: 10px;
    --r-xl: 18px;
    --bw: 2px;
    --corner: 18px;
    --touch: 132px;               /* 44 dp at the 1080 reference */

    /* Motion (seconds) */
    --t-fast: 0.12s;
    --t-med: 0.24s;
    --t-slow: 0.42s;
    --t-pulse: 1.2s;

    -unity-font-definition: resource("Fonts/IBMPlexMono-Regular");
    color: var(--c-text);
    font-size: var(--fs-sm);
}

/* Text size assist (doc 10): type and touch targets scale together. */
.ds-root.ds-scale-115 {
    --fs-nano: 38px;
    --fs-micro: 38px;
    --fs-xs: 41px;
    --fs-sm: 45px;
    --fs-md: 52px;
    --fs-lg: 62px;
    --fs-xl: 83px;
    --fs-hero: 120px;
    --touch: 152px;
}

.ds-root.ds-scale-130 {
    --fs-nano: 43px;
    --fs-micro: 43px;
    --fs-xs: 47px;
    --fs-sm: 51px;
    --fs-md: 59px;
    --fs-lg: 70px;
    --fs-xl: 94px;
    --fs-hero: 135px;
    --touch: 172px;
}

/* The fixed HUD chrome (pods, context row, tabs) stops at the 115 step: four pods and the context row
   cannot widen on a phone, and 115 is already above the 11 dp floor. Screens and sheets take the full 130. */
.ds-root.ds-scale-130 .hud-top,
.ds-root.ds-scale-130 .hud-context,
.ds-root.ds-scale-130 .hud-tabs {
    --fs-nano: 38px;
    --fs-micro: 38px;
    --fs-xs: 41px;
    --fs-sm: 45px;
    --fs-md: 52px;
    --fs-lg: 62px;
    --fs-xl: 83px;
    --fs-hero: 120px;
}

/* HUD themes (F-036): cosmetic only, earned from optional ads. Signal meanings (amber, red, magenta) never change. */
.ds-root.theme-cold {
    --c-phosphor: #8CC8D8;
    --c-phosphor-dim: rgba(140, 200, 216, 0.55);
    --c-phosphor-glow: rgba(140, 200, 216, 0.35);
    --c-line: rgba(140, 200, 216, 0.16);
    --c-line-mid: rgba(140, 200, 216, 0.32);
    --c-line-strong: rgba(140, 200, 216, 0.62);
}

.ds-root.theme-bone {
    --c-phosphor: #D9D2BE;
    --c-phosphor-dim: rgba(217, 210, 190, 0.55);
    --c-phosphor-glow: rgba(217, 210, 190, 0.35);
    --c-line: rgba(217, 210, 190, 0.16);
    --c-line-mid: rgba(217, 210, 190, 0.32);
    --c-line-strong: rgba(217, 210, 190, 0.62);
}

/* Season track themes (F-048): cosmetic, earned by play (verdigris) or on the premium track (ash). */
.ds-root.theme-verdigris {
    --c-phosphor: #7CC2AE;
    --c-phosphor-dim: rgba(124, 194, 174, 0.55);
    --c-phosphor-glow: rgba(124, 194, 174, 0.35);
    --c-line: rgba(124, 194, 174, 0.16);
    --c-line-mid: rgba(124, 194, 174, 0.32);
    --c-line-strong: rgba(124, 194, 174, 0.62);
}

.ds-root.theme-ash {
    --c-phosphor: #B9BEC6;
    --c-phosphor-dim: rgba(185, 190, 198, 0.55);
    --c-phosphor-glow: rgba(185, 190, 198, 0.35);
    --c-line: rgba(185, 190, 198, 0.16);
    --c-line-mid: rgba(185, 190, 198, 0.32);
    --c-line-strong: rgba(185, 190, 198, 0.62);
}
