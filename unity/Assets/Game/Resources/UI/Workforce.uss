/* WORKFORCE (SPEC-012, SPEC-039 kit). Tokens only. */

.wf { flex-grow: 1; padding: var(--s-4) var(--s-6) var(--s-2) var(--s-6); background-color: var(--c-scrim); }
.wf-head { margin-bottom: var(--s-3); }
.wf-close { width: var(--touch); height: var(--touch); align-items: center; justify-content: center; border-width: 1px; border-radius: var(--r-md); border-color: var(--c-line-mid); background-color: var(--c-elev-2); }
.wf-close__x { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-md); color: var(--c-text-dim); }
.wf-scroll { flex-grow: 1; flex-shrink: 1; }

.wf-tile { flex-grow: 1; flex-basis: 0; align-items: center; margin-right: var(--s-2); padding: var(--s-3) var(--s-2); border-width: 1px; border-radius: var(--r-md); border-color: var(--c-cyan-line); border-top-color: var(--c-edge-hi); background-color: var(--c-panel-sunken); }
.wf-tile--last { margin-right: 0; }
.wf-tile__icon { width: 36px; height: 36px; --icon-color: var(--c-cyan); }
.wf-tile__value { min-height: 66px; -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-lg); color: var(--c-text); margin-top: var(--s-1); }
.wf-tile__label { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-micro); letter-spacing: 2px; color: var(--c-text-dim); }

.wf-loyalty__pct { min-height: 50px; -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-md); margin-left: var(--s-3); }
.wf-note { font-size: var(--fs-micro); margin-top: var(--s-3); white-space: normal; }
.wf-surge { margin-top: var(--s-2); }
.wf-surge.is-hidden { display: none; }

.wf-lead { font-size: var(--fs-micro); margin-bottom: var(--s-3); white-space: normal; }
.wf-gain { min-height: 36px; -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-xs); margin-top: 2px; }
.wf-choice.is-armed { border-color: var(--c-red); background-color: var(--c-red-wash); }
.wf-choice__cost { margin-top: 0; white-space: normal; }
.wf-choice__btn { margin-top: var(--s-3); }
.wf-choice__btn > .ds-btn__label { font-size: var(--fs-xs); }
.wf-choice__btn.is-armed { border-color: var(--c-red); background-color: var(--c-red-wash); }
.wf-choice__btn.is-armed > .ds-btn__label { color: var(--c-red); }

.wf-stepper { align-items: center; }
.wf-step { width: var(--touch); height: var(--touch); margin-top: var(--s-3); align-items: center; justify-content: center; border-width: var(--bw); border-radius: var(--r-md); border-color: var(--c-line-mid); background-color: var(--c-elev-2); }
.wf-step__label { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-md); color: var(--c-text-dim); }
.wf-step__value { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-md); color: var(--c-text); width: 96px; min-height: 50px; margin-top: var(--s-3); -unity-text-align: middle-center; }
.wf-stepper > .wf-choice__btn { margin-left: var(--s-4); }

.wf-reason { margin-top: var(--s-2); min-height: 40px; white-space: normal; }
