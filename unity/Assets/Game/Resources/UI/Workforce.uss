/* WORKFORCE (SPEC-012). Tokens only. */

.wf { flex-grow: 1; padding: var(--s-4) var(--s-6) var(--s-2) var(--s-6); background-color: var(--c-scrim); }
.wf-head { align-items: center; margin-bottom: var(--s-3); }
.wf-close { width: var(--touch); height: var(--touch); align-items: center; justify-content: center; border-width: 1px; border-color: var(--c-line-mid); }
.wf-close__x { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-md); color: var(--c-text-dim); }

.wf-stats { padding-top: var(--s-3); padding-bottom: var(--s-3); }
.wf-kv { margin-right: var(--s-8); }
.wf-kv__value { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-md); color: var(--c-text); margin-top: var(--s-1); }
.wf-loyalty { align-items: center; margin-top: var(--s-4); }
.wf-loyalty__pct { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-md); margin-left: var(--s-3); }
.wf-note { font-size: var(--fs-micro); margin-top: var(--s-2); }
.wf-surge { margin-top: var(--s-2); }
.wf-surge.is-hidden { display: none; }

.wf-section { margin-top: var(--s-5); margin-bottom: var(--s-2); }
.wf-choice { margin-bottom: var(--s-3); padding-top: var(--s-3); padding-bottom: var(--s-3); }
.wf-choice.is-armed { border-color: var(--c-red-glow); }
.wf-choice__name { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-sm); letter-spacing: 3px; color: var(--c-text); }
.wf-choice__cost { margin-top: var(--s-1); }
.wf-choice__btn { margin-top: var(--s-3); }
.wf-choice__btn > .ds-btn__label { font-size: var(--fs-xs); }
.wf-choice__btn.is-armed { border-color: var(--c-red); background-color: rgba(216, 91, 82, 0.18); }
.wf-choice__btn.is-armed > .ds-btn__label { color: var(--c-red); }

.wf-stepper { align-items: center; }
.wf-step { width: var(--touch); height: var(--touch); margin-top: var(--s-3); align-items: center; justify-content: center; border-width: var(--bw); border-color: var(--c-line-mid); }
.wf-step__label { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-md); color: var(--c-text-dim); }
.wf-step__value { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-md); color: var(--c-text); width: 72px; margin-top: var(--s-3); -unity-text-align: middle-center; }
.wf-stepper > .wf-choice__btn { margin-left: var(--s-4); }

.wf-reason { margin-top: var(--s-2); min-height: 40px; }
