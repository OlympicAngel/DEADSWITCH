<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="Settings.uss" />
  <!-- SETTINGS (F-024, SPEC-039): comfort and accessibility, grouped into icon cards. Nothing here hides information or slows input. -->
  <ui:VisualElement name="settings" class="set">
    <ui:VisualElement class="ds-head set-head">
      <ui:VisualElement class="ds-head__well"><ui:VisualElement class="ds-icon ds-icon--gear ds-head__icon" /></ui:VisualElement>
      <ui:VisualElement class="ds-head__body">
        <ui:Label text="SETTINGS" class="ds-head__title" />
        <ui:Label text="COMFORT // ACCESSIBILITY // BACKUP" class="ds-head__status" />
      </ui:VisualElement>
      <ui:VisualElement name="set-close" class="ds-iconbtn set-close"><ui:VisualElement class="ds-icon ds-icon--close ds-iconbtn__icon" /></ui:VisualElement>
    </ui:VisualElement>

    <ui:ScrollView name="set-scroll" class="grow set-scroll">

      <ui:VisualElement class="ds-card ds-card--raised ">
        <ui:VisualElement class="ds-card__head">
          <ui:VisualElement class="ds-card__well"><ui:VisualElement class="ds-icon ds-icon--wave ds-card__icon" /></ui:VisualElement>
          <ui:VisualElement class="ds-card__titles"><ui:Label text="DISPLAY AND SOUND" class="ds-card__title" /><ui:Label text="How loud and how busy the screen feels." class="ds-card__sub" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="EFFECTS" class="set-subhead" />
        <ui:VisualElement name="seg-effects" class="ds-seg set-seg">
          <ui:VisualElement class="ds-seg__item set-seg__item"><ui:Label text="0%" class="set-seg__label" /></ui:VisualElement>
          <ui:VisualElement class="ds-seg__item set-seg__item"><ui:Label text="25%" class="set-seg__label" /></ui:VisualElement>
          <ui:VisualElement class="ds-seg__item set-seg__item"><ui:Label text="50%" class="set-seg__label" /></ui:VisualElement>
          <ui:VisualElement class="ds-seg__item set-seg__item"><ui:Label text="75%" class="set-seg__label" /></ui:VisualElement>
          <ui:VisualElement class="ds-seg__item set-seg__item is-selected"><ui:Label text="100%" class="set-seg__label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="Glitches, scanlines and noise. Never on values, warnings or controls." class="ds-prose set-note set-note--pad" />
        <ui:Label text="SOUND" class="set-subhead" />
        <ui:VisualElement name="seg-sound" class="ds-seg set-seg">
          <ui:VisualElement class="ds-seg__item set-seg__item"><ui:Label text="OFF" class="set-seg__label" /></ui:VisualElement>
          <ui:VisualElement class="ds-seg__item set-seg__item"><ui:Label text="25%" class="set-seg__label" /></ui:VisualElement>
          <ui:VisualElement class="ds-seg__item set-seg__item"><ui:Label text="50%" class="set-seg__label" /></ui:VisualElement>
          <ui:VisualElement class="ds-seg__item set-seg__item is-selected"><ui:Label text="75%" class="set-seg__label" /></ui:VisualElement>
          <ui:VisualElement class="ds-seg__item set-seg__item"><ui:Label text="100%" class="set-seg__label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="ds-row set-row is-last">
          <ui:VisualElement class="set-row__well"><ui:VisualElement class="ds-icon ds-icon--signal set-row__icon" /></ui:VisualElement>
          <ui:VisualElement class="grow set-row__text"><ui:Label text="MUSIC" class="set-row__title" /><ui:Label text="Tension music. Alarms and the AI's voice stay on." class="ds-prose set-note" /></ui:VisualElement>
          <ui:VisualElement name="tog-music" class="ds-switch set-toggle is-on"><ui:Label text="ON" class="set-toggle__label" /></ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <ui:VisualElement class="ds-card ds-card--raised ">
        <ui:VisualElement class="ds-card__head">
          <ui:VisualElement class="ds-card__well"><ui:VisualElement class="ds-icon ds-icon--eye ds-card__icon" /></ui:VisualElement>
          <ui:VisualElement class="ds-card__titles"><ui:Label text="ACCESSIBILITY" class="ds-card__title" /><ui:Label text="Readable and calm, on your terms." class="ds-card__sub" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="TEXT SIZE" class="set-subhead" />
        <ui:VisualElement name="seg-text" class="ds-seg set-seg">
          <ui:VisualElement class="ds-seg__item set-seg__item is-selected"><ui:Label text="100%" class="set-seg__label" /></ui:VisualElement>
          <ui:VisualElement class="ds-seg__item set-seg__item"><ui:Label text="115%" class="set-seg__label" /></ui:VisualElement>
          <ui:VisualElement class="ds-seg__item set-seg__item"><ui:Label text="130%" class="set-seg__label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="Scales type and touch targets together." class="ds-prose set-note set-note--pad" />
        <ui:VisualElement class="ds-row set-row">
          <ui:VisualElement class="set-row__well"><ui:VisualElement class="ds-icon ds-icon--hold set-row__icon" /></ui:VisualElement>
          <ui:VisualElement class="grow set-row__text"><ui:Label text="REDUCED MOTION" class="set-row__title" /><ui:Label text="No typing, staggering, pulsing or camera drift." class="ds-prose set-note" /></ui:VisualElement>
          <ui:VisualElement name="tog-motion" class="ds-switch set-toggle"><ui:Label text="OFF" class="set-toggle__label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="ds-row set-row is-last">
          <ui:VisualElement class="set-row__well"><ui:VisualElement class="ds-icon ds-icon--bolt set-row__icon" /></ui:VisualElement>
          <ui:VisualElement class="grow set-row__text"><ui:Label text="HAPTICS" class="set-row__title" /><ui:Label text="Short pulses for raid warnings and confirmations." class="ds-prose set-note" /></ui:VisualElement>
          <ui:VisualElement name="tog-haptics" class="ds-switch set-toggle is-on"><ui:Label text="ON" class="set-toggle__label" /></ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <ui:VisualElement class="ds-card ds-card--raised ">
        <ui:VisualElement class="ds-card__head">
          <ui:VisualElement class="ds-card__well"><ui:VisualElement class="ds-icon ds-icon--drone ds-card__icon" /></ui:VisualElement>
          <ui:VisualElement class="ds-card__titles"><ui:Label text="CAMERA AND ALERTS" class="ds-card__title" /><ui:Label text="What the world shows you, and when it calls." class="ds-card__sub" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="ds-row set-row">
          <ui:VisualElement class="set-row__well"><ui:VisualElement class="ds-icon ds-icon--eye set-row__icon" /></ui:VisualElement>
          <ui:VisualElement class="grow set-row__text"><ui:Label text="ATTACK CINEMATICS" class="set-row__title" /><ui:Label text="Short camera shots when an attack makes contact. Tap to skip." class="ds-prose set-note" /></ui:VisualElement>
          <ui:VisualElement name="tog-cine" class="ds-switch set-toggle is-on"><ui:Label text="ON" class="set-toggle__label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="ds-row set-row">
          <ui:VisualElement class="set-row__well"><ui:VisualElement class="ds-icon ds-icon--drone set-row__icon" /></ui:VisualElement>
          <ui:VisualElement class="grow set-row__text"><ui:Label text="FOCUS FLY-IN" class="set-row__title" /><ui:Label text="The drone flies in to frame a facility you select." class="ds-prose set-note" /></ui:VisualElement>
          <ui:VisualElement name="tog-flyin" class="ds-switch set-toggle is-on"><ui:Label text="ON" class="set-toggle__label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="ds-row set-row is-last">
          <ui:VisualElement class="set-row__well"><ui:VisualElement class="ds-icon ds-icon--alert set-row__icon" /></ui:VisualElement>
          <ui:VisualElement class="grow set-row__text"><ui:Label text="ALERTS WHILE AWAY" class="set-row__title" /><ui:Label text="Raids, finished work and power loss, forecast when you leave." class="ds-prose set-note" /></ui:VisualElement>
          <ui:VisualElement name="tog-alerts" class="ds-switch set-toggle"><ui:Label text="OFF" class="set-toggle__label" /></ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- optional cloud backup (doc 10 s2): never required to play -->
      <ui:VisualElement class="ds-card ds-card--raised ds-card--holo">
        <ui:VisualElement class="ds-card__head">
          <ui:VisualElement class="ds-card__well"><ui:VisualElement class="ds-icon ds-icon--server ds-card__icon" /></ui:VisualElement>
          <ui:VisualElement class="ds-card__titles"><ui:Label text="CLOUD BACKUP" class="ds-card__title" /><ui:Label text="Optional. Your run stays yours." class="ds-card__sub" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="ds-row set-row is-last">
          <ui:VisualElement class="set-row__well"><ui:VisualElement class="ds-icon ds-icon--lock set-row__icon" /></ui:VisualElement>
          <ui:VisualElement class="grow set-row__text"><ui:Label text="CLOUD BACKUP" class="set-row__title" /><ui:Label name="cloud-note" text="Backs the run up when you leave. Never required to play." class="ds-prose set-note" /></ui:VisualElement>
          <ui:VisualElement name="tog-cloud" class="ds-switch set-toggle"><ui:Label text="OFF" class="set-toggle__label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="row set-btnrow">
          <ui:VisualElement name="cloud-now" class="ds-btn ds-btn--ai set-btn grow"><ui:Label text="BACK UP NOW" class="ds-btn__label" /></ui:VisualElement>
          <ui:VisualElement name="cloud-restore" class="ds-btn ds-btn--ghost set-btn grow set-gap"><ui:Label name="cloud-restore-label" text="RESTORE" class="ds-btn__label" /></ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <ui:VisualElement class="ds-card ds-card--raised ds-card--violet">
        <ui:VisualElement class="ds-card__head">
          <ui:VisualElement class="ds-card__well"><ui:VisualElement class="ds-icon ds-icon--star ds-card__icon" /></ui:VisualElement>
          <ui:VisualElement class="ds-card__titles"><ui:Label text="LOOK AND GUIDANCE" class="ds-card__title" /><ui:Label text="Interface colour and the step-by-step objectives." class="ds-card__sub" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="INTERFACE COLOUR" class="set-subhead" />
        <ui:VisualElement name="seg-theme" class="ds-seg set-seg"><ui:VisualElement class="ds-seg__item set-seg__item is-selected"><ui:Label text="PHOSPHOR" class="set-seg__label" /></ui:VisualElement><ui:VisualElement class="ds-seg__item set-seg__item"><ui:Label text="COLD" class="set-seg__label" /></ui:VisualElement><ui:VisualElement class="ds-seg__item set-seg__item"><ui:Label text="BONE" class="set-seg__label" /></ui:VisualElement><ui:VisualElement class="ds-seg__item set-seg__item"><ui:Label text="VERDIGRIS" class="set-seg__label" /></ui:VisualElement><ui:VisualElement class="ds-seg__item set-seg__item"><ui:Label text="ASH" class="set-seg__label" /></ui:VisualElement></ui:VisualElement>
        <ui:Label name="theme-note" text="Verdigris and Ash are earned on the reward track." class="ds-prose set-note" />
        <ui:VisualElement name="guide-reset" class="ds-btn ds-btn--ghost set-btn"><ui:Label text="SHOW OBJECTIVES AGAIN" class="ds-btn__label" /></ui:VisualElement>
      </ui:VisualElement>

      <ui:VisualElement class="ds-card ds-card--raised ds-card--red">
        <ui:VisualElement class="ds-card__head">
          <ui:VisualElement class="ds-card__well"><ui:VisualElement class="ds-icon ds-icon--cycle ds-card__icon" /></ui:VisualElement>
          <ui:VisualElement class="ds-card__titles"><ui:Label text="START OVER" class="ds-card__title" /><ui:Label text="A fresh Hub from the first day." class="ds-card__sub" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="newgame-note" text="Deletes this Hub, its story, its legacy points and its saves on this device. Earned interface colours stay. To keep your legacy points, relocate instead." class="ds-prose set-note" />
        <ui:VisualElement name="newgame" class="ds-btn ds-btn--warn set-btn"><ui:Label text="START A NEW GAME" class="ds-btn__label" /></ui:VisualElement>
      </ui:VisualElement>

      <ui:VisualElement name="dev" class="ds-card set-dev">
        <ui:Label text="DEVELOPMENT // TIME SCALE" class="set-subhead" />
        <ui:VisualElement name="seg-time" class="ds-seg set-seg">
          <ui:VisualElement class="ds-seg__item set-seg__item is-selected"><ui:Label text="1X" class="set-seg__label" /></ui:VisualElement>
          <ui:VisualElement class="ds-seg__item set-seg__item"><ui:Label text="10X" class="set-seg__label" /></ui:VisualElement>
          <ui:VisualElement class="ds-seg__item set-seg__item"><ui:Label text="60X" class="set-seg__label" /></ui:VisualElement>
          <ui:VisualElement class="ds-seg__item set-seg__item"><ui:Label text="600X" class="set-seg__label" /></ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <ui:Label name="about" text="DEADSWITCH // FRAGMENT S-17. Type: Chakra Petch, IBM Plex Mono (SIL Open Font License 1.1)." class="ds-body t-faint set-about" />
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
