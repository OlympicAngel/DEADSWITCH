<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="Map.uss" />
  <!-- SECTOR MAP (F-019, SPEC-039): header, the render plot, then ONE scroll: selected site first (the thing you act on), operations, factions last.
       Sample markers are for the preview; MapScreen rebuilds them. -->
  <ui:VisualElement name="map" class="map">
    <ui:VisualElement class="ds-head">
      <ui:VisualElement class="ds-head__well"><ui:VisualElement class="ds-icon ds-icon--map ds-head__icon" /></ui:VisualElement>
      <ui:VisualElement class="ds-head__body">
        <ui:Label text="SECTOR MAP" class="ds-head__title" />
        <ui:Label name="map-ops-count" text="OPS 1/2 // FUEL 64" class="ds-head__status" />
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- world event (F-034): what the wastes are doing right now -->
    <ui:VisualElement name="map-event" class="row map-event">
      <ui:VisualElement class="ds-icon ds-icon--alert map-event__icon" />
      <ui:Label name="map-event-text" text="SUPPLY WINDOW // LOOT +50% // TRADERS -25%" class="map-event__text grow" />
    </ui:VisualElement>

    <!-- sector map (SPEC-033): the 3D render, the illustrated layer (Painter2D), then site pins and tags. -->
    <ui:VisualElement name="map-plot" class="map-plot">
      <ui:VisualElement name="map-render" class="map-render" picking-mode="Ignore" />
      <ui:VisualElement name="map-overlay" class="map-overlay" picking-mode="Ignore" />
      <ui:VisualElement name="map-sites" class="map-sites" picking-mode="Ignore">
        <ui:VisualElement class="map-site map-site--rust is-selected" style="left: 34%; top: 37%;">
          <ui:VisualElement class="map-site__mark" />
          <ui:VisualElement class="map-site__tag">
            <ui:Label text="RUST MARKET" class="map-site__name" />
            <ui:Label text="DEF 30" class="map-site__est" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="map-site map-site--vanguard" style="left: 64%; top: 65%;">
          <ui:VisualElement class="map-site__mark" />
          <ui:VisualElement class="map-site__tag">
            <ui:Label text="RELAY 9" class="map-site__name" />
            <ui:Label text="~84" class="map-site__est" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="map-site map-site--church" style="left: 17%; top: 26%;">
          <ui:VisualElement class="map-site__mark" />
          <ui:VisualElement class="map-site__tag">
            <ui:Label text="CATHEDRAL ARRAY" class="map-site__name" />
            <ui:Label text="~55" class="map-site__est" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="map-site map-site--holdout map-site--left" style="left: 83%; top: 26%;">
          <ui:VisualElement class="map-site__mark" />
          <ui:VisualElement class="map-site__tag">
            <ui:Label text="HALCYON VAULT" class="map-site__name" />
            <ui:Label text="~160" class="map-site__est" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="map-site map-site--wild map-site--fallout" style="left: 27%; top: 47%;">
          <ui:VisualElement class="map-site__mark" />
          <ui:VisualElement class="map-site__tag">
            <ui:Label text="WATER PLANT // FALLOUT" class="map-site__name" />
            <ui:Label text="~40" class="map-site__est" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="map-site map-site--hub" style="left: 50%; top: 48%;">
          <ui:VisualElement class="map-site__mark" />
          <ui:VisualElement class="map-site__tag">
            <ui:Label text="HUB S-17" class="map-site__name" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:ScrollView name="map-scroll" class="map-scroll">
      <!-- selected site -->
      <ui:VisualElement name="site-sheet" class="ds-card ds-card--holo map-sheet">
        <ui:VisualElement class="ds-card__head">
          <ui:VisualElement class="ds-card__well"><ui:VisualElement class="ds-icon ds-icon--target ds-card__icon" /></ui:VisualElement>
          <ui:VisualElement class="ds-card__titles">
            <ui:Label name="site-name" text="RUST MARKET" class="ds-card__title" />
            <ui:Label name="site-owner" text="RUSTBORN // OUTPOST" class="ds-card__sub t-amber" />
          </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="row map-sheet__facts">
          <ui:VisualElement class="map-kv">
            <ui:VisualElement class="row map-kv__head"><ui:VisualElement class="ds-icon ds-icon--clock map-kv__icon" /><ui:Label text="TRAVEL" class="map-kv__key" /></ui:VisualElement>
            <ui:Label name="site-travel" text="2 H" class="map-kv__value" />
          </ui:VisualElement>
          <ui:VisualElement class="map-kv map-kv--wide">
            <ui:VisualElement class="row map-kv__head"><ui:VisualElement class="ds-icon ds-icon--shield map-kv__icon" /><ui:Label name="site-def-label" text="DEFENSE (AI EST)" class="map-kv__key" /></ui:VisualElement>
            <ui:Label name="site-def" text="~34" class="map-kv__value" />
          </ui:VisualElement>
          <ui:VisualElement class="map-kv map-kv--wide map-kv--last">
            <ui:VisualElement class="row map-kv__head"><ui:VisualElement class="ds-icon ds-icon--box map-kv__icon" /><ui:Label text="HOLDS" class="map-kv__key" /></ui:VisualElement>
            <ui:Label name="site-loot" text="200 E  40 F  20 C" class="map-kv__value" />
          </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="ds-section map-sheet__section">
          <ui:VisualElement class="ds-icon ds-icon--ops ds-section__icon" />
          <ui:Label text="CHOOSE AN ORDER" class="ds-section__title" />
          <ui:VisualElement class="ds-section__rule" />
        </ui:VisualElement>
        <ui:VisualElement name="op-kinds" class="map-seg">
          <ui:VisualElement name="op-scout" class="map-seg__item"><ui:VisualElement class="ds-icon ds-icon--eye map-seg__icon" /><ui:Label text="SCOUT" class="map-seg__label" /></ui:VisualElement>
          <ui:VisualElement name="op-raid" class="map-seg__item is-selected"><ui:VisualElement class="ds-icon ds-icon--swords map-seg__icon" /><ui:Label text="RAID" class="map-seg__label" /></ui:VisualElement>
          <ui:VisualElement name="op-hack" class="map-seg__item"><ui:VisualElement class="ds-icon ds-icon--chip map-seg__icon" /><ui:Label text="HACK" class="map-seg__label" /></ui:VisualElement>
          <ui:VisualElement name="op-sabotage" class="map-seg__item"><ui:VisualElement class="ds-icon ds-icon--hammer map-seg__icon" /><ui:Label text="SABOTAGE" class="map-seg__label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="row map-launch">
          <ui:VisualElement name="op-minus" class="map-step"><ui:Label text="-" class="map-step__label" /></ui:VisualElement>
          <ui:VisualElement class="map-amount">
            <ui:Label name="op-amount" text="6" class="map-amount__value" />
            <ui:Label name="op-amount-unit" text="PEOPLE" class="ds-label" />
          </ui:VisualElement>
          <ui:VisualElement name="op-plus" class="map-step"><ui:Label text="+" class="map-step__label" /></ui:VisualElement>
          <ui:VisualElement class="grow map-odds">
            <ui:Label name="op-odds" text="AI ODDS 62%" class="map-odds__value" />
            <ui:Label name="op-cost" text="FUEL 16 // BACK IN 4 H" class="map-odds__cost" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="row map-actions">
          <ui:VisualElement name="op-launch" class="ds-btn ds-btn--warn grow"><ui:VisualElement class="ds-icon ds-icon--swords map-actions__icon" /><ui:Label name="op-launch-label" text="LAUNCH RAID" class="ds-btn__label" /></ui:VisualElement>
          <ui:VisualElement name="site-claim" class="ds-btn ds-btn--primary map-claim"><ui:Label name="site-claim-label" text="CLAIM // 300 E" class="ds-btn__label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="map-reason" text="" class="ds-body t-amber map-reason" />

        <!-- trade with the site's owner (F-034, doc 10 s5): price by their heat; Marked factions refuse -->
        <ui:VisualElement name="map-trade" class="map-trade">
          <ui:VisualElement class="ds-section map-sheet__section">
            <ui:VisualElement class="ds-icon ds-icon--truck ds-section__icon" />
            <ui:Label text="TRADE" class="ds-section__title" />
            <ui:VisualElement class="ds-section__rule" />
          </ui:VisualElement>
          <ui:Label name="trade-left" text="3/3 TODAY // COLD x0.8" class="map-trade__left" />
          <ui:VisualElement class="row map-trade__row">
            <ui:VisualElement name="trade-0" class="map-trade__item"><ui:Label name="trade-0-get" text="+20 FUEL" class="map-trade__get" /><ui:Label name="trade-0-pay" text="80 E" class="map-trade__pay" /></ui:VisualElement>
            <ui:VisualElement name="trade-1" class="map-trade__item"><ui:Label name="trade-1-get" text="+200 CELLS" class="map-trade__get" /><ui:Label name="trade-1-pay" text="32 F" class="map-trade__pay" /></ui:VisualElement>
            <ui:VisualElement name="trade-2" class="map-trade__item"><ui:Label name="trade-2-get" text="+20 COMPUTE" class="map-trade__get" /><ui:Label name="trade-2-pay" text="120 E" class="map-trade__pay" /></ui:VisualElement>
            <ui:VisualElement name="trade-3" class="map-trade__item"><ui:Label name="trade-3-get" text="+1 BLUEPRINT" class="map-trade__get" /><ui:Label name="trade-3-pay" text="400 E" class="map-trade__pay" /></ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- operations in the field (rows are built in code) -->
      <ui:VisualElement name="map-ops" class="map-ops">
        <ui:VisualElement class="row map-op">
          <ui:Label text="RAID // SCRAP CONVOY ROUTE // 4 SENT" class="map-op__text grow" />
          <ui:Label text="1:12:40" class="map-op__time" />
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- heat per faction: name + level word + meter (never color alone) -->
      <ui:VisualElement class="ds-section map-section">
        <ui:VisualElement class="ds-icon ds-icon--flag ds-section__icon" />
        <ui:Label text="FACTIONS // HEAT" class="ds-section__title" />
        <ui:VisualElement class="ds-section__rule" />
      </ui:VisualElement>
      <ui:VisualElement class="row map-heat">
      <ui:VisualElement name="heat-0" class="ds-card map-heat__cell map-heat__cell--rust">
        <ui:VisualElement class="row map-heat__head">
          <ui:VisualElement class="ds-icon ds-icon--flag map-heat__icon" />
          <ui:Label text="RUSTBORN" class="map-heat__name grow" />
          <ui:Label name="heat-0-level" text="WATCHED 31" class="map-heat__level" />
        </ui:VisualElement>
        <ui:VisualElement name="heat-0-meter" class="ds-meter ds-meter--amber map-heat__meter" />
        <ui:Label name="adapt-0" text="KNOWS TURTLE 2 // FORT 1" class="map-adapt" />
        <ui:VisualElement class="row map-spy__line">
          <ui:VisualElement class="ds-icon ds-icon--eye map-spy__icon" />
          <ui:Label name="spy-0-state" text="NO AGENT" class="map-spy__state" />
        </ui:VisualElement>
        <ui:VisualElement class="row map-spy">
          <ui:VisualElement name="spy-0-a" class="map-spy__btn"><ui:VisualElement class="ds-icon ds-icon--target map-spy__bicon" /><ui:Label name="spy-0-a-label" text="PLANT 150 E" class="map-spy__label" /></ui:VisualElement>
          <ui:VisualElement name="spy-0-b" class="map-spy__btn is-hidden"><ui:VisualElement class="ds-icon ds-icon--evacuate map-spy__bicon" /><ui:Label text="RECALL" class="map-spy__label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="row map-spy">
          <ui:VisualElement name="pact-0" class="map-spy__btn map-pact"><ui:VisualElement class="ds-icon ds-icon--hand map-spy__bicon" /><ui:Label name="pact-0-label" text="PACT // 320 E 40 F" class="map-spy__label" /></ui:VisualElement>
          <ui:VisualElement name="ally-0" class="map-spy__btn map-pact map-ally is-disabled"><ui:VisualElement class="ds-icon ds-icon--shield map-spy__bicon" /><ui:Label name="ally-0-label" text="ALLY // NEEDS COLD" class="map-spy__label" /></ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="heat-1" class="ds-card map-heat__cell map-heat__cell--vanguard">
        <ui:VisualElement class="row map-heat__head">
          <ui:VisualElement class="ds-icon ds-icon--flag map-heat__icon" />
          <ui:Label text="VANGUARD" class="map-heat__name grow" />
          <ui:Label name="heat-1-level" text="COLD 4" class="map-heat__level" />
        </ui:VisualElement>
        <ui:VisualElement name="heat-1-meter" class="ds-meter  map-heat__meter" />
        <ui:Label name="adapt-1" text="" class="map-adapt is-hidden" />
        <ui:VisualElement class="row map-spy__line">
          <ui:VisualElement class="ds-icon ds-icon--eye map-spy__icon" />
          <ui:Label name="spy-1-state" text="AGENT INSIDE" class="map-spy__state is-on" />
        </ui:VisualElement>
        <ui:VisualElement class="row map-spy">
          <ui:VisualElement name="spy-1-a" class="map-spy__btn"><ui:VisualElement class="ds-icon ds-icon--target map-spy__bicon" /><ui:Label name="spy-1-a-label" text="FRAME" class="map-spy__label" /></ui:VisualElement>
          <ui:VisualElement name="spy-1-b" class="map-spy__btn"><ui:VisualElement class="ds-icon ds-icon--evacuate map-spy__bicon" /><ui:Label text="RECALL" class="map-spy__label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="row map-spy">
          <ui:VisualElement name="pact-1" class="map-spy__btn map-pact"><ui:VisualElement class="ds-icon ds-icon--hand map-spy__bicon" /><ui:Label name="pact-1-label" text="PACT // 320 E 40 F" class="map-spy__label" /></ui:VisualElement>
          <ui:VisualElement name="ally-1" class="map-spy__btn map-pact map-ally is-on"><ui:VisualElement class="ds-icon ds-icon--shield map-spy__bicon" /><ui:Label name="ally-1-label" text="ALLIED // END" class="map-spy__label" /></ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="heat-2" class="ds-card map-heat__cell map-heat__cell--church">
        <ui:VisualElement class="row map-heat__head">
          <ui:VisualElement class="ds-icon ds-icon--flag map-heat__icon" />
          <ui:Label text="CHURCH" class="map-heat__name grow" />
          <ui:Label name="heat-2-level" text="COLD 0" class="map-heat__level" />
        </ui:VisualElement>
        <ui:VisualElement name="heat-2-meter" class="ds-meter ds-meter--magenta map-heat__meter" />
        <ui:Label name="adapt-2" text="" class="map-adapt is-hidden" />
        <ui:VisualElement class="row map-spy__line">
          <ui:VisualElement class="ds-icon ds-icon--eye map-spy__icon" />
          <ui:Label name="spy-2-state" text="NO AGENT" class="map-spy__state" />
        </ui:VisualElement>
        <ui:VisualElement class="row map-spy">
          <ui:VisualElement name="spy-2-a" class="map-spy__btn"><ui:VisualElement class="ds-icon ds-icon--target map-spy__bicon" /><ui:Label name="spy-2-a-label" text="PLANT 150 E" class="map-spy__label" /></ui:VisualElement>
          <ui:VisualElement name="spy-2-b" class="map-spy__btn is-hidden"><ui:VisualElement class="ds-icon ds-icon--evacuate map-spy__bicon" /><ui:Label text="RECALL" class="map-spy__label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="row map-spy">
          <ui:VisualElement name="pact-2" class="map-spy__btn map-pact"><ui:VisualElement class="ds-icon ds-icon--hand map-spy__bicon" /><ui:Label name="pact-2-label" text="PACT // 320 E 40 F" class="map-spy__label" /></ui:VisualElement>
          <ui:VisualElement name="ally-2" class="map-spy__btn map-pact map-ally"><ui:VisualElement class="ds-icon ds-icon--shield map-spy__bicon" /><ui:Label name="ally-2-label" text="ALLY // 600 E 100 F" class="map-spy__label" /></ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="heat-3" class="ds-card map-heat__cell map-heat__cell--holdout">
        <ui:VisualElement class="row map-heat__head">
          <ui:VisualElement class="ds-icon ds-icon--flag map-heat__icon" />
          <ui:Label text="HALCYON" class="map-heat__name grow" />
          <ui:Label name="heat-3-level" text="COLD 0" class="map-heat__level" />
        </ui:VisualElement>
        <ui:VisualElement name="heat-3-meter" class="ds-meter ds-meter--white map-heat__meter" />
        <ui:Label name="adapt-3" text="" class="map-adapt is-hidden" />
        <ui:VisualElement class="row map-spy__line">
          <ui:VisualElement class="ds-icon ds-icon--eye map-spy__icon" />
          <ui:Label name="spy-3-state" text="NO AGENT" class="map-spy__state" />
        </ui:VisualElement>
        <ui:VisualElement class="row map-spy">
          <ui:VisualElement name="spy-3-a" class="map-spy__btn"><ui:VisualElement class="ds-icon ds-icon--target map-spy__bicon" /><ui:Label name="spy-3-a-label" text="PLANT 150 E" class="map-spy__label" /></ui:VisualElement>
          <ui:VisualElement name="spy-3-b" class="map-spy__btn is-hidden"><ui:VisualElement class="ds-icon ds-icon--evacuate map-spy__bicon" /><ui:Label text="RECALL" class="map-spy__label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="row map-spy">
          <ui:VisualElement name="pact-3" class="map-spy__btn map-pact"><ui:VisualElement class="ds-icon ds-icon--hand map-spy__bicon" /><ui:Label name="pact-3-label" text="PACT // 320 E 40 F" class="map-spy__label" /></ui:VisualElement>
          <ui:VisualElement name="ally-3" class="map-spy__btn map-pact map-ally"><ui:VisualElement class="ds-icon ds-icon--shield map-spy__bicon" /><ui:Label name="ally-3-label" text="ALLY // 600 E 100 F" class="map-spy__label" /></ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
      </ui:VisualElement>
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
