/* Opening (SPEC-043 s4): a letterboxed film over the real Hub. One mood class per beat (op--boot/before/war/dark/
   now/handler) recolours the accents; the camera, lights and sound carry the picture. Bar heights, the black and
   the flash are driven from code (OpeningFlow). Tokens only. */

.op { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }

/* the lower half darkens toward the subtitles so a line always reads over the world */
.op__grade { bottom: 0; height: 62%; --sheen-reach: 1; }

.op__flash { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--c-red-glow); opacity: 0; }
.op__white { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--c-white); opacity: 0; }

/* the war room: the AI's terminal wall (cyan), red on launch. Sits above the subtitles, inside the letterbox. */
.op-room { position: absolute; left: var(--s-8); right: var(--s-8); top: 15%; bottom: 38%; display: none; --room-color: var(--c-cyan); --room-dim: var(--c-cyan-line); }
.op-room.is-on { display: flex; }
.op-room--red { --room-color: var(--c-red); --room-dim: var(--c-red-glow); }
.room__row { flex-grow: 1; align-items: stretch; margin-top: var(--s-3); }
.room__panel { border-width: 2px; border-color: var(--c-cyan-line); background-color: var(--c-panel-sunken); padding: var(--s-2) var(--s-3); opacity: 0; }
.op-room--red .room__panel { border-color: var(--c-red-glow); }
.room__panel--map { height: 30%; }
.room__panel--side { width: 30%; }
.room__panel--log { flex-grow: 1; margin-right: var(--s-3); }
.room__head { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-nano); letter-spacing: var(--ls-wide); color: var(--c-cyan); margin-bottom: var(--s-1); }
.op-room--red .room__head { color: var(--c-red); }
.room__canvas { flex-grow: 1; }
.room__core { flex-grow: 1; align-items: center; justify-content: center; margin: 0 var(--s-3); }
.room__eye { width: 240px; height: 240px; --ring-color: var(--c-cyan); --core-color: var(--c-cyan-glow); }
.op-room--red .room__eye { --ring-color: var(--c-red); --core-color: var(--c-red-glow); }
.room__status { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-md); letter-spacing: var(--ls-wide); color: var(--c-cyan); margin-top: var(--s-4); text-shadow: 0 0 14px var(--c-cyan-glow); }
.op-room--red .room__status { color: var(--c-red); text-shadow: 0 0 14px var(--c-red-glow); }
.room__log { flex-grow: 1; overflow: hidden; }
.room__log-line { -unity-font-definition: resource("Fonts/IBMPlexMono-Regular"); font-size: var(--fs-nano); color: var(--c-text-dim); white-space: nowrap; }
.op-room--red .room__log-line { color: var(--c-red); }
.room__alarm { position: absolute; left: -20px; right: -20px; top: -20px; bottom: -20px; border-width: 6px; border-color: var(--c-red); opacity: 0; }

/* before the core wakes: true black with a CRT trace across the middle */
.op__black { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--c-void); justify-content: center; align-items: center; }
.op__crt { width: 0; height: 3px; background-color: var(--c-cyan); }

/* the log's frame: a label and progress at the top, SKIP at the bottom, over the picture (no bars) */
.op__bar { position: absolute; left: 0; right: 0; padding: 0 var(--s-10); }
.op__bar--top { top: 120px; }
.op__bar--bottom { bottom: 60px; flex-direction: row; justify-content: space-between; align-items: center; }
.op__bar-row { align-items: center; margin-bottom: var(--s-3); }
.op__rec { width: 12px; height: 12px; border-radius: 6px; margin-right: var(--s-3); background-color: var(--c-red); }
.op__bar-label { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-nano); letter-spacing: var(--ls-wide); color: var(--c-text-dim); text-shadow: 0 1px 8px var(--c-void); }

.op__pip { flex-grow: 1; height: 4px; margin-right: var(--s-2); border-radius: 2px; background-color: var(--c-line); }
.op__pip.is-on { background-color: var(--c-cyan); }
.op--launch .op__pip.is-on, .op--fire .op__pip.is-on, .op--attack .op__pip.is-on, .op--deadswitch .op__pip.is-on { background-color: var(--c-red); }
.op--you .op__pip.is-on { background-color: var(--c-violet); }

/* subtitles: lower third, above the bottom bar */
.op__sub { position: absolute; left: var(--s-10); right: var(--s-10); bottom: 21%; }
.op__kicker-row { align-items: center; margin-bottom: var(--s-4); }
.op__tick { width: 40px; height: 3px; margin-right: var(--s-3); background-color: var(--c-cyan); }
.op__kicker {
    -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold");
    font-size: var(--fs-micro);
    letter-spacing: var(--ls-wide);
    color: var(--c-cyan);
}

.op--launch .op__kicker, .op--fire .op__kicker, .op--attack .op__kicker, .op--deadswitch .op__kicker { color: var(--c-red); }
.op--launch .op__tick, .op--fire .op__tick, .op--attack .op__tick, .op--deadswitch .op__tick { background-color: var(--c-red); }
.op--hold .op__kicker { color: var(--c-amber); }
.op--hold .op__tick { background-color: var(--c-amber); }

.op__line {
    -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold");
    font-size: var(--fs-xl);
    color: var(--c-white);
    white-space: normal;
    min-height: 240px;
    text-shadow: 0 2px 14px var(--c-void);
}

/* the machine's own readouts: monospace caps, centred on the frame */
.op__line--terminal {
    -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold");
    font-size: var(--fs-xl);
    letter-spacing: var(--ls-wide);
    color: var(--c-cyan);
    -unity-text-align: upper-center;
    text-shadow: 0 0 18px var(--c-cyan-glow);
}

.op--deadswitch .op__line--terminal { color: var(--c-red); text-shadow: 0 0 18px var(--c-red-glow); }
.op--after .op__line--terminal { color: var(--c-white); text-shadow: 0 0 18px var(--c-void); }

/* the handler beat: the fragment's face and the one action */
.op__hand { position: absolute; left: var(--s-10); right: var(--s-10); bottom: 19%; align-items: center; }
.op__hand.is-hidden { display: none; }
.op__orb { width: 220px; height: 220px; margin-bottom: var(--s-6); --ring-color: var(--c-violet); --core-color: var(--c-cyan-glow); }
.op__hand-kicker { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-micro); letter-spacing: var(--ls-wide); color: var(--c-violet); margin-bottom: var(--s-4); }
.op__hand-line {
    -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold");
    font-size: var(--fs-lg);
    color: var(--c-white);
    white-space: normal;
    -unity-text-align: upper-center;
    min-height: 200px;
    text-shadow: 0 2px 14px var(--c-void);
}

.op__take { margin-top: var(--s-8); min-width: 560px; height: var(--touch); border-radius: 64px; }
.op__take > .ds-btn__label { font-size: var(--fs-md); letter-spacing: var(--ls-wide); }

/* restore steps: a field card over the framed building (lower third) */
.op__restore { position: absolute; left: var(--s-8); right: var(--s-8); bottom: 17%; padding: var(--s-6) var(--s-8); border-radius: var(--r-xl); border-width: 2px; border-color: var(--c-cyan-line); border-left-width: 6px; border-left-color: var(--c-cyan); background-color: var(--c-elev-1); }
.op__restore.is-hidden { display: none; }
.op__restore--core { border-left-color: var(--c-violet); border-color: var(--c-violet-dim); }
.op__restore-head { align-items: center; margin-bottom: var(--s-3); }
.op__restore-icon { width: 48px; height: 48px; margin-right: var(--s-4); --icon-color: var(--c-cyan); }
.op__restore--core .op__restore-icon { --icon-color: var(--c-violet); }
.op__restore-title { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-md); letter-spacing: var(--ls-wide); color: var(--c-white); flex-grow: 1; }
.op__restore-step { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-micro); color: var(--c-text-dim); }
.op__restore-body { font-size: var(--fs-sm); color: var(--c-text); white-space: normal; margin-bottom: var(--s-6); }
.op__restore-btn { height: var(--touch); border-radius: 56px; overflow: hidden; justify-content: center; }
.op__restore--core .op__restore-btn { background-color: var(--c-violet); }
.op__restore-btn.is-busy { opacity: 0.5; }
.op__restore-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background-color: var(--c-red); }
.op__restore-label { font-size: var(--fs-sm); letter-spacing: var(--ls-wide); }

.op__tap { font-size: var(--fs-nano); letter-spacing: var(--ls-wide); color: var(--c-text-faint); margin-top: var(--s-4); }
.op__tap.is-hidden { opacity: 0; }
.op__skip { flex-direction: row; align-items: center; min-width: var(--touch); height: var(--touch); justify-content: flex-end; }
.op__skip-label { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-micro); letter-spacing: var(--ls-wide); color: var(--c-text-dim); }
.op__skip-icon { width: 30px; height: 30px; margin-left: var(--s-2); --icon-color: var(--c-text-dim); }
