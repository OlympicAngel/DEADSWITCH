/* Prologue overlay (SPEC-009, SPEC-041): the core wakes in the dark. Tokens only. */

.pro { position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: center; padding: var(--s-12) var(--s-10); background-color: var(--c-scrim); }
.pro__scrim { top: 0; bottom: 0; --sheen-color: var(--c-scrim-edge); --sheen-reach: 1; }
.pro__center { align-items: center; }
.pro__orb { width: 320px; height: 320px; margin-bottom: var(--s-8); --ring-color: var(--c-cyan); --core-color: var(--c-cyan-glow); }
.pro__head { align-items: center; margin-bottom: var(--s-5); }
.pro__rec { width: 12px; height: 12px; border-radius: 6px; margin-right: var(--s-2); background-color: var(--c-red); }
.pro__head-label { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-nano); letter-spacing: var(--ls-wide); color: var(--c-cyan-dim); }
.pro__text {
    -unity-font-definition: resource("Fonts/ChakraPetch-Regular");
    font-size: var(--fs-lg);
    color: var(--c-white);
    white-space: normal;
    min-height: 260px;
    -unity-text-align: upper-center;
}
.pro__pips { margin-top: var(--s-6); }
.pro__pip { width: 44px; height: 6px; margin: 0 var(--s-1); border-radius: 3px; background-color: var(--c-line-mid); }
.pro__pip.is-on { background-color: var(--c-cyan); }
.pro__skip { position: absolute; right: var(--s-8); bottom: 140px; min-width: 200px; border-radius: 44px; }
