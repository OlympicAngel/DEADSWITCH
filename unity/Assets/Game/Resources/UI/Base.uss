/* 3D base overlays (F-010): floating facility labels and the slot sheet. Tokens + kit only. */

/* ---------- Floating labels (reference: bracketed tags above facilities) ---------- */
.lbl {
    position: absolute;
    padding: var(--s-1) var(--s-4) var(--s-1) var(--s-4);
    background-color: var(--c-scrim);
    border-width: 0;
    border-top-width: 1px;
    border-radius: var(--r-lg);
    border-color: var(--c-edge-hi);
    translate: -50% -100%;
    min-width: 150px;
    transition-property: opacity, scale, background-color;
    transition-duration: 0.18s;
}

.lbl > .ds-corner { display: none; }

.lbl__name {
    -unity-font-definition: resource("Fonts/ChakraPetch-Bold");
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-label);
    color: var(--c-text);
}

.lbl__sub {
    flex-direction: row;
    align-items: center;
}

.lbl__level {
    -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold");
    font-size: var(--fs-micro);
    color: var(--c-phosphor);
    letter-spacing: var(--ls-label);
}

.lbl__state {
    -unity-font-definition: resource("Fonts/IBMPlexMono-Medium");
    font-size: var(--fs-micro);
    color: var(--c-text-dim);
    margin-left: var(--s-3);
}

.lbl .ds-pip { width: 10px; height: 10px; margin-right: var(--s-2); }

.lbl--empty { background-color: var(--c-panel-sunken); border-top-color: var(--c-cyan-line); }
.lbl--empty > .ds-corner { border-color: var(--c-text-faint); }
.lbl--empty .lbl__name { color: var(--c-cyan-dim); }
.lbl--empty .lbl__level { color: var(--c-cyan); }
.lbl--warn { border-top-color: var(--c-amber); }
.lbl--warn .lbl__level { color: var(--c-amber); }
.lbl--off { border-top-color: var(--c-red); }
.lbl--off .lbl__level { color: var(--c-red); }
.lbl--core { border-top-color: var(--c-cyan); }
.lbl--core .lbl__name { color: var(--c-phosphor); text-shadow: 0 0 8px var(--c-phosphor-glow); }
.lbl.is-selected { border-top-color: var(--c-cyan); background-color: var(--c-glass); scale: 1.12 1.12; }
.lbl.is-selected .lbl__name { color: var(--c-cyan); text-shadow: 0 0 8px var(--c-cyan-glow); }
.lbl.is-faded { opacity: 0.15; }

/* ---------- Slot sheet v2 (SPEC-041): icon header, stat tiles, tonal rows ---------- */
.sheet { padding-bottom: 64px; }
.sheet__head { flex-direction: row; align-items: center; margin-bottom: var(--s-4); }
.sheet__well { width: 88px; height: 88px; align-items: center; justify-content: center; margin-right: var(--s-4); border-radius: var(--r-lg); background-color: var(--c-cyan-wash); }
.sheet__icon { width: 52px; height: 52px; --icon-color: var(--c-cyan); }
.sheet__titles { flex-grow: 1; flex-shrink: 1; }
.sheet__title { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-lg); letter-spacing: var(--ls-label); color: var(--c-white); }
.sheet__level { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-micro); letter-spacing: var(--ls-label); color: var(--c-cyan); }
.sheet__chips { flex-direction: row; flex-wrap: wrap; margin-bottom: var(--s-3); }
.sheet__chips > .ds-chip { margin-right: var(--s-2); margin-bottom: var(--s-2); }
.sheet__blurb { -unity-font-definition: resource("Fonts/ChakraPetch-Regular"); font-size: var(--fs-xs); margin-bottom: var(--s-4); color: var(--c-text-dim); white-space: normal; }
.sheet__tiles { flex-direction: row; margin-bottom: var(--s-4); }
.sheet__tile { flex-grow: 1; flex-basis: 0; padding: var(--s-3); margin-right: var(--s-2); border-radius: var(--r-lg); background-color: var(--c-elev-2); }
.sheet__tile.is-last { margin-right: 0; }
.sheet__tile-top { flex-direction: row; align-items: center; margin-bottom: var(--s-1); }
.sheet__tile-icon { width: 24px; height: 24px; margin-right: var(--s-1); --icon-color: var(--c-text-dim); }
.sheet__tile-key { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-nano); letter-spacing: var(--ls-label); color: var(--c-text-dim); }
.sheet__tile-value { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-micro); color: var(--c-white); white-space: normal; }
.sheet__tile-next { -unity-font-definition: resource("Fonts/IBMPlexMono-Medium"); font-size: var(--fs-nano); color: var(--c-phosphor); margin-top: 2px; white-space: normal; }
.sheet__actions { flex-direction: row; flex-wrap: wrap; }
.sheet__actions > .ds-btn { flex-grow: 1; margin-right: var(--s-3); margin-bottom: var(--s-3); }
.sheet__primary { min-width: 520px; }
.sheet__reason { margin-top: var(--s-2); color: var(--c-amber); white-space: normal; }

.sheet__progress { height: 14px; border-radius: 7px; background-color: var(--c-panel-sunken); margin: var(--s-2) 0 var(--s-4) 0; overflow: hidden; }
.sheet__progress-fill { height: 100%; width: 0; border-radius: 7px; background-color: var(--c-amber); }

.cost { flex-direction: row; align-items: center; margin-top: var(--s-1); }
.cost__item { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-micro); color: var(--c-text); margin-right: var(--s-4); }
.cost__item.is-short { color: var(--c-red); }

/* Build options for an empty plot */
.opt {
    flex-direction: row;
    align-items: center;
    padding: var(--s-3) var(--s-4);
    margin-bottom: var(--s-3);
    border-width: 0;
    border-radius: var(--r-lg);
    background-color: var(--c-elev-2);
    min-height: 132px;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.opt:hover { background-color: var(--c-panel-raised); }
.opt:active { background-color: var(--c-cyan-wash); }
.opt.is-disabled { opacity: 0.45; }
.opt__icon { width: 64px; height: 64px; margin-right: var(--s-4); --icon-color: var(--c-cyan); }
.opt__body { flex-grow: 1; flex-shrink: 1; }
.opt__name { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-sm); letter-spacing: var(--ls-label); color: var(--c-text); }
.opt__desc { -unity-font-definition: resource("Fonts/ChakraPetch-Regular"); font-size: var(--fs-micro); color: var(--c-text-dim); white-space: normal; margin-top: var(--s-1); }
.opt__time { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-xs); color: var(--c-text-dim); margin-left: var(--s-3); }

/* ---------- Resource breakdown sheet (SPEC-039 B) ---------- */
.rsheet { max-height: 78%; border-top-color: var(--c-cyan); }
.rsheet__scroll { flex-shrink: 1; }
.rsheet__head { flex-direction: row; align-items: center; margin-bottom: var(--s-3); }
.rsheet__well { width: 96px; height: 96px; align-items: center; justify-content: center; margin-right: var(--s-4); border-radius: var(--r-lg); background-color: var(--c-cyan-wash); }
.rsheet__icon { width: 60px; height: 60px; --icon-color: var(--c-cyan); }
.rsheet__titles { flex-grow: 1; flex-shrink: 1; }
.rsheet__name { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-sm); letter-spacing: var(--ls-wide); color: var(--c-text-dim); }
.rsheet__value { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-xl); color: var(--c-text); }
.rsheet__cap { -unity-font-definition: resource("Fonts/IBMPlexMono-Medium"); font-size: var(--fs-sm); color: var(--c-text-dim); padding-bottom: var(--s-2); }
.rsheet__close-icon { width: 40px; height: 40px; --icon-color: var(--c-text-dim); }
.rsheet__bar { height: 18px; margin-bottom: var(--s-3); }
.rsheet__rate { flex-direction: row; align-items: center; margin-bottom: var(--s-2); }
.rsheet__when { font-size: var(--fs-xs); color: var(--c-text); margin-left: var(--s-3); white-space: normal; flex-shrink: 1; }
.rsheet__note { font-size: var(--fs-xs); color: var(--c-amber); margin-bottom: var(--s-2); }
.rsheet__empty { font-size: var(--fs-xs); color: var(--c-text-faint); margin-bottom: var(--s-3); }

.rsheet__line { flex-direction: row; align-items: center; min-height: 80px; padding: 0 var(--s-3); margin-bottom: var(--s-2); border-radius: var(--r-md); background-color: var(--c-elev-2); }
.rsheet__line.is-link:active { background-color: var(--c-cyan-wash); }
.rsheet__line-icon { width: 40px; height: 40px; margin-right: var(--s-3); --icon-color: var(--c-text-dim); }
.rsheet__line-label { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-xs); letter-spacing: var(--ls-label); color: var(--c-text); flex-grow: 1; }
.rsheet__line > .ds-delta { align-self: center; }
.rsheet__chev { width: 28px; height: 28px; margin-left: var(--s-2); --icon-color: var(--c-text-faint); }

.rsheet__help {
    flex-direction: row;
    align-items: center;
    min-height: var(--touch);
    padding: var(--s-3);
    margin-bottom: var(--s-2);
    border-width: 0;
    border-left-width: 4px;
    border-radius: var(--r-lg);
    border-color: var(--c-cyan);
    background-color: var(--c-elev-2);
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.rsheet__help:active { scale: 0.98 0.98; background-color: var(--c-cyan-wash); }
.rsheet__help.is-disabled { opacity: 0.45; }
.rsheet__help-well { width: 72px; height: 72px; align-items: center; justify-content: center; margin-right: var(--s-3); border-radius: var(--r-md); background-color: var(--c-cyan-wash); }
.rsheet__help-icon { width: 44px; height: 44px; --icon-color: var(--c-cyan); }
.rsheet__help-body { flex-grow: 1; flex-shrink: 1; }
.rsheet__help-title { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-xs); letter-spacing: var(--ls-label); color: var(--c-cyan); }
.rsheet__help-why { -unity-font-definition: resource("Fonts/ChakraPetch-Regular"); font-size: var(--fs-micro); color: var(--c-text); white-space: normal; margin-top: 2px; }
.rsheet__help-go { width: 36px; height: 36px; margin-left: var(--s-2); --icon-color: var(--c-cyan); }
.opt--recommended { border-color: var(--c-cyan); border-left-width: 6px; background-color: var(--c-cyan-wash); }
.opt--recommended .opt__icon { --icon-color: var(--c-cyan); }

/* ---------- Focus: quick actions under the framed facility (SPEC-039 C) ---------- */
.qa { position: absolute; flex-direction: row; width: 640px; translate: -50% 24px; }
.qa.is-hidden { display: none; }
.qa > .ds-tile { min-height: 132px; }
.sheet__scroll { flex-shrink: 1; max-height: 1100px; }
.sheet__more { margin-top: var(--s-2); }

/* ---------- While you were away (SPEC-039 idea 20) ---------- */
.away { position: absolute; left: var(--s-6); right: var(--s-6); top: 220px; }
.away.is-hidden { display: none; }
.away__row { flex-direction: row; align-items: center; min-height: 64px; border-bottom-width: 1px; border-color: var(--c-cyan-line); }
.away__icon { width: 36px; height: 36px; margin-right: var(--s-3); --icon-color: var(--c-cyan); }
.away__name { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-xs); letter-spacing: var(--ls-label); color: var(--c-text); flex-grow: 1; }
.away__row > .ds-delta { align-self: center; }
.away__raids { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-micro); letter-spacing: var(--ls-label); color: var(--c-amber); margin-top: var(--s-3); }
.away__hint { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-nano); letter-spacing: var(--ls-wide); color: var(--c-text-faint); margin-top: var(--s-3); -unity-text-align: middle-right; }

/* Floating "+N" over a producer (SPEC-039 idea 17) */
.pickup { position: absolute; flex-direction: row; align-items: center; translate: -50% -100%; }
.pickup__label { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-sm); color: var(--c-phosphor); text-shadow: 0 0 10px var(--c-phosphor-glow); }
.pickup__icon { width: 30px; height: 30px; margin-right: 2px; --icon-color: var(--c-phosphor); }

/* ---------- Command menu (SPEC-042 finding 1) ---------- */
.cmenu { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.cmenu.is-hidden { display: none; }
.cmenu__backdrop { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--c-scrim); }
.cmenu__drawer { position: absolute; left: 0; top: 0; bottom: 0; width: 84%; padding: var(--s-8) var(--s-5) var(--s-6) var(--s-5); border-right-width: 1px; border-color: var(--c-cyan-line); border-top-right-radius: var(--r-xl); border-bottom-right-radius: var(--r-xl); background-color: var(--c-elev-1); --sheen-color: var(--c-cyan-wash); --sheen-reach: 0.3; }
.cmenu__head { flex-direction: row; align-items: center; margin-bottom: var(--s-4); }
.cmenu__titles { flex-grow: 1; }
.cmenu__title { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-lg); letter-spacing: var(--ls-wide); color: var(--c-white); }
.cmenu__status { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-micro); letter-spacing: var(--ls-label); color: var(--c-cyan); }
.cmenu__scroll { flex-grow: 1; }
.cmenu__item { flex-direction: row; align-items: center; min-height: var(--touch); padding: var(--s-2) 0; border-bottom-width: 1px; border-color: var(--c-line); }
.cmenu__item:active { background-color: var(--c-cyan-wash); }
.cmenu__well { width: 72px; height: 72px; align-items: center; justify-content: center; margin-right: var(--s-4); border-radius: var(--r-lg); background-color: var(--c-cyan-wash); }
.cmenu__icon { width: 40px; height: 40px; --icon-color: var(--c-cyan); }
.cmenu__body { flex-grow: 1; flex-shrink: 1; }
.cmenu__name { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-sm); letter-spacing: var(--ls-label); color: var(--c-white); }
.cmenu__meaning { -unity-font-definition: resource("Fonts/ChakraPetch-Regular"); font-size: var(--fs-micro); color: var(--c-text-dim); white-space: normal; }
.cmenu__badge { min-width: 36px; height: 36px; padding: 0 var(--s-2); margin-left: var(--s-2); border-radius: 18px; align-items: center; justify-content: center; background-color: var(--c-amber); }
.cmenu__badge.is-hidden { display: none; }
.cmenu__badge-label { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-nano); color: var(--c-world); }
.cmenu__chev { width: 28px; height: 28px; margin-left: var(--s-2); --icon-color: var(--c-text-faint); }

/* ---------- Build picker (SPEC-042 finding 7): category track + grid of build cards ---------- */
.build-tabs { margin-bottom: var(--s-4); }
.build-tab { flex-direction: column; padding: var(--s-1) 0; }
.build-tab__icon { width: 32px; height: 32px; margin-bottom: 2px; --icon-color: var(--c-text-dim); }
.build-tab.is-selected .build-tab__icon { --icon-color: var(--c-cyan); }
.build-tab__label { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-nano); letter-spacing: var(--ls-label); }
.build-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.build-card { width: 49%; min-height: 300px; margin-bottom: var(--s-3); padding: var(--s-4); border-radius: var(--r-lg); border-top-width: 1px; border-color: var(--c-edge-hi); background-color: var(--c-elev-2); --sheen-color: var(--c-sheen-strong); transition-property: scale, background-color; transition-duration: 0.12s; }
.build-card:active { scale: 0.97 0.97; background-color: var(--c-cyan-wash); }
.build-card__top { flex-direction: row; align-items: flex-start; justify-content: space-between; margin-bottom: var(--s-3); }
.build-card__well { width: 88px; height: 88px; align-items: center; justify-content: center; border-radius: var(--r-lg); background-color: var(--c-cyan-wash); }
.build-card__icon { width: 54px; height: 54px; --icon-color: var(--c-cyan); }
.build-card__tag { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-nano); letter-spacing: var(--ls-tight); color: var(--c-world); padding: 2px var(--s-2); border-radius: var(--r-sm); background-color: var(--c-cyan); }
.build-card__name { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-sm); letter-spacing: var(--ls-tight); color: var(--c-white); white-space: normal; }
.build-card__out { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-micro); color: var(--c-phosphor); margin: var(--s-1) 0 var(--s-2) 0; white-space: normal; }
.build-card__foot { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-nano); letter-spacing: var(--ls-label); color: var(--c-text-dim); margin-top: var(--s-2); }
.build-card.is-recommended { border-top-width: 3px; border-color: var(--c-cyan); background-color: var(--c-cyan-wash); }
.build-card.is-waiting .build-card__foot { color: var(--c-amber); }
.build-card.is-waiting .build-card__well { background-color: var(--c-panel-sunken); }
.build-card.is-waiting .build-card__icon { --icon-color: var(--c-text-dim); }
.build-card.is-locked { opacity: 0.55; background-color: var(--c-panel-sunken); }
.build-card.is-locked .build-card__icon { --icon-color: var(--c-text-faint); }
.build-card.is-locked .build-card__well { background-color: var(--c-panel-sunken); }

/* ---------- Build queue (SPEC-042 finding 9) ---------- */
.qsheet__row { flex-direction: row; align-items: center; min-height: var(--touch); padding: var(--s-2) var(--s-3); margin-bottom: var(--s-2); border-radius: var(--r-lg); background-color: var(--c-elev-2); }
.qsheet__row:active { background-color: var(--c-cyan-wash); }
.qsheet__row--add { background-color: var(--c-cyan-wash); }
.qsheet__row--add .qsheet__name { color: var(--c-cyan); }
.qsheet__icon { width: 44px; height: 44px; margin-right: var(--s-3); --icon-color: var(--c-cyan); }
.qsheet__body { flex-grow: 1; flex-shrink: 1; }
.qsheet__name { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-xs); letter-spacing: var(--ls-tight); color: var(--c-white); }
.qsheet__kind { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-nano); letter-spacing: var(--ls-label); color: var(--c-text-dim); margin-left: var(--s-3); }
.qsheet__bar { height: 10px; margin-top: var(--s-2); border-width: 0; border-radius: 5px; }
.qsheet__time { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-xs); color: var(--c-amber); margin-left: var(--s-3); }
