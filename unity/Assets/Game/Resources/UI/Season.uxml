<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="Season.uss" />
  <!-- SEASON (F-048): the cosmetic season track. Rank from play, free and premium rewards (themes, AI voice packs,
       codex logs). Never expires. Sample values are for the preview; SeasonScreen fills everything. -->
  <ui:VisualElement name="season" class="ssn">
    <ui:VisualElement class="row ssn-head">
      <ui:Label text="SEASON" class="ds-title grow" />
      <ui:VisualElement name="ssn-close" class="ssn-close"><ui:Label text="X" class="ssn-close__x" /></ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement class="ds-panel ssn-card">
      <ui:Label name="ssn-title" text="SEASON 1 // SIGNAL FIRES" class="ds-label" />
      <ui:VisualElement class="row--baseline ssn-rank">
        <ui:Label name="ssn-rank" text="7" class="ds-value ds-value--hero" />
        <ui:Label name="ssn-rank-of" text="/ 20  RANK" class="ds-label ssn-rank__of" />
      </ui:VisualElement>
      <ui:VisualElement name="ssn-meter" class="ds-meter ssn-meter" />
      <ui:Label name="ssn-xp" text="1,750 XP // 250 TO RANK 8" class="ds-label t-dim ssn-xp" />
      <ui:Label text="Earned by holding the wall, winning ops, closing chapters and mastery. Never by waiting. This track never expires." class="ds-body t-faint ssn-note" />
      <ui:VisualElement class="row ssn-pass">
        <ui:VisualElement class="grow">
          <ui:Label text="SEASON PASS // PREMIUM TRACK" class="ds-label" />
          <ui:Label text="Cosmetics only. Everything already reached unlocks at once." class="ds-body t-dim ssn-note" />
        </ui:VisualElement>
        <ui:VisualElement name="ssn-buy" class="ds-btn ds-btn--primary ssn-buy"><ui:Label name="ssn-buy-label" text="UNLOCK PASS" class="ds-btn__label" /></ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:ScrollView name="ssn-scroll" class="grow ssn-scroll">
      <ui:VisualElement name="ssn-rewards" class="ssn-rewards">
        <ui:VisualElement class="row ssn-r is-unlocked"><ui:Label text="3" class="ssn-r__rank" /><ui:VisualElement class="grow"><ui:Label text="CODEX // FIRST LIGHT" class="ssn-r__name" /><ui:Label text="FREE // UNLOCKED" class="ssn-r__state" /><ui:Label text="Recovered dashcam, day 1 of the collapse: the traffic lights go green in every direction at once. Nobody moves." class="ssn-r__codex" /></ui:VisualElement></ui:VisualElement>
        <ui:VisualElement class="row ssn-r is-unlocked"><ui:Label text="7" class="ssn-r__rank" /><ui:VisualElement class="grow"><ui:Label text="HUD THEME // VERDIGRIS" class="ssn-r__name" /><ui:Label text="FREE // UNLOCKED" class="ssn-r__state" /></ui:VisualElement><ui:VisualElement class="ds-btn ds-btn--ghost ssn-r__btn"><ui:Label text="EQUIP" class="ds-btn__label" /></ui:VisualElement></ui:VisualElement>
        <ui:VisualElement class="row ssn-r is-premium"><ui:Label text="12" class="ssn-r__rank" /><ui:VisualElement class="grow"><ui:Label text="HUD THEME // ASH" class="ssn-r__name" /><ui:Label text="PASS // RANK 12" class="ssn-r__state" /></ui:VisualElement></ui:VisualElement>
      </ui:VisualElement>
    </ui:ScrollView>
    <ui:Label name="ssn-reason" text="" class="ds-body t-amber ssn-reason" />
  </ui:VisualElement>
</ui:UXML>
