/* HUD v3 (SPEC-041): the world is the hero. Status hugs the top edge, actions float in a dock, scrims keep
   text readable over the 3D base. Kit classes + tokens only. */

.hud { flex-grow: 1; }

/* ---------- Scrims over the world ---------- */
.hud-scrim--top { top: 0; height: 420px; }
.hud-scrim--bottom { bottom: 0; height: 560px; }

/* ---------- Resource pods ---------- */
.hud-top { flex-direction: row; align-items: stretch; padding: var(--s-6) var(--s-3) var(--s-2) var(--s-3); }

.pod {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 var(--s-1);
    padding: var(--s-2) var(--s-3) var(--s-2) var(--s-3);
    border-radius: var(--r-lg);
    border-top-width: 1px;
    border-color: var(--c-edge-hi);
    background-color: var(--c-glass);
    --sheen-color: var(--c-sheen);
    transition-property: background-color, scale;
    transition-duration: 0.2s;
}

.pod:active { scale: 0.96 0.96; }
.pod.is-hidden { display: none; }
.pod__top { align-items: flex-end; overflow: hidden; }
.pod__icon { flex-shrink: 0; width: 30px; height: 30px; margin-right: var(--s-2); margin-bottom: 6px; --icon-color: var(--c-cyan); }
.pod__value { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-md); color: var(--c-white); }
.pod__cap { flex-shrink: 1; -unity-font-definition: resource("Fonts/IBMPlexMono-Medium"); font-size: var(--fs-nano); color: var(--c-text-faint); padding-bottom: 6px; margin-left: 2px; }
.pod__bar { height: 6px; margin: var(--s-1) 0; border-radius: 3px; background-color: var(--c-panel-sunken); overflow: hidden; }
.pod__fill { height: 100%; width: 50%; border-radius: 3px; background-color: var(--c-cyan); }
.pod__foot { justify-content: space-between; overflow: hidden; }
.pod__rate { flex-shrink: 0; -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-nano); color: var(--c-phosphor); }
.pod__eta { flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; margin-left: var(--s-2); -unity-font-definition: resource("Fonts/IBMPlexMono-Medium"); font-size: var(--fs-nano); color: var(--c-text-dim); }
.pod__rate.is-down { color: var(--c-red); }
.pod__rate.is-flat { color: var(--c-text-dim); }
.pod__value.is-up { color: var(--c-phosphor); }
.pod__value.is-down { color: var(--c-red); }

/* a badge on the pod's top edge, clear of the value */
.pod__flag { position: absolute; top: -20px; right: 8px; padding: 0 var(--s-2); border-radius: var(--r-sm); background-color: var(--c-amber); }
.pod__flag.is-hidden { display: none; }
.pod__flag-label { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-nano); letter-spacing: var(--ls-tight); color: var(--c-world); }

/* states: word + color, never color alone */
.pod.is-low .pod__fill { background-color: var(--c-amber); }
.pod.is-low .pod__icon { --icon-color: var(--c-amber); }
.pod.is-short { background-color: var(--c-red-wash); border-top-color: var(--c-red); }
.pod.is-short .pod__fill { background-color: var(--c-red); }
.pod.is-short .pod__icon { --icon-color: var(--c-red); }
.pod.is-short .pod__flag { background-color: var(--c-red); }
.pod.is-full .pod__fill { background-color: var(--c-phosphor); }
.pod.is-full .pod__flag { background-color: var(--c-phosphor); }
.pod.is-pulse { background-color: var(--c-panel-raised); }

/* core corruption: gauge with the value inside */
.hud-core { width: 116px; align-items: center; justify-content: center; margin-left: var(--s-1); }
.hud-core__gauge { width: 88px; height: 88px; }
.hud-core__center { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; }
.hud-core__value { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-sm); }
.hud-core__band { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-nano); letter-spacing: var(--ls-tight); margin-top: -4px; }

/* ---------- Context strip ---------- */
.hud-context { flex-direction: row; align-items: center; padding: 0 var(--s-4); min-height: 72px; }
.hud-menu { width: 72px; height: 64px; align-items: center; justify-content: center; margin-right: var(--s-3); border-radius: var(--r-lg); background-color: var(--c-scrim); }
.hud-menu:active { background-color: var(--c-cyan-wash); }
.hud-menu__icon { width: 34px; height: 34px; --icon-color: var(--c-cyan); }
.hud-menu__badge { position: absolute; top: -4px; right: -4px; min-width: 28px; height: 28px; border-radius: 14px; align-items: center; justify-content: center; background-color: var(--c-amber); }
.hud-menu__badge.is-hidden { display: none; }
.hud-menu__badge-label { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-nano); color: var(--c-world); }
.hud-context__rec { width: 12px; height: 12px; border-radius: 6px; margin-right: var(--s-2); background-color: var(--c-red); }
.hud-context__feed { display: none; }
.hud-context__clock { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-xs); color: var(--c-white); margin-right: var(--s-4); flex-shrink: 0; }

.hud-heat { align-items: center; padding: var(--s-1) var(--s-3); border-radius: 22px; background-color: var(--c-scrim); }
.hud-heat__icon { width: 24px; height: 24px; margin-right: var(--s-1); --icon-color: var(--c-text-dim); }
.hud-heat__pip { width: 10px; height: 10px; margin-right: var(--s-2); border-width: 2px; border-color: var(--c-text-dim); }
.hud-heat__text { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-nano); letter-spacing: var(--ls-tight); color: var(--c-text-dim); }
.hud-heat--watched > .hud-heat__pip { border-color: var(--c-amber); }
.hud-heat--watched > .hud-heat__text { color: var(--c-amber); }
.hud-heat--watched > .hud-heat__icon { --icon-color: var(--c-amber); }
.hud-heat--hunted > .hud-heat__pip { border-color: var(--c-red); background-color: var(--c-red-glow); rotate: 45deg; }
.hud-heat--hunted > .hud-heat__text { color: var(--c-red); }
.hud-heat--hunted > .hud-heat__icon { --icon-color: var(--c-red); }
.hud-heat--marked > .hud-heat__pip { border-color: var(--c-red); background-color: var(--c-red); rotate: 45deg; }
.hud-heat--marked > .hud-heat__text { color: var(--c-red); }
.hud-heat--marked > .hud-heat__icon { --icon-color: var(--c-red); }

.hud-override { flex-direction: row; align-items: center; padding: var(--s-1) var(--s-3); border-radius: 22px; background-color: var(--c-scrim); }
.hud-override__label { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-nano); letter-spacing: var(--ls-label); color: var(--c-text-dim); }
.hud-opip { width: 16px; height: 16px; margin-left: var(--s-3); border-width: var(--bw); border-color: var(--c-amber-dim); rotate: 45deg; }
.hud-opip.is-on { background-color: var(--c-amber); border-color: var(--c-amber); }
.hud-opip.is-cooldown { border-color: var(--c-text-faint); background-color: var(--c-amber-wash); }

/* ---------- The view: alarm edge + status rail ---------- */
.hud-frame { position: absolute; left: var(--s-4); right: var(--s-4); top: 290px; bottom: 360px; }
.hud-frame.is-covered { display: none; }
.hud-alarm { position: absolute; left: -16px; right: -16px; top: -60px; bottom: -40px; border-width: 8px; border-color: var(--c-red-glow); opacity: 0; }
.hud-rail { position: absolute; right: 0; top: 0; align-items: flex-end; }

.rail-pill {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--s-2);
    padding: var(--s-2) var(--s-4) var(--s-2) var(--s-3);
    border-radius: 40px;
    background-color: var(--c-scrim);
    overflow: hidden;
}

.hud-alert { border-left-width: 6px; border-color: var(--c-amber); background-color: var(--c-amber-wash); border-top-left-radius: var(--r-lg); border-bottom-left-radius: var(--r-lg); }
.hud-alert.is-hidden { display: none; }
.hud-alert--red { border-color: var(--c-red); background-color: var(--c-red-wash); }
.hud-alert--red .hud-alert__title, .hud-alert--red .hud-alert__time { color: var(--c-red); }
.hud-alert__pip { width: 18px; height: 18px; margin-right: var(--s-3); }
.hud-alert__title { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-nano); letter-spacing: var(--ls-label); color: var(--c-amber); }
.hud-alert__time { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-lg); color: var(--c-amber); flex-shrink: 0; }

.hud-job { flex-direction: column; align-items: stretch; min-width: 200px; }
.hud-job__icon { width: 30px; height: 30px; margin-right: var(--s-2); --icon-color: var(--c-amber); }
.hud-job__text { flex-grow: 1; flex-shrink: 1; }
.hud-job__label { display: none; -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-nano); letter-spacing: var(--ls-tight); color: var(--c-cyan); }
.hud-job__time { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-xs); color: var(--c-white); flex-shrink: 0; }
.hud-job__count { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-nano); color: var(--c-text-dim); margin-left: var(--s-2); }
.hud-job__bar { height: 6px; margin-top: var(--s-1); border-width: 0; border-radius: 3px; }
.hud-job.is-idle .hud-job__icon { --icon-color: var(--c-cyan); }
.hud-job.is-idle .hud-job__bar { display: none; }
.hud-job.is-idle .hud-job__label { display: flex; }
.hud-job.is-idle .hud-job__time { display: none; }

.hud-dispatch.is-hidden { display: none; }
.hud-dispatch__icon { width: 30px; height: 30px; margin-right: var(--s-2); --icon-color: var(--c-amber); }
.hud-dispatch--red .hud-dispatch__icon { --icon-color: var(--c-red); }
.hud-dispatch__pip { display: none; }
.hud-dispatch__title { display: none; }
.hud-dispatch__time { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-xs); color: var(--c-white); }

.hud-report.is-hidden { display: none; }
.hud-report__icon { width: 30px; height: 30px; margin-right: var(--s-2); --icon-color: var(--c-phosphor); }
.hud-report__label { display: none; }
.hud-report__new { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-micro); letter-spacing: var(--ls-label); color: var(--c-phosphor); }

.hud-raidrow { position: absolute; left: 0; right: 0; top: 180px; padding: var(--s-4); border-radius: var(--r-lg); border-left-width: 6px; border-color: var(--c-amber); background-color: var(--c-elev-2); }
.hud-raidrow.is-collapsed { display: none; }
.hud-raidrow.is-hidden { display: none; }
.hud-raidrow__info { margin-bottom: var(--s-3); }
.hud-raidrow__icon { width: 32px; height: 32px; margin-right: var(--s-2); --icon-color: var(--c-amber); }
.hud-raidrow__text { -unity-font-definition: resource("Fonts/IBMPlexMono-Medium"); font-size: var(--fs-micro); color: var(--c-amber); flex-shrink: 1; white-space: normal; }
.hud-raidrow__btn { flex-grow: 1; flex-basis: 0; min-height: 88px; }
.hud-raidrow__now { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-nano); letter-spacing: var(--ls-label); color: var(--c-text-dim); margin-bottom: var(--s-3); }
.hud-raidrow__plan { padding: var(--s-2) var(--s-2) var(--s-2) var(--s-3); margin-bottom: var(--s-3); border-radius: var(--r-lg); background-color: var(--c-cyan-wash); }
.hud-raidrow__plan-icon { width: 34px; height: 34px; margin-right: var(--s-3); --icon-color: var(--c-cyan); }
.hud-raidrow__plan-body { flex-grow: 1; flex-shrink: 1; }
.hud-raidrow__plan-key { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-nano); letter-spacing: var(--ls-label); color: var(--c-cyan-dim); }
.hud-raidrow__plan-value { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-xs); letter-spacing: var(--ls-tight); color: var(--c-cyan); }
.hud-raidrow__apply { min-height: 80px; min-width: 200px; }
.hud-raidrow__plan.is-set { background-color: var(--c-phosphor-wash); }
.hud-raidrow__plan.is-set .hud-raidrow__plan-value { color: var(--c-phosphor); }
.hud-raidrow__plan.is-set .hud-raidrow__plan-icon { --icon-color: var(--c-phosphor); }
.hud-raidrow__cmd { margin-right: var(--s-3); }
.hud-raidrow__cmd.is-hidden { display: none; }
.hud-raidrow__cmd.is-on { background-color: var(--c-phosphor-wash); }

.hud-screen { flex-grow: 1; }

.hud-guide {
    flex-direction: row;
    align-items: center;
    margin: 0 var(--s-5) var(--s-2) var(--s-5);
    padding: var(--s-2) var(--s-2) var(--s-2) var(--s-4);
    border-width: 1px;
    border-left-width: 4px;
    border-color: var(--c-amber-dim);
    border-left-color: var(--c-amber);
    background-color: rgba(20, 16, 8, 0.88);
}
.hud-guide.is-hidden { display: none; }
.hud-guide__pip { width: 14px; height: 14px; margin-right: var(--s-3); background-color: var(--c-amber); rotate: 45deg; }
.hud-guide__body { flex-grow: 1; flex-shrink: 1; }
.hud-guide__title { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-micro); letter-spacing: var(--ls-label); color: var(--c-amber); }
.hud-guide__reason { font-size: var(--fs-micro); color: var(--c-text); white-space: normal; margin-top: 2px; }
.hud-guide__close { width: 88px; height: 88px; align-items: center; justify-content: center; }
.hud-guide__x { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-sm); color: var(--c-text-dim); }

/* A control the guide points at */
.is-guide { border-color: var(--c-amber); border-width: 3px; }

/* ---------- Floating dock: AI voice over the command bar ---------- */
.hud-dock { margin: 0 var(--s-3) var(--s-3) var(--s-3); padding: var(--s-2); border-radius: var(--r-xl); border-top-width: 1px; border-color: var(--c-cyan-line); background-color: var(--c-elev-1); --sheen-color: var(--c-cyan-wash); }
.hud-dock { --sheen-reach: 0.4; }

.hud-advisor { flex-direction: row; align-items: center; padding: var(--s-1) var(--s-3) var(--s-2) var(--s-1); min-height: 112px; border-bottom-width: 1px; border-color: var(--c-line); --sheen-color: rgba(0, 0, 0, 0); }
.hud-advisor__orb { width: 96px; height: 96px; margin-right: var(--s-3); flex-shrink: 0; }
.hud-advisor__body { flex-grow: 1; flex-shrink: 1; }
.hud-advisor__meta { margin-bottom: 2px; }
.hud-advisor__who { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-nano); letter-spacing: var(--ls-label); color: var(--c-cyan); }
.hud-advisor__mood { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-nano); letter-spacing: var(--ls-label); color: var(--c-text-dim); margin-left: var(--s-3); }
.hud-advisor__wave { width: 120px; height: 22px; }
.hud-advisor__text { -unity-font-definition: resource("Fonts/ChakraPetch-Regular"); white-space: normal; font-size: var(--fs-xs); color: var(--c-white); }
.hud-advisor__chips { flex-wrap: wrap; margin-top: var(--s-1); }
.hud-advisor__chips.is-hidden { display: none; }
.hud-advisor__hint { position: absolute; right: 0; top: 4px; width: 24px; height: 24px; --icon-color: var(--c-cyan-dim); display: none; }
.hud-advisor { transition-property: min-height; transition-duration: 0.25s; }
.hud-advisor.is-compact { min-height: 64px; }
.hud-advisor.is-compact .hud-advisor__orb { width: 56px; height: 56px; }
.hud-advisor.is-compact .hud-advisor__meta { display: none; }
.hud-advisor.is-compact .hud-advisor__chips { display: none; }
.hud-advisor.is-compact .hud-advisor__text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--c-text-dim); padding-right: var(--s-6); }
.hud-advisor.is-compact .hud-advisor__hint { display: flex; }

.ai-orb { --ring-color: var(--c-cyan); --core-color: var(--c-cyan-glow); }
.ai-orb--amber { --ring-color: var(--c-amber); --core-color: var(--c-amber-glow); }
.ai-orb--red { --ring-color: var(--c-red); --core-color: var(--c-red-glow); }
.ai-wave { --wave-color: var(--c-cyan); }

.ai-chip { flex-direction: row; align-items: center; min-height: 64px; margin: var(--s-1) var(--s-2) 0 0; padding: 0 var(--s-4) 0 var(--s-3); border-radius: 32px; background-color: var(--c-cyan-wash); transition-property: scale, background-color; transition-duration: 0.12s; }
.ai-chip:active { scale: 0.95 0.95; background-color: var(--c-cyan-line); }
.ai-chip__icon { width: 28px; height: 28px; margin-right: var(--s-2); --icon-color: var(--c-cyan); }
.ai-chip__label { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-nano); letter-spacing: var(--ls-tight); color: var(--c-cyan); }
.ai-chip--urgent { background-color: var(--c-amber-wash); }
.ai-chip--urgent > .ai-chip__icon { --icon-color: var(--c-amber); }
.ai-chip--urgent > .ai-chip__label { color: var(--c-amber); }

/* command bar: icons with labels; the active tab is a lit pill and an indicator glides between tabs */
.hud-tabs { flex-direction: row; padding-top: var(--s-2); }
.hud-tabs__rail { position: absolute; top: 0; left: 0; width: 0; height: 3px; border-radius: 2px; background-color: var(--c-cyan); }
.hud-tab { flex-grow: 1; flex-basis: 0; align-items: center; justify-content: center; min-height: 104px; margin: 0 var(--s-1); border-radius: var(--r-lg); transition-property: background-color; transition-duration: 0.2s; }
.hud-tab__icon { width: 44px; height: 44px; margin-bottom: var(--s-1); --icon-color: var(--c-text-dim); }
.hud-tab__label { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-nano); letter-spacing: var(--ls-label); color: var(--c-text-dim); }
.hud-tab.is-active { background-color: var(--c-cyan-wash); }
.hud-tab.is-active > .hud-tab__label { color: var(--c-cyan); }
.hud-tab.is-active > .hud-tab__icon { --icon-color: var(--c-cyan); }
.hud-tab__dot { position: absolute; top: var(--s-2); right: var(--s-5); width: 14px; height: 14px; border-radius: 7px; background-color: var(--c-amber); }
.hud-tab__dot.is-hidden { display: none; }

/* Next goal (SPEC-043 s5): slim card above the dock; amber while building toward it, cyan when ready */
.hud-goal {
    flex-direction: row;
    align-items: center;
    margin: 0 var(--s-5) var(--s-2) var(--s-5);
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-lg);
    border-width: 1px;
    border-color: var(--c-amber-dim);
    border-left-width: 4px;
    border-left-color: var(--c-amber);
    background-color: rgba(14, 12, 8, 0.9);
}
.hud-goal.is-hidden { display: none; }
.hud-goal__well { width: 76px; height: 76px; border-radius: 38px; margin-right: var(--s-3); align-items: center; justify-content: center; background-color: var(--c-amber-wash); }
.hud-goal__icon { width: 44px; height: 44px; --icon-color: var(--c-amber); }
.hud-goal__body { flex-grow: 1; flex-shrink: 1; }
.hud-goal__title { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-micro); letter-spacing: var(--ls-label); color: var(--c-amber); }
.hud-goal__gates { flex-wrap: wrap; margin-top: 4px; }
.hud-goal__gate { align-items: center; margin-right: var(--s-3); }
.hud-goal__gate-icon { width: 26px; height: 26px; margin-right: 4px; --icon-color: var(--c-text-dim); }
.hud-goal__gate-label { font-size: var(--fs-nano); color: var(--c-text); }
.hud-goal__gate.is-met .hud-goal__gate-icon { --icon-color: var(--c-phosphor); }
.hud-goal__gate.is-met .hud-goal__gate-label { color: var(--c-phosphor); }
.hud-goal__bar { height: 8px; margin-top: var(--s-1); }
.hud-goal__chev { width: 36px; height: 36px; margin-left: var(--s-2); --icon-color: var(--c-amber); }
.hud-goal.is-ready { border-color: var(--c-cyan); background-color: rgba(6, 22, 26, 0.92); }
.hud-goal.is-ready .hud-goal__bar > .ds-progress__fill { background-color: var(--c-cyan-dim); border-color: var(--c-cyan); }
.hud-goal.is-ready .hud-goal__title { color: var(--c-cyan); }
.hud-goal.is-ready .hud-goal__well { background-color: var(--c-cyan-wash); }
.hud-goal.is-ready .hud-goal__icon, .hud-goal.is-ready .hud-goal__chev { --icon-color: var(--c-cyan); }

/* Celebration banner (SPEC-043 s5): full width under the context strip; ignores the pointer */
.celeb { position: absolute; left: 0; right: 0; top: 330px; align-items: center; }
.celeb.is-hidden { display: none; }
.celeb__band {
    flex-direction: row;
    align-items: center;
    width: 100%;
    padding: var(--s-4) var(--s-8);
    overflow: hidden;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: var(--c-amber);
    background-color: rgba(20, 16, 8, 0.92);
}
.celeb__ray { position: absolute; top: 0; bottom: 0; left: -30%; width: 30%; background-color: rgba(255, 255, 255, 0.08); rotate: 12deg; opacity: 0; }
.celeb__well { width: 132px; height: 132px; border-radius: 66px; margin-right: var(--s-6); align-items: center; justify-content: center; border-width: 3px; border-color: var(--c-amber); background-color: var(--c-amber-wash); }
.celeb__icon { width: 76px; height: 76px; --icon-color: var(--c-amber); }
.celeb__body { flex-grow: 1; flex-shrink: 1; }
.celeb__kicker { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-nano); letter-spacing: var(--ls-wide); color: var(--c-amber); }
.celeb__title { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-lg); letter-spacing: var(--ls-tight); color: var(--c-white); white-space: normal; }
.celeb__line { font-size: var(--fs-micro); color: var(--c-text); white-space: normal; margin-top: 2px; }
.celeb--module .celeb__band { border-color: var(--c-violet); background-color: rgba(16, 12, 30, 0.92); }
.celeb--module .celeb__well { border-color: var(--c-violet); background-color: var(--c-violet-wash); }
.celeb--module .celeb__icon { --icon-color: var(--c-violet); }
.celeb--module .celeb__kicker { color: var(--c-violet); }
.celeb--win .celeb__band, .celeb--max .celeb__band { border-color: var(--c-cyan); background-color: rgba(6, 22, 26, 0.92); }
.celeb--win .celeb__well, .celeb--max .celeb__well { border-color: var(--c-cyan); background-color: var(--c-cyan-wash); }
.celeb--win .celeb__icon, .celeb--max .celeb__icon { --icon-color: var(--c-cyan); }
.celeb--win .celeb__kicker, .celeb--max .celeb__kicker { color: var(--c-cyan); }
