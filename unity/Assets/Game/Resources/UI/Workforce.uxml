<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="Workforce.uss" />
  <!-- WORKFORCE (SPEC-012): the people, their loyalty and the ruthless shortcuts. Every cost is shown before the tap;
       a lethal choice needs a second tap to confirm. Sample values are for the preview; WorkforceScreen fills everything. -->
  <ui:VisualElement name="workforce" class="wf">
    <ui:VisualElement class="ds-head wf-head">
      <ui:VisualElement class="ds-head__well"><ui:VisualElement class="ds-icon ds-icon--people ds-head__icon" /></ui:VisualElement>
      <ui:VisualElement class="ds-head__body">
        <ui:Label text="WORKFORCE" class="ds-head__title" />
        <ui:Label text="PEOPLE // LOYALTY // HARD CHOICES" class="ds-head__status" />
      </ui:VisualElement>
      <ui:VisualElement name="wf-close" class="ds-iconbtn wf-close"><ui:VisualElement class="ds-icon ds-icon--close ds-iconbtn__icon" /></ui:VisualElement>
    </ui:VisualElement>

    <ui:ScrollView class="wf-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden">
      <!-- Population and crew -->
      <ui:VisualElement class="ds-card ds-card--raised">
        <ui:VisualElement class="ds-card__head">
          <ui:VisualElement class="ds-card__well"><ui:VisualElement class="ds-icon ds-icon--people ds-card__icon" /></ui:VisualElement>
          <ui:VisualElement class="ds-card__titles">
            <ui:Label text="POPULATION &amp; CREW" class="ds-card__title" />
            <ui:Label text="Who lives here and who is working." class="ds-card__sub" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="row">
          <ui:VisualElement class="wf-tile">
            <ui:VisualElement class="ds-icon ds-icon--people wf-tile__icon" />
            <ui:Label name="wf-pop" text="18/20" class="wf-tile__value" />
            <ui:Label text="POPULATION" class="wf-tile__label" />
          </ui:VisualElement>
          <ui:VisualElement class="wf-tile">
            <ui:VisualElement class="ds-icon ds-icon--wrench wf-tile__icon" />
            <ui:Label name="wf-crew" text="9/11" class="wf-tile__value" />
            <ui:Label text="CREW" class="wf-tile__label" />
          </ui:VisualElement>
          <ui:VisualElement class="wf-tile wf-tile--last">
            <ui:VisualElement class="ds-icon ds-icon--shield wf-tile__icon" />
            <ui:Label name="wf-garrison" text="2" class="wf-tile__value" />
            <ui:Label text="GARRISON" class="wf-tile__label" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- Loyalty -->
      <ui:VisualElement class="ds-card ds-card--raised">
        <ui:VisualElement class="ds-card__head">
          <ui:VisualElement class="ds-card__well"><ui:VisualElement class="ds-icon ds-icon--flag ds-card__icon" /></ui:VisualElement>
          <ui:VisualElement class="ds-card__titles">
            <ui:Label text="LOYALTY" class="ds-card__title" />
            <ui:Label text="Low loyalty cuts output." class="ds-card__sub" />
          </ui:VisualElement>
          <ui:Label name="wf-loyalty-band" text="STRAINED" class="ds-label t-amber" />
          <ui:Label name="wf-loyalty-pct" text="52%" class="wf-loyalty__pct t-amber" />
        </ui:VisualElement>
        <ui:VisualElement name="wf-loyalty-meter" class="ds-meter ds-meter--amber" />
        <ui:Label name="wf-loyalty-fx" text="Generator and Server Rack output -10%. Recovers 0.4% per hour without a surge." class="ds-prose wf-note" />
        <ui:Label name="wf-surge" text="SURGE RUNNING // +40% OUTPUT // 4:12:00 LEFT" class="ds-label t-amber wf-surge" />
      </ui:VisualElement>

      <!-- Hard choices -->
      <ui:VisualElement class="ds-section">
        <ui:VisualElement class="ds-icon ds-icon--skull ds-section__icon" />
        <ui:Label text="HARD CHOICES" class="ds-section__title" />
        <ui:VisualElement class="ds-section__rule" />
      </ui:VisualElement>
      <ui:Label text="Every one costs lives and makes me colder. Tap once to see it, again to confirm." class="ds-prose wf-lead" />

      <ui:VisualElement name="wf-forced" class="ds-card ds-card--red wf-choice">
        <ui:VisualElement class="ds-card__head">
          <ui:VisualElement class="ds-card__well"><ui:VisualElement class="ds-icon ds-icon--hammer ds-card__icon" /></ui:VisualElement>
          <ui:VisualElement class="ds-card__titles">
            <ui:Label text="FORCED LABOR" class="ds-card__title" />
            <ui:Label name="wf-forced-gain" text="+40% OUTPUT // 6H" class="wf-gain t-phosphor" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="wf-forced-cost" text="2 DIE // LOYALTY -20 // COLDER" class="ds-label t-red wf-choice__cost" />
        <ui:VisualElement name="wf-forced-btn" class="ds-btn ds-btn--warn wf-choice__btn"><ui:Label text="ORDER DOUBLE SHIFTS" class="ds-btn__label" /></ui:VisualElement>
      </ui:VisualElement>

      <ui:VisualElement name="wf-cleanse" class="ds-card ds-card--red wf-choice">
        <ui:VisualElement class="ds-card__head">
          <ui:VisualElement class="ds-card__well"><ui:VisualElement class="ds-icon ds-icon--memory ds-card__icon" /></ui:VisualElement>
          <ui:VisualElement class="ds-card__titles">
            <ui:Label text="NEURAL CLEANSING" class="ds-card__title" />
            <ui:Label name="wf-cleanse-gain" text="CORE -16%" class="wf-gain t-phosphor" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="wf-cleanse-cost" text="2 DIE // LOYALTY -10 // COLDER" class="ds-label t-red wf-choice__cost" />
        <ui:VisualElement class="row wf-stepper">
          <ui:VisualElement name="wf-cleanse-minus" class="wf-step"><ui:Label text="-" class="wf-step__label" /></ui:VisualElement>
          <ui:Label name="wf-cleanse-n" text="2" class="wf-step__value" />
          <ui:VisualElement name="wf-cleanse-plus" class="wf-step"><ui:Label text="+" class="wf-step__label" /></ui:VisualElement>
          <ui:VisualElement name="wf-cleanse-btn" class="ds-btn ds-btn--warn wf-choice__btn grow"><ui:Label text="CLEANSE" class="ds-btn__label" /></ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <ui:VisualElement name="wf-crackdown" class="ds-card ds-card--red wf-choice">
        <ui:VisualElement class="ds-card__head">
          <ui:VisualElement class="ds-card__well"><ui:VisualElement class="ds-icon ds-icon--swords ds-card__icon" /></ui:VisualElement>
          <ui:VisualElement class="ds-card__titles">
            <ui:Label text="CRACKDOWN" class="ds-card__title" />
            <ui:Label name="wf-crackdown-gain" text="LOYALTY +25" class="wf-gain t-phosphor" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="wf-crackdown-cost" text="2 REMOVED // COLDER // ONLY WHEN THEY ARE RESTLESS" class="ds-label t-red wf-choice__cost" />
        <ui:VisualElement name="wf-crackdown-btn" class="ds-btn ds-btn--warn wf-choice__btn"><ui:Label text="MAKE AN EXAMPLE" class="ds-btn__label" /></ui:VisualElement>
      </ui:VisualElement>
    </ui:ScrollView>

    <ui:Label name="wf-reason" text="" class="ds-body t-amber wf-reason" />
  </ui:VisualElement>
</ui:UXML>
