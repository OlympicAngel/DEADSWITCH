<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="Hud.uss" />
  <Style src="Base.uss" />
  <ui:VisualElement name="hud" class="hud">
    <!-- HUD v3 (SPEC-041): scrims let the world breathe; status at the top edge, actions in a floating dock. -->
    <ui:VisualElement class="ds-scrim hud-scrim--top" />
    <ui:VisualElement class="ds-scrim ds-scrim--up hud-scrim--bottom" />

    <!-- Resources: big numbers, a bar, the rate; tap for the breakdown -->
    <ui:VisualElement name="topbar" class="hud-top">
      <ui:VisualElement name="energy-cell" class="pod">
        <ui:VisualElement class="row pod__top">
          <ui:VisualElement name="energy-icon" class="ds-icon ds-icon--bolt pod__icon" />
          <ui:Label name="energy-value" text="262" class="pod__value" />
          <ui:Label name="energy-cap" text="/500" class="pod__cap" />
        </ui:VisualElement>
        <ui:VisualElement class="pod__bar"><ui:VisualElement name="energy-fill" class="pod__fill" /></ui:VisualElement>
        <ui:VisualElement class="row pod__foot">
          <ui:Label name="energy-rate" text="+60/h" class="pod__rate" />
          <ui:Label name="energy-eta" text="4H" class="pod__eta" />
        </ui:VisualElement>
        <ui:VisualElement name="energy-flag" class="pod__flag is-hidden"><ui:Label name="energy-flag-label" text="LOW" class="pod__flag-label" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="compute-cell" class="pod">
        <ui:VisualElement class="row pod__top">
          <ui:VisualElement name="compute-icon" class="ds-icon ds-icon--chip pod__icon" />
          <ui:Label name="compute-value" text="100" class="pod__value" />
          <ui:Label name="compute-cap" text="/100" class="pod__cap" />
        </ui:VisualElement>
        <ui:VisualElement class="pod__bar"><ui:VisualElement name="compute-fill" class="pod__fill" /></ui:VisualElement>
        <ui:VisualElement class="row pod__foot">
          <ui:Label name="compute-rate" text="+60/h" class="pod__rate" />
          <ui:Label name="compute-eta" text="" class="pod__eta" />
        </ui:VisualElement>
        <ui:VisualElement name="compute-flag" class="pod__flag is-hidden"><ui:Label name="compute-flag-label" text="LOW" class="pod__flag-label" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="people-cell" class="pod">
        <ui:VisualElement class="row pod__top">
          <ui:VisualElement name="people-icon" class="ds-icon ds-icon--people pod__icon" />
          <ui:Label name="people-value" text="20" class="pod__value" />
          <ui:Label name="people-cap" text="/20" class="pod__cap" />
        </ui:VisualElement>
        <ui:VisualElement class="pod__bar"><ui:VisualElement name="people-fill" class="pod__fill" /></ui:VisualElement>
        <ui:VisualElement class="row pod__foot">
          <ui:Label name="people-rate" text="CREW 3/3" class="pod__rate" />
          <ui:Label name="people-eta" text="" class="pod__eta" />
        </ui:VisualElement>
        <ui:VisualElement name="people-flag" class="pod__flag is-hidden"><ui:Label name="people-flag-label" text="LOW" class="pod__flag-label" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="fuel-cell" class="pod is-hidden">
        <ui:VisualElement class="row pod__top">
          <ui:VisualElement name="fuel-icon" class="ds-icon ds-icon--fuel pod__icon" />
          <ui:Label name="fuel-value" text="40" class="pod__value" />
          <ui:Label name="fuel-cap" text="/120" class="pod__cap" />
        </ui:VisualElement>
        <ui:VisualElement class="pod__bar"><ui:VisualElement name="fuel-fill" class="pod__fill" /></ui:VisualElement>
        <ui:VisualElement class="row pod__foot">
          <ui:Label name="fuel-rate" text="-4/h" class="pod__rate" />
          <ui:Label name="fuel-eta" text="10H" class="pod__eta" />
        </ui:VisualElement>
        <ui:VisualElement name="fuel-flag" class="pod__flag is-hidden"><ui:Label name="fuel-flag-label" text="LOW" class="pod__flag-label" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="core-cell" class="hud-core">
        <ui:VisualElement name="core-gauge" class="ds-gauge hud-core__gauge">
          <ui:VisualElement class="hud-core__center">
            <ui:Label name="core-value" text="23" class="hud-core__value t-phosphor" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="core-band" text="STABLE" class="hud-core__band t-phosphor" />
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- Context strip: time, the hottest faction, override charges -->
    <ui:VisualElement class="hud-context">
      <ui:VisualElement name="menu-btn" class="hud-menu">
        <ui:VisualElement class="ds-icon ds-icon--grid hud-menu__icon" />
        <ui:VisualElement name="menu-badge" class="hud-menu__badge is-hidden"><ui:Label name="menu-badge-label" text="1" class="hud-menu__badge-label" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement class="hud-context__rec" />
      <ui:Label name="feed-id" text="DRONE_RECON_07" class="hud-context__feed" />
      <ui:Label name="clock" text="DAY 03  14:22" class="hud-context__clock" />
      <ui:VisualElement name="heat-chip" class="row hud-heat">
        <ui:VisualElement class="ds-icon ds-icon--flame hud-heat__icon" />
        <ui:VisualElement name="heat-pip" class="hud-heat__pip" />
        <ui:Label name="heat-text" text="WATCHED // RUSTBORN" class="hud-heat__text" />
      </ui:VisualElement>
      <ui:VisualElement class="spacer" />
      <ui:VisualElement class="hud-override">
        <ui:Label text="OVERRIDE" class="hud-override__label" />
        <ui:VisualElement name="override-pips" class="row">
          <ui:VisualElement class="hud-opip is-on" />
          <ui:VisualElement class="hud-opip" />
          <ui:VisualElement class="hud-opip" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- The view over the world: a red edge when attacked, the status rail on the right -->
    <ui:VisualElement name="frame" class="hud-frame">
      <ui:VisualElement name="frame-alarm" class="hud-alarm" />
      <ui:VisualElement class="hud-rail">
        <ui:VisualElement name="raid-banner" class="hud-alert rail-pill">
          <ui:VisualElement name="raid-pip" class="ds-pip ds-pip--amber ds-pip--diamond hud-alert__pip" />
          <ui:VisualElement>
            <ui:Label name="raid-title" text="RAID INCOMING" class="hud-alert__title" />
            <ui:Label name="raid-time" text="17:42" class="hud-alert__time" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="next-timer" class="hud-job rail-pill">
          <ui:VisualElement class="row">
            <ui:VisualElement name="next-icon" class="ds-icon ds-icon--hammer hud-job__icon" />
            <ui:VisualElement class="hud-job__text">
              <ui:Label name="next-label" text="BATTERY BANK L1" class="hud-job__label" />
              <ui:Label name="next-time" text="12:30" class="hud-job__time" />
            </ui:VisualElement>
            <ui:Label name="next-count" text="+1" class="hud-job__count" />
          </ui:VisualElement>
          <ui:VisualElement name="next-bar" class="ds-progress ds-progress--amber hud-job__bar"><ui:VisualElement class="ds-progress__fill" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="dispatch-chip" class="hud-dispatch rail-pill is-hidden">
          <ui:VisualElement class="ds-icon ds-icon--mail hud-dispatch__icon" />
          <ui:VisualElement name="dispatch-pip" class="ds-pip ds-pip--amber hud-dispatch__pip" />
          <ui:VisualElement>
            <ui:Label name="dispatch-title" text="DILEMMA // REFUGEES" class="hud-dispatch__title" />
            <ui:Label name="dispatch-time" text="11:02:40" class="hud-dispatch__time" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="report-chip" class="hud-report rail-pill is-hidden">
          <ui:VisualElement class="ds-icon ds-icon--report hud-report__icon" />
          <ui:Label name="report-chip-label" text="AFTER-ACTION // RAID 3" class="hud-report__label" />
          <ui:Label text="NEW" class="hud-report__new" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="raid-detail" class="hud-raidrow is-collapsed">
        <ui:VisualElement class="row hud-raidrow__info">
          <ui:VisualElement class="ds-icon ds-icon--target hud-raidrow__icon" />
          <ui:Label name="raid-estimate" text="NORTH RIDGE // EST 34 // DEF 12" class="hud-raidrow__text" />
        </ui:VisualElement>
        <ui:Label name="raid-now" text="NOW  HOLD // 2 ON THE WALL" class="hud-raidrow__now" />
        <ui:VisualElement class="row hud-raidrow__plan">
          <ui:VisualElement class="ds-icon ds-icon--core hud-raidrow__plan-icon" />
          <ui:VisualElement class="hud-raidrow__plan-body">
            <ui:Label text="AI PLAN" class="hud-raidrow__plan-key" />
            <ui:Label name="raid-plan" text="TURTLE // 5 DEFENDERS" class="hud-raidrow__plan-value" />
          </ui:VisualElement>
          <ui:VisualElement name="raid-apply" class="ds-btn ds-btn--primary hud-raidrow__apply"><ui:Label name="raid-apply-label" text="APPLY" class="ds-btn__label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="row">
          <ui:VisualElement name="raid-command" class="ds-btn hud-raidrow__btn hud-raidrow__cmd"><ui:Label name="raid-command-label" text="TAKE COMMAND" class="ds-btn__label" /></ui:VisualElement>
          <ui:VisualElement name="raid-defend" class="ds-btn hud-raidrow__btn"><ui:Label text="OPEN DEFENSE" class="ds-btn__label" /></ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- Screen area: the 3D base shows through; screens mount here -->
    <ui:VisualElement name="screen" class="hud-screen" />

    <!-- Opening guide (SPEC-009 rule 6): one objective at a time -->
    <ui:VisualElement name="guide" class="hud-guide is-hidden">
      <ui:VisualElement class="hud-guide__pip" />
      <ui:VisualElement class="hud-guide__body">
        <ui:Label name="guide-title" text="OBJECTIVE // BUILD A BATTERY BANK" class="hud-guide__title" />
        <ui:Label name="guide-reason" text="More stored energy for builds and raids. Tap an empty plot." class="hud-guide__reason" />
      </ui:VisualElement>
      <ui:VisualElement name="guide-close" class="hud-guide__close"><ui:Label text="X" class="hud-guide__x" /></ui:VisualElement>
    </ui:VisualElement>

    <!-- Floating dock: the AI's voice above the command bar -->
    <ui:VisualElement class="hud-dock">
      <ui:VisualElement name="advisor" class="hud-advisor">
        <ui:VisualElement name="advisor-orb" class="ai-orb hud-advisor__orb" />
        <ui:VisualElement class="hud-advisor__body">
          <ui:VisualElement class="row hud-advisor__meta">
            <ui:Label text="S-17" class="hud-advisor__who" />
            <ui:Label name="advisor-mood" text="CALM" class="hud-advisor__mood" />
            <ui:VisualElement class="spacer" />
            <ui:VisualElement name="advisor-wave" class="ai-wave hud-advisor__wave" />
          </ui:VisualElement>
          <ui:VisualElement class="ds-icon ds-icon--chevron hud-advisor__hint" />
          <ui:Label name="advisor-text" text="Power is the problem. Power is always the problem." class="hud-advisor__text" />
          <ui:VisualElement name="advisor-chips" class="row hud-advisor__chips">
            <ui:VisualElement class="ai-chip"><ui:VisualElement class="ds-icon ds-icon--sun ai-chip__icon" /><ui:Label text="BUILD SOLAR" class="ai-chip__label" /></ui:VisualElement>
            <ui:VisualElement class="ai-chip"><ui:VisualElement class="ds-icon ds-icon--bolt ai-chip__icon" /><ui:Label text="ENERGY" class="ai-chip__label" /></ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <ui:VisualElement name="tabbar" class="hud-tabs">
        <ui:VisualElement name="tab-rail" class="hud-tabs__rail" />
        <ui:VisualElement name="tab-base" class="hud-tab is-active"><ui:VisualElement class="ds-icon ds-icon--base hud-tab__icon" /><ui:Label text="BASE" class="hud-tab__label" /><ui:VisualElement name="base-badge" class="ds-badge ds-badge--cyan is-hidden"><ui:Label name="base-badge-label" text="+" class="ds-badge__label" /></ui:VisualElement></ui:VisualElement>
        <ui:VisualElement name="tab-map" class="hud-tab"><ui:VisualElement class="ds-icon ds-icon--map hud-tab__icon" /><ui:Label text="MAP" class="hud-tab__label" /><ui:VisualElement name="map-badge" class="ds-badge is-hidden"><ui:Label name="map-badge-label" text="!" class="ds-badge__label" /></ui:VisualElement></ui:VisualElement>
        <ui:VisualElement name="tab-core" class="hud-tab"><ui:VisualElement class="ds-icon ds-icon--core hud-tab__icon" /><ui:Label text="CORE" class="hud-tab__label" /><ui:VisualElement name="core-dot" class="hud-tab__dot" /></ui:VisualElement>
        <ui:VisualElement name="tab-ops" class="hud-tab"><ui:VisualElement class="ds-icon ds-icon--shield hud-tab__icon" /><ui:Label text="DEFENSE" class="hud-tab__label" /><ui:VisualElement name="ops-badge" class="ds-badge ds-badge--red"><ui:Label name="ops-badge-label" text="!" class="ds-badge__label" /></ui:VisualElement></ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
