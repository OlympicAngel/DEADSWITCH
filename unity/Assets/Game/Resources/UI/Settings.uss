/* SETTINGS (F-024, SPEC-039/041). Tokens only. Header, then grouped icon cards; no outlined boxes. */

.set { flex-grow: 1; background-color: var(--c-world); }
.set-scroll { padding: var(--s-4) var(--s-5) var(--s-2) var(--s-5); }

.set-subhead { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-micro); letter-spacing: var(--ls-wide); color: var(--c-text-dim); margin-top: var(--s-3); margin-bottom: var(--s-2); }
.set-note { margin-top: 2px; }
.set-note--pad { margin-top: var(--s-2); margin-bottom: var(--s-2); }

.set-seg__label { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-xs); letter-spacing: var(--ls-label); }
/* five theme names share one track: a step smaller so VERDIGRIS and PHOSPHOR fit their cells */
#seg-theme .set-seg__label { font-size: var(--fs-nano); letter-spacing: 0; }

.set-row { margin-top: var(--s-1); }
.set-row__well { width: 56px; height: 56px; align-items: center; justify-content: center; margin-right: var(--s-3); border-width: 0; border-radius: var(--r-md); background-color: var(--c-cyan-wash); }
.set-row__icon { width: 34px; height: 34px; --icon-color: var(--c-cyan); }
.set-row__text { flex-shrink: 1; }
.set-row__title { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-xs); letter-spacing: var(--ls-label); color: var(--c-text); }

.set-toggle { margin-left: var(--s-3); }

.set-btnrow { margin-top: var(--s-3); }
.set-btn { margin-top: var(--s-2); }
.set-btnrow > .set-btn { margin-top: 0; }
.set-gap { margin-left: var(--s-2); }
.set-dev.is-hidden { display: none; }
.set-about { margin-top: var(--s-4); margin-bottom: var(--s-4); font-size: var(--fs-micro); white-space: normal; }

/* ScrollView content must not squeeze its children */
.set-scroll .ds-card, .set-scroll .set-row, .set-scroll .set-seg, .set-scroll .ds-btn, .set-scroll .set-btnrow, .set-scroll .set-subhead, .set-scroll .set-note, .set-scroll .set-about { flex-shrink: 0; }
