/* SETTINGS (F-024). Tokens only. */

.set { flex-grow: 1; padding: var(--s-4) var(--s-6) var(--s-2) var(--s-6); background-color: var(--c-world); }
.set-head { align-items: center; margin-bottom: var(--s-2); }
.set-close { width: var(--touch); height: var(--touch); align-items: center; justify-content: center; border-width: 1px; border-color: var(--c-line-mid); }
.set-close__x { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-md); color: var(--c-text-dim); }
.set-section { margin-top: var(--s-5); margin-bottom: var(--s-2); }
.set-note { font-size: var(--fs-micro); margin-top: var(--s-1); }

.set-seg { flex-direction: row; border-width: var(--bw); border-color: var(--c-line-mid); }
.set-seg__item { flex-grow: 1; flex-basis: 0; min-height: var(--touch); align-items: center; justify-content: center; border-right-width: 1px; border-color: var(--c-line-mid); }
.set-seg__item.is-last { border-right-width: 0; }
.set-seg__item.is-selected { background-color: rgba(168, 213, 138, 0.14); }
.set-seg__label { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-xs); letter-spacing: 2px; color: var(--c-text-dim); }
.set-seg__item.is-selected > .set-seg__label { color: var(--c-phosphor); }

.set-row { flex-direction: row; align-items: center; margin-top: var(--s-5); }
.set-toggle { width: 180px; min-height: var(--touch); margin-left: var(--s-4); align-items: center; justify-content: center; border-width: var(--bw); border-color: var(--c-line-mid); }
.set-toggle.is-on { border-color: var(--c-phosphor); background-color: rgba(168, 213, 138, 0.14); }
.set-toggle__label { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-xs); letter-spacing: 3px; color: var(--c-text-dim); }
.set-toggle.is-on > .set-toggle__label { color: var(--c-phosphor); }

.set-btn { margin-top: var(--s-6); }
.set-dev.is-hidden { display: none; }
.set-about { margin-top: var(--s-6); font-size: var(--fs-micro); }

/* cloud backup row (doc 10 s2) */
.set-gap { margin-left: var(--s-2); }
