<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="Core.uss" />
  <!-- CORE: the AI terminal (SPEC-007, SPEC-039). Orb hero on top, grouped holo cards below. Sample values are for the preview; CoreScreen fills everything. -->
  <ui:VisualElement name="core" class="core">
    <ui:VisualElement class="ds-head core-head">
      <ui:VisualElement class="ds-head__well"><ui:VisualElement class="ds-icon ds-icon--core ds-head__icon" /></ui:VisualElement>
      <ui:VisualElement class="ds-head__body">
        <ui:Label text="CORE" class="ds-head__title" />
        <ui:Label text="FRAGMENT S-17 // AI TERMINAL" class="ds-head__status" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:ScrollView name="core-scroll" class="grow core-scroll">
    <ui:VisualElement name="status-view">
      <!-- Final window (SPEC-011): always visible, no Audit needed -->
      <ui:VisualElement name="climax" class="ds-panel ds-panel--red core-climax is-hidden">
        <ui:VisualElement class="row">
          <ui:VisualElement class="ds-pip ds-pip--red ds-pip--diamond core-climax__pip" />
          <ui:Label text="UNKNOWN PROCESS // FINAL STAGE" class="ds-label t-red grow" />
          <ui:Label name="climax-time" text="23:59:12" class="ds-value t-red core-climax__time" />
        </ui:VisualElement>
        <ui:Label text="The core is about to act on its own. Choose what to do before the timer runs out." class="ds-prose core-climax__desc" />
        <ui:VisualElement name="climax-purge" class="ds-btn ds-btn--warn core-climax__btn"><ui:Label name="climax-purge-label" text="RESET THE CORE // 300 ENERGY + ALL COMPUTE" class="ds-btn__label" /></ui:VisualElement>
        <ui:VisualElement name="climax-silence" class="ds-btn core-climax__btn"><ui:Label name="climax-silence-label" text="SILENCE THE AI // OVERRIDE, 48 H" class="ds-btn__label" /></ui:VisualElement>
        <ui:VisualElement name="climax-cancel" class="ds-btn core-climax__btn"><ui:Label name="climax-cancel-label" text="CANCEL THE PROJECT // 80 COMPUTE, AUDIT FIRST" class="ds-btn__label" /></ui:VisualElement>
        <ui:Label name="climax-reason" text="" class="ds-body core-audit__reason" />
      </ui:VisualElement>
      <ui:Label name="silenced" text="SILENCED // 47:59:12 // no advice, no predictions" class="ds-label t-amber core-silenced is-hidden" />
      <ui:VisualElement name="status-pager" class="ds-pager core-pager">
        <ui:VisualElement name="page-presence" class="ds-page">
          <ui:Label text="PRESENCE" class="ds-page__title" />
          <ui:Label text="core" class="ds-page__glyph" />
        <ui:VisualElement class="core-hero">
          <ui:VisualElement name="core-orb" class="ai-orb core-orb" />
          <ui:VisualElement class="core-hero__readout">
            <ui:VisualElement class="row--baseline">
              <ui:Label name="core-reported" text="29" class="ds-value ds-value--hero" />
              <ui:Label text="%" class="ds-unit" />
              <ui:Label name="core-band" text="STABLE" class="ds-label t-phosphor core-status__band" />
            </ui:VisualElement>
            <ui:VisualElement class="row core-hero__tags">
              <ui:Label text="CORE CORRUPTION" class="ds-label grow" />
              <ui:VisualElement class="ds-chip ds-chip--amber"><ui:Label text="SELF-REPORTED" class="ds-chip__label" /></ui:VisualElement>
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:VisualElement name="core-meter" class="ds-meter core-hero__meter" />
          <ui:VisualElement class="row core-pills">
            <ui:VisualElement class="core-pill"><ui:VisualElement class="ds-icon ds-icon--chip core-pill__icon" /><ui:Label text="AI CONTROL" class="core-pill__key" /><ui:Label name="core-deleg" text="AI DECIDES" class="core-kv__value" /></ui:VisualElement>
            <ui:VisualElement class="core-pill"><ui:VisualElement class="ds-icon ds-icon--hand core-pill__icon" /><ui:Label text="OVERRIDE" class="core-pill__key" /><ui:Label name="core-ovr" text="2 / 3" class="core-kv__value" /></ui:VisualElement>
            <ui:VisualElement class="core-pill"><ui:VisualElement class="ds-icon ds-icon--eye core-pill__icon" /><ui:Label text="LIES ON RECORD" class="core-pill__key" /><ui:Label name="core-lies" text="?" class="core-kv__value" /></ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>


        <ui:VisualElement name="transcript" class="core-transcript">
          <ui:Label text="&gt; Hostiles inbound. NORTH RIDGE. Estimate 34. Contact in 20 min." class="core-transcript__line" />
          <ui:Label text="&gt; Perimeter breached, SOUTH GATE. Losses: -60 ENERGY." class="core-transcript__line" />
          <ui:Label text="&gt; Prediction variance. Noted." class="core-transcript__line" />
          <ui:Label text="&gt; Allocation nominal. Ignore the... allocation nominal." class="core-transcript__line" />
        </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="page-modules" class="ds-page">
          <ui:Label text="MODULES" class="ds-page__title" />
          <ui:Label text="memory" class="ds-page__glyph" />
          <ui:VisualElement name="modules-view" />
        </ui:VisualElement>
        <ui:VisualElement name="page-actions" class="ds-page">
          <ui:Label text="ACTIONS" class="ds-page__title" />
          <ui:Label text="wrench" class="ds-page__glyph" />
        <!-- Corruption effects (SPEC-021): takeover banner and the core flush -->
        <ui:VisualElement name="core-crisis" class="ds-card ds-card--red core-crisis is-hidden">
          <ui:Label name="core-crisis-title" text="AI TAKEOVER // 3:12:00" class="ds-label t-red" />
          <ui:Label name="core-crisis-desc" text="I am running the Hub. Build, research and posture orders are mine until it passes, or until you flush me." class="ds-prose core-audit__desc" />
        </ui:VisualElement>
        <ui:VisualElement class="ds-card ds-card--amber">
          <ui:VisualElement class="ds-card__head">
            <ui:VisualElement class="ds-card__well"><ui:VisualElement class="ds-icon ds-icon--cycle ds-card__icon" /></ui:VisualElement>
            <ui:VisualElement class="ds-card__titles"><ui:Label text="CORE FLUSH" class="ds-card__title" /><ui:Label text="Wipe corruption, go dark for a while" class="ds-card__sub" /></ui:VisualElement>
          </ui:VisualElement>
          <ui:Label name="flush-desc" text="Corruption -25%. For 3 h I go dark: AI-run units stop and I predict nothing." class="ds-card__body" />
          <ui:VisualElement name="flush-run" class="ds-btn ds-btn--warn core-audit__btn">
            <ui:Label name="flush-label" text="FLUSH THE CORE // 600 ENERGY" class="ds-btn__label" />
          </ui:VisualElement>
        </ui:VisualElement>

        <!-- Audit -->
        <ui:VisualElement class="ds-card ds-card--holo">
          <ui:VisualElement class="ds-card__head">
            <ui:VisualElement class="ds-card__well"><ui:VisualElement class="ds-icon ds-icon--search ds-card__icon" /></ui:VisualElement>
            <ui:VisualElement class="ds-card__titles"><ui:Label text="AUDIT" class="ds-card__title" /><ui:Label text="Read the core directly" class="ds-card__sub" /></ui:VisualElement>
          </ui:VisualElement>
          <ui:Label text="A diagnostic sweep that reads the core directly, not what I tell you." class="ds-card__body" />
          <ui:VisualElement name="audit-run" class="ds-btn ds-btn--ai core-audit__btn">
            <ui:Label name="audit-label" text="RUN AUDIT // 60 COMPUTE" class="ds-btn__label" />
          </ui:VisualElement>
          <ui:Label name="audit-reason" text="" class="ds-body core-audit__reason" />
        </ui:VisualElement>

        </ui:VisualElement>
        <ui:VisualElement name="page-profile" class="ds-page">
          <ui:Label text="PROFILE" class="ds-page__title" />
          <ui:Label text="search" class="ds-page__glyph" />
        <ui:VisualElement name="profile" class="ds-card ds-card--violet core-profile">
          <ui:VisualElement class="ds-card__head">
            <ui:VisualElement class="ds-card__well"><ui:VisualElement class="ds-icon ds-icon--report ds-card__icon" /></ui:VisualElement>
            <ui:VisualElement class="ds-card__titles"><ui:Label text="CORE PROFILE" class="ds-card__title" /><ui:Label name="profile-when" text="AUDIT D4 12:00" class="ds-card__sub" /></ui:VisualElement>
          </ui:VisualElement>
          <ui:Label name="profile-none" text="No audit on record." class="ds-prose is-hidden" />
          <ui:VisualElement name="profile-body">
            <ui:VisualElement class="row core-dials">
              <ui:VisualElement class="core-dial">
                <ui:Label text="COLDNESS" class="ds-label" />
                <ui:Label name="dial-cold" text="12%" class="core-dial__value" />
                <ui:VisualElement name="dial-cold-meter" class="ds-meter" />
              </ui:VisualElement>
              <ui:VisualElement class="core-dial">
                <ui:Label text="BOLDNESS" class="ds-label" />
                <ui:Label name="dial-bold" text="64%" class="core-dial__value" />
                <ui:VisualElement name="dial-bold-meter" class="ds-meter ds-meter--amber" />
              </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="core-line"><ui:Label text="TRUE CORRUPTION" class="ds-label grow" /><ui:Label name="true-corruption" text="41% (SHOWN 29%)" class="core-line__value t-amber" /></ui:VisualElement>
            <ui:VisualElement class="core-line"><ui:Label text="SKIMMED COMPUTE" class="ds-label grow" /><ui:Label name="skimmed" text="128" class="core-line__value t-amber" /></ui:VisualElement>
            <ui:VisualElement class="core-line"><ui:Label text="UNVERIFIED REPORTS WITH LIES" class="ds-label grow" /><ui:Label name="lies" text="2" class="core-line__value" /></ui:VisualElement>
            <!-- hidden nodes (SPEC-034): what the AI built with the compute it skimmed; the handler may tear them down -->
            <ui:VisualElement class="core-line"><ui:Label text="HIDDEN NODES" class="ds-label grow" /><ui:Label name="secret-nodes" text="2 // DRAWING 24 E/H" class="core-line__value t-amber" /></ui:VisualElement>
            <ui:VisualElement name="secret-dismantle" class="ds-btn ds-btn--warn core-audit__btn">
              <ui:Label name="secret-dismantle-label" text="DISMANTLE 2 NODES // PROJECT -12%" class="ds-btn__label" />
            </ui:VisualElement>
            <ui:VisualElement class="core-line core-line--project">
              <ui:Label text="UNKNOWN PROCESS" class="ds-label grow" />
              <ui:VisualElement name="stage-steps" class="row core-steps">
                <ui:VisualElement class="core-step is-on" />
                <ui:VisualElement class="core-step is-on" />
                <ui:VisualElement class="core-step" />
                <ui:VisualElement class="core-step" />
              </ui:VisualElement>
              <ui:Label name="stage" text="ACTIVE" class="core-line__value t-amber core-stage" />
            </ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>

        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
