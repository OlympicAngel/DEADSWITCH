/* After-action report (SPEC-006, SPEC-039): graphic-novel panels framed by the terminal. Tokens only. */

.rep { flex-grow: 1; background-color: var(--c-world); }
.rep-scroll { padding: var(--s-4) var(--s-5) var(--s-2) var(--s-5); }

.rep-title { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-sm); letter-spacing: var(--ls-label); color: var(--c-text); white-space: normal; }
.rep-vector { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-micro); color: var(--c-text-dim); margin-top: var(--s-1); white-space: normal; }
.rep-vector.is-mismatch { color: var(--c-amber); }

/* outcome stamp */
.rep-outcome-row { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: var(--s-3); padding: var(--s-3) var(--s-4); border-width: 0; border-radius: var(--r-lg); background-color: var(--c-elev-1); flex-shrink: 0; }
.rep-outcome-key { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-micro); letter-spacing: var(--ls-wide); color: var(--c-text-dim); }
.rep-outcome { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-xl); letter-spacing: var(--ls-wide); color: var(--c-amber); padding: var(--s-1) var(--s-4); border-width: 0; border-radius: var(--r-md); background-color: var(--c-amber-wash); rotate: -3deg; }
.rep-outcome.is-bad { color: var(--c-red); background-color: var(--c-red-wash); }
.rep-outcome.is-good { color: var(--c-phosphor); background-color: var(--c-phosphor-wash); }

.rep-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; flex-shrink: 0; }
.rep-panel {
    margin-bottom: var(--s-2);
    border-width: 5px;
    border-radius: var(--r-sm);
    border-color: var(--c-world);
    background-color: var(--c-panel-sunken);
    -unity-background-scale-mode: scale-and-crop;
}
.rep-panel--wide { width: 100%; height: 400px; }
.rep-panel--tall { width: 49%; height: 500px; }
.rep-cap {
    position: absolute;
    left: var(--s-3);
    top: var(--s-3);
    max-width: 78%;
    padding: var(--s-2) var(--s-3);
    background-color: var(--c-text);
    color: var(--c-world);
    -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold");
    font-size: var(--fs-micro);
    white-space: normal;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-color: var(--c-world);
}
.rep-cap--bottom { top: auto; bottom: var(--s-3); }

.rep-card { flex-shrink: 0; margin-top: var(--s-2); }
.rep-say { color: var(--c-phosphor); font-size: var(--fs-sm); white-space: normal; }
.rep-ledger { display: none; }
.rep-loss { flex-direction: row; flex-wrap: wrap; }
.rep-loss__item { flex-direction: row; align-items: center; margin-right: var(--s-2); margin-bottom: var(--s-2); padding: var(--s-2) var(--s-3); border-width: 0; border-radius: var(--r-md); background-color: var(--c-panel-sunken); }
.rep-loss__icon { width: 36px; height: 36px; margin-right: var(--s-2); --icon-color: var(--c-red); }
.rep-loss__label { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-sm); color: var(--c-text); }
.rep-findings { margin-top: var(--s-2); }
.rep-finding { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-micro); color: var(--c-text-dim); margin-top: var(--s-1); white-space: normal; }
.rep-finding.is-bad { color: var(--c-amber); }
.rep-verify { margin-top: var(--s-2); flex-shrink: 0; }
.rep-reason { margin-top: var(--s-1); color: var(--c-amber); white-space: normal; }

.is-hidden { display: none; }
