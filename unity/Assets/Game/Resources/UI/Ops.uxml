<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="Ops.uss" />
  <!-- OPS: defense setup (SPEC-005, SPEC-039 idea 54). Sample values are for the preview; OpsScreen fills everything. -->
  <ui:VisualElement name="ops" class="ops">

    <ui:VisualElement class="ds-head">
      <ui:VisualElement class="ds-head__well"><ui:VisualElement class="ds-icon ds-icon--shield ds-head__icon" /></ui:VisualElement>
      <ui:VisualElement class="ds-head__body">
        <ui:Label text="OPERATIONS" class="ds-head__title" />
        <ui:Label text="STANCE // DEFENDERS // AI CONTROL" class="ds-head__status" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:ScrollView name="ops-scroll" class="grow ops-scroll">

      <ui:VisualElement name="ops-pager" class="ds-pager">
      <ui:VisualElement name="page-threat" class="ds-page ops-page">
        <ui:Label text="THREAT" class="ds-page__title" />
        <ui:Label text="target" class="ds-page__glyph" />
      <!-- Threat: signature shape + label + color, timer, the AI's (uncertain) read -->
      <ui:VisualElement name="threat" class="ds-panel ds-panel--amber ds-card ops-threat">
        <ui:VisualElement class="row">
          <ui:VisualElement class="ops-threat__well"><ui:VisualElement name="threat-pip" class="ds-pip ds-pip--diamond ds-pip--amber ops-threat__pip" /></ui:VisualElement>
          <ui:VisualElement class="grow">
            <ui:Label name="threat-kind" text="RAID INCOMING" class="ds-label t-amber ops-threat__kind" />
            <ui:Label name="threat-cap" text="ARRIVES IN" class="ops-threat__cap" />
          </ui:VisualElement>
          <ui:Label name="threat-time" text="17:42" class="ds-value t-amber ops-threat__time" />
        </ui:VisualElement>
        <ui:VisualElement name="threat-intel" class="row ops-threat__intel">
          <ui:VisualElement class="ops-kv">
            <ui:Label text="VECTOR" class="ds-label" />
            <ui:Label name="threat-gate" text="NORTH RIDGE" class="ops-kv__value" />
          </ui:VisualElement>
          <ui:VisualElement class="ops-kv">
            <ui:Label text="STRENGTH" class="ds-label" />
            <ui:Label name="threat-est" text="34" class="ops-kv__value" />
          </ui:VisualElement>
          <ui:VisualElement class="spacer" />
          <ui:VisualElement class="ds-chip ds-chip--amber ops-ai-tag">
            <ui:Label text="AI ESTIMATE" class="ds-chip__label" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="threat-quiet" text="Perimeter quiet. Your stance and defenders stay as you set them." class="ds-prose ops-threat__quiet is-hidden" />
        <ui:VisualElement name="last-report" class="ds-btn ops-lastreport">
          <ui:Label name="last-report-label" text="LAST REPORT // RAID 2" class="ds-btn__label" />
        </ui:VisualElement>
        <ui:VisualElement name="lockdown" class="ds-btn ds-btn--warn ops-lockdown">
          <ui:Label name="lockdown-label" text="EMERGENCY LOCKDOWN  //  OVR 1/3" class="ds-btn__label" />
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- Purge warning ladder (SPEC-015, doc 10): rumor -> staging -> ultimatum with three answers -->
      <ui:VisualElement name="purge" class="ds-panel ds-panel--red ds-card ds-card--red ops-purge">
        <ui:VisualElement class="row">
          <ui:VisualElement class="ds-card__well"><ui:VisualElement class="ds-icon ds-icon--skull ds-card__icon" /></ui:VisualElement>
          <ui:Label name="purge-stage" text="PURGE // ULTIMATUM" class="ds-label t-red ops-threat__kind grow" />
          <ui:Label name="purge-time" text="5:42:10" class="ds-value t-red ops-purge__time" />
        </ui:VisualElement>
        <ui:Label name="purge-desc" text="Pay tribute, pull everyone out, or hold the wall. They take everything they can reach." class="ds-prose ops-purge__desc" />
        <ui:VisualElement name="purge-answers" class="row ops-purge__answers">
          <ui:VisualElement name="purge-pay" class="ds-btn ds-btn--warn ops-purge__btn"><ui:Label name="purge-pay-label" text="PAY 800 ENERGY + 60 COMPUTE" class="ds-btn__label" /></ui:VisualElement>
          <ui:VisualElement name="purge-retreat" class="ds-btn ops-purge__btn"><ui:Label text="RETREAT" class="ds-btn__label" /></ui:VisualElement>
          <ui:VisualElement name="purge-prepare" class="ds-btn ops-purge__btn"><ui:Label text="PREPARE" class="ds-btn__label" /></ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- Yard wrecks (SPEC-018): burnt hulks slow regrowth until cleared -->
      <ui:VisualElement name="yard" class="ds-card ds-card--fold ops-yard">
        <ui:VisualElement class="ds-card__head">
          <ui:VisualElement class="ds-card__well ops-yard__well"><ui:VisualElement class="ds-icon ds-icon--truck ds-card__icon ops-yard__icon" /></ui:VisualElement>
          <ui:VisualElement class="ds-card__titles">
            <ui:Label name="yard-title" text="YARD // 3 WRECKS" class="ds-label t-amber" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="yard-desc" text="Regrowth -30% while the wrecks stay." class="ds-prose ops-yard__desc" />
        <ui:VisualElement name="yard-clear" class="ds-btn ops-yard__btn"><ui:Label name="yard-clear-label" text="CLEAR // 60 ENERGY" class="ds-btn__label" /></ui:VisualElement>
      </ui:VisualElement>

      </ui:VisualElement>
      <ui:VisualElement name="page-defend" class="ds-page ops-page">
        <ui:Label text="DEFEND" class="ds-page__title" />
        <ui:Label text="shield" class="ds-page__glyph" />
      <!-- Posture -->
      <ui:VisualElement class="ds-section"><ui:VisualElement class="ds-icon ds-icon--shield ds-section__icon" /><ui:Label text="STANCE" class="ds-section__title" /><ui:VisualElement class="ds-section__rule" /></ui:VisualElement>
      <ui:VisualElement class="ds-card ops-card">
        <ui:Label text="How the base meets the next attack. One at a time." class="ds-card__sub ops-card__lead" />
        <ui:VisualElement class="ops-postures">
                <ui:VisualElement name="posture-none" class="ops-posture">
                  <ui:VisualElement class="ds-icon ds-icon--hold ops-posture__icon" />
                  <ui:VisualElement class="ops-posture__body">
                    <ui:Label text="NORMAL" class="ops-posture__name" />
                    <ui:Label name="posture-none-fx" text="No changes. Everyone works." class="ops-posture__fx" />
                  </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="posture-turtle" class="ops-posture is-selected">
                  <ui:VisualElement class="ds-icon ds-icon--shield ops-posture__icon" />
                  <ui:VisualElement class="ops-posture__body">
                    <ui:Label text="FORTIFY" class="ops-posture__name" />
                    <ui:Label name="posture-turtle-fx" text="+50% DEFENSE" class="ops-posture__fx" />
                  </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="posture-dark" class="ops-posture">
                  <ui:VisualElement class="ds-icon ds-icon--dark ops-posture__icon" />
                  <ui:VisualElement class="ops-posture__body">
                    <ui:Label text="HIDE" class="ops-posture__name" />
                    <ui:Label name="posture-dark-fx" text="40% MISS // -120/H ENERGY" class="ops-posture__fx" />
                  </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="posture-evacuate" class="ops-posture">
                  <ui:VisualElement class="ds-icon ds-icon--evacuate ops-posture__icon" />
                  <ui:VisualElement class="ops-posture__body">
                    <ui:Label text="EVACUATE" class="ops-posture__name" />
                    <ui:Label name="posture-evacuate-fx" text="NO CASUALTIES // LOOT x150%" class="ops-posture__fx" />
                  </ui:VisualElement>
                </ui:VisualElement>
              </ui:VisualElement>
      </ui:VisualElement>

      <!-- Garrison sockets -->
      <ui:VisualElement class="ds-section"><ui:VisualElement class="ds-icon ds-icon--people ds-section__icon" /><ui:Label text="DEFENDERS" class="ds-section__title" /><ui:VisualElement class="ds-section__rule" /></ui:VisualElement>
      <ui:VisualElement class="ds-card ops-card">
        <ui:Label name="garrison-note" text="+4 DEF EACH // 15 ON CREW DUTY" class="ds-label t-dim ops-card__lead" />
        <ui:VisualElement name="sockets" class="ops-sockets">
          <ui:VisualElement class="ops-socket is-filled"><ui:VisualElement class="ds-icon ds-icon--people ops-socket__icon" /></ui:VisualElement>
          <ui:VisualElement class="ops-socket is-filled"><ui:VisualElement class="ds-icon ds-icon--people ops-socket__icon" /></ui:VisualElement>
          <ui:VisualElement class="ops-socket is-filled"><ui:VisualElement class="ds-icon ds-icon--people ops-socket__icon" /></ui:VisualElement>
          <ui:VisualElement class="ops-socket"><ui:VisualElement class="ds-icon ds-icon--people ops-socket__icon" /></ui:VisualElement>
          <ui:VisualElement class="ops-socket"><ui:VisualElement class="ds-icon ds-icon--people ops-socket__icon" /></ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- The AI's read of the setup -->
      <ui:VisualElement class="ds-card ds-card--holo ops-read">
        <ui:VisualElement class="row">
          <ui:VisualElement class="ops-read__conf">
            <ui:Label text="AI CONFIDENCE" class="ds-label" />
            <ui:VisualElement class="row--baseline">
              <ui:Label name="confidence" text="55" class="ds-value ds-value--hero" />
              <ui:Label text="%" class="ds-unit" />
              <ui:Label name="confidence-band" text="FAIR" class="ds-label t-amber ops-read__band" />
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:VisualElement class="spacer" />
          <ui:VisualElement class="ops-read__vs">
            <ui:Label name="read-def" text="DEF 36" class="ops-read__line" />
            <ui:Label name="read-est" text="EST 34" class="ops-read__line t-dim" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="confidence-meter" class="ds-meter ds-meter--amber" />
        <!-- forces and counters (SPEC-035): what is coming, and how each part of our line fares against it -->
        <ui:VisualElement class="ops-forces">
          <ui:Label name="forces" text="FORCES // 60% INFANTRY  10% DRONES  30% VEHICLES" class="ds-label t-amber" />
          <ui:Label name="forces-line" text="OUR LINE // DEFENDERS 48 (+8%)  DRONES 24 (+20%)  VEHICLES 0" class="ds-prose ops-forces__line" />
        </ui:VisualElement>
        <ui:VisualElement class="row ops-go">
          <ui:VisualElement class="grow">
            <ui:Label text="AI RECOMMENDS" class="ds-label" />
            <ui:Label name="recommend" text="FORTIFY // 5 DEFENDERS" class="ops-go__rec" />
          </ui:VisualElement>
          <ui:VisualElement name="set-go" class="ds-btn ds-btn--ai ops-go__btn">
            <ui:Label text="SET &amp; GO" class="ds-btn__label" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      </ui:VisualElement>
      <ui:VisualElement name="page-autonomy" class="ds-page ops-page">
        <ui:Label text="AI CONTROL" class="ds-page__title" />
        <ui:Label text="chip" class="ds-page__glyph" />
      <!-- How much the AI runs (SPEC-004) -->
      <ui:VisualElement class="ds-card ops-card">
        <ui:VisualElement class="ds-seg ops-seg">
          <ui:VisualElement name="deleg-manual" class="ds-seg__item ops-seg__item is-selected"><ui:VisualElement class="ds-icon ds-icon--hand ops-seg__icon" /><ui:Label text="YOU DECIDE" class="ops-seg__label" /></ui:VisualElement>
          <ui:VisualElement name="deleg-routines" class="ds-seg__item ops-seg__item"><ui:VisualElement class="ds-icon ds-icon--cycle ops-seg__icon" /><ui:Label text="AI ASSISTS" class="ops-seg__label" /></ui:VisualElement>
          <ui:VisualElement name="deleg-autopilot" class="ds-seg__item ops-seg__item"><ui:VisualElement class="ds-icon ds-icon--chip ops-seg__icon" /><ui:Label text="AI DECIDES" class="ops-seg__label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="deleg-desc" text="I only advise. You run everything." class="ds-prose ops-seg__desc" />
      </ui:VisualElement>

      </ui:VisualElement>
      <ui:VisualElement name="page-away" class="ds-page ops-page">
        <ui:Label text="AWAY" class="ds-page__title" />
        <ui:Label text="clock" class="ds-page__glyph" />
      <!-- Away protection (SPEC-015 rules 5-6) -->
      <ui:VisualElement class="ds-card ops-card">
        <ui:VisualElement class="row ds-row ops-alerts">
          <ui:VisualElement class="ops-alerts__well"><ui:VisualElement class="ds-icon ds-icon--shield ops-alerts__icon" /></ui:VisualElement>
          <ui:VisualElement class="grow ops-alerts__text">
            <ui:Label name="shield-title" text="VACATION SHIELD // 1 CHARGE" class="ds-label" />
            <ui:Label name="shield-desc" text="Pauses attacks for 72 h after a 2 h delay. Upkeep halved. A charge every 60 days (max 2)." class="ds-prose ops-alerts__desc" />
          </ui:VisualElement>
          <ui:VisualElement name="shield-toggle" class="ds-switch ops-toggle"><ui:Label name="shield-label" text="RAISE" class="ops-toggle__label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="row ds-row ops-alerts">
          <ui:VisualElement class="ops-alerts__well"><ui:VisualElement class="ds-icon ds-icon--box ops-alerts__icon" /></ui:VisualElement>
          <ui:VisualElement class="grow ops-alerts__text">
            <ui:Label text="TRIBUTE ORDER" class="ds-label" />
            <ui:Label name="tribute-desc" text="When a raid arrives while you are away, pay 25% of stored energy and it leaves. Not sieges or purges." class="ds-prose ops-alerts__desc" />
          </ui:VisualElement>
          <ui:VisualElement name="tribute-toggle" class="ds-switch ops-toggle"><ui:Label name="tribute-label" text="OFF" class="ops-toggle__label" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="row ds-row ops-alerts">
          <ui:VisualElement class="ops-alerts__well"><ui:VisualElement class="ds-icon ds-icon--mail ops-alerts__icon" /></ui:VisualElement>
          <ui:VisualElement class="grow ops-alerts__text">
            <ui:Label text="ALERTS WHILE AWAY" class="ds-label" />
            <ui:Label text="I forecast the next day when you leave: raids, finished work, power loss. Nothing else." class="ds-prose ops-alerts__desc" />
          </ui:VisualElement>
          <ui:VisualElement name="alerts-toggle" class="ds-switch ops-toggle"><ui:Label name="alerts-label" text="OFF" class="ops-toggle__label" /></ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
      </ui:VisualElement>
      </ui:VisualElement>
      <ui:Label name="ops-reason" text="" class="ds-body ops-reason" />
    </ui:ScrollView>
  </ui:VisualElement>
</ui:UXML>
