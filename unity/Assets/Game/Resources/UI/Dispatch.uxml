<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="Dispatch.uss" />
  <!-- DISPATCH (F-034): the world knocking. Warlord Ultimatum, the pending dilemma and the current world event.
       Every cost and risk is shown before the tap. Sample values are for the preview; DispatchScreen fills everything. -->
  <ui:VisualElement name="dispatch" class="dsp">
    <ui:VisualElement class="row dsp-head">
      <ui:Label text="DISPATCH" class="ds-title grow" />
      <ui:VisualElement name="dsp-close" class="dsp-close"><ui:Label text="X" class="dsp-close__x" /></ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="dsp-world" class="row dsp-world">
      <ui:VisualElement name="dsp-world-pip" class="ds-pip ds-pip--amber dsp-world__pip" />
      <ui:VisualElement class="grow">
        <ui:Label name="dsp-world-title" text="SIGNAL STORM // 14:22:10" class="dsp-world__title" />
        <ui:Label name="dsp-world-desc" text="Hack odds -20. Corruption creeps up 0.1% an hour." class="ds-body t-dim dsp-world__desc" />
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- Warlord Ultimatum -->
    <ui:VisualElement name="dsp-ultimatum" class="ds-panel dsp-card dsp-card--threat">
      <ui:VisualElement class="row">
        <ui:Label text="WARLORD ULTIMATUM" class="dsp-card__name grow" />
        <ui:Label name="dsp-ult-time" text="23:41:08" class="dsp-card__time t-red" />
      </ui:VisualElement>
      <ui:Label text="RUSTBORN // MOTHER KESS" class="ds-label t-amber dsp-card__from" />
      <ui:Label name="dsp-ult-text" text="Mother Kess has watched us stay small for ten days. Pay, or her whole clan comes over the wall." class="ds-body dsp-card__text" />
      <ui:VisualElement class="row dsp-card__terms">
        <ui:VisualElement class="dsp-kv"><ui:Label text="PRICE" class="ds-label" /><ui:Label name="dsp-ult-price" text="800 E  100 F" class="dsp-kv__value" /></ui:VisualElement>
        <ui:VisualElement class="dsp-kv"><ui:Label text="REFUSE" class="ds-label" /><ui:Label name="dsp-ult-wave" text="WAVE x2.5" class="dsp-kv__value t-red" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:Label name="dsp-ult-note" text="Advance to Tier 2 before the deadline and she withdraws. A standing tribute order pays for you." class="ds-body t-dim dsp-card__note" />
      <ui:VisualElement class="row dsp-card__actions">
        <ui:VisualElement name="dsp-ult-pay" class="ds-btn ds-btn--primary grow"><ui:Label text="PAY" class="ds-btn__label" /></ui:VisualElement>
        <ui:VisualElement name="dsp-ult-prepare" class="ds-btn ds-btn--warn grow dsp-gap"><ui:Label text="PREPARE DEFENSES" class="ds-btn__label" /></ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- Dilemma -->
    <ui:VisualElement name="dsp-dilemma" class="ds-panel dsp-card">
      <ui:VisualElement class="row">
        <ui:Label name="dsp-dil-name" text="REFUGEES AT THE GATE" class="dsp-card__name grow" />
        <ui:Label name="dsp-dil-time" text="11:02:40" class="dsp-card__time t-amber" />
      </ui:VisualElement>
      <ui:Label name="dsp-dil-text" text="Twelve people outside the north gate. Hands we need. One of them may not be what they seem." class="ds-body dsp-card__text" />
      <ui:VisualElement name="dsp-dil-take" class="dsp-choice">
        <ui:Label name="dsp-dil-take-label" text="TAKE THEM IN" class="dsp-choice__label" />
        <ui:Label name="dsp-dil-take-fx" text="+3 PEOPLE // 30% A SPY: HEAT +15 ON THE HOTTEST FACTION" class="dsp-choice__fx" />
      </ui:VisualElement>
      <ui:VisualElement name="dsp-dil-refuse" class="dsp-choice dsp-choice--safe">
        <ui:Label name="dsp-dil-refuse-label" text="TURN THEM AWAY" class="dsp-choice__label" />
        <ui:Label name="dsp-dil-refuse-fx" text="NOTHING CHANGES" class="dsp-choice__fx" />
      </ui:VisualElement>
      <ui:Label text="UNANSWERED, I REFUSE FOR YOU." class="ds-label t-dim dsp-card__note" />
    </ui:VisualElement>

    <ui:Label name="dsp-empty" text="The wastes are quiet. Nothing is waiting on you." class="ds-body t-dim dsp-empty is-hidden" />
    <ui:Label name="dsp-reason" text="" class="ds-body t-amber dsp-reason" />
  </ui:VisualElement>
</ui:UXML>
