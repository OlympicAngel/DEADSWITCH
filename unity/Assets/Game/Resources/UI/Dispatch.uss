/* DISPATCH (F-034, SPEC-039 kit). Tokens only. */

.dsp { flex-grow: 1; padding: var(--s-4) var(--s-6) var(--s-2) var(--s-6); background-color: var(--c-scrim); }
.dsp-head { margin-bottom: var(--s-3); }
.dsp-close { width: var(--touch); height: var(--touch); align-items: center; justify-content: center; border-width: 1px; border-radius: var(--r-md); border-color: var(--c-line-mid); background-color: var(--c-elev-2); }
.dsp-close__x { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-md); color: var(--c-text-dim); }
.dsp-scroll { flex-grow: 1; flex-shrink: 1; }

.dsp-world.is-hidden { display: none; }
.dsp-world__head { margin-bottom: var(--s-2); }
.dsp-world__pip { margin-left: var(--s-3); }
.dsp-world__title { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-sm); letter-spacing: 3px; color: var(--c-amber); }
.dsp-world__desc { font-size: var(--fs-xs); white-space: normal; }
.dsp-kicker { letter-spacing: 3px; margin-bottom: 2px; }

.dsp-card.is-hidden { display: none; }
.dsp-card--threat { border-width: var(--bw); }
.dsp-timer { flex-direction: row; align-items: center; margin-left: var(--s-2); padding: var(--s-1) var(--s-3); border-width: 1px; border-radius: var(--r-md); border-color: var(--c-amber-dim); background-color: var(--c-panel-sunken); }
.dsp-timer--red { border-color: var(--c-red); }
.dsp-timer__icon { width: 26px; height: 26px; margin-right: var(--s-2); --icon-color: var(--c-text-dim); }
.dsp-card__time { min-height: 40px; -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-sm); }
.dsp-card__terms { margin-bottom: var(--s-3); }
.dsp-card__note { margin-top: var(--s-2); font-size: var(--fs-micro); white-space: normal; }
.dsp-card__actions { margin-top: var(--s-3); }
.dsp-gap { margin-left: var(--s-3); }
.dsp-kv { flex-grow: 1; flex-basis: 0; padding: var(--s-2) var(--s-3); margin-right: var(--s-3); border-width: 1px; border-radius: var(--r-md); border-color: var(--c-line); background-color: var(--c-panel-sunken); }
.dsp-kv--danger { margin-right: 0; border-color: var(--c-red-glow); }
.dsp-kv__value { min-height: 50px; -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-md); color: var(--c-text); margin-top: var(--s-1); }

.dsp-choice {
    flex-direction: row;
    align-items: center;
    margin-top: var(--s-3);
    min-height: var(--touch);
    padding: var(--s-3);
    border-width: var(--bw);
    border-radius: var(--r-md);
    border-color: var(--c-amber);
    background-color: var(--c-amber-wash);
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}
.dsp-choice:active { scale: 0.98 0.98; }
.dsp-choice--safe { border-color: var(--c-line-mid); background-color: var(--c-panel-sunken); }
.dsp-choice.is-disabled { opacity: 0.4; }
.dsp-choice__well { width: 72px; height: 72px; align-items: center; justify-content: center; margin-right: var(--s-3); border-radius: var(--r-md); border-width: 1px; border-color: var(--c-amber-dim); background-color: var(--c-amber-wash); }
.dsp-choice--safe > .dsp-choice__well { border-color: var(--c-line-mid); background-color: var(--c-elev-2); }
.dsp-choice__icon { width: 42px; height: 42px; --icon-color: var(--c-amber); }
.dsp-choice--safe .dsp-choice__icon { --icon-color: var(--c-text-dim); }
.dsp-choice__text { flex-grow: 1; flex-shrink: 1; }
.dsp-choice__go { width: 30px; height: 30px; margin-left: var(--s-2); --icon-color: var(--c-text-dim); }
.dsp-choice__label { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-sm); letter-spacing: 3px; color: var(--c-amber); }
.dsp-choice--safe > .dsp-choice__text > .dsp-choice__label { color: var(--c-text); }
.dsp-choice__fx { -unity-font-definition: resource("Fonts/IBMPlexMono-Medium"); font-size: var(--fs-micro); color: var(--c-text-dim); margin-top: var(--s-1); white-space: normal; }

.dsp-empty { margin-top: var(--s-4); white-space: normal; }
.dsp-empty.is-hidden { display: none; }
.dsp-reason { margin-top: var(--s-2); min-height: 40px; white-space: normal; }
