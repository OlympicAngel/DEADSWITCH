/* CORE: the AI terminal (SPEC-007, SPEC-039). Orb hero + grouped holo cards. Tokens only. */

.core { flex-grow: 1; background-color: var(--c-scrim); }
.core-head { margin-bottom: 0; }
.core-scroll { flex-grow: 1; padding: var(--s-4) var(--s-6) 0 var(--s-6); }
.core-scroll > .unity-scroll-view__content-container { padding-bottom: var(--s-8); }

.core-settings { flex-direction: row; align-items: center; min-height: var(--touch); padding: 0 var(--s-4); justify-content: center; border-width: 0; border-radius: var(--r-lg); background-color: var(--c-cyan-wash); }
.core-settings__icon { width: 36px; height: 36px; margin-right: var(--s-2); --icon-color: var(--c-cyan); }
.core-settings__label { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-micro); letter-spacing: var(--ls-label); color: var(--c-cyan); }

.core-seg { margin: var(--s-3) var(--s-6) 0 var(--s-6); }
.core-seg__label { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-xs); letter-spacing: var(--ls-wide); color: var(--c-text-dim); }
.core-seg__item.is-selected > .core-seg__label { color: var(--c-cyan); }

/* ---------- Final window ---------- */
.core-climax { margin-bottom: var(--s-3); }
.core-climax__pip { width: 16px; height: 16px; margin-right: var(--s-3); }
.core-climax__title { flex-shrink: 1; white-space: normal; }
.core-climax__time { font-size: var(--fs-lg); flex-shrink: 0; margin-left: var(--s-3); }
.core-climax__desc { margin-top: var(--s-1); font-size: var(--fs-xs); }
.core-climax__btn { margin-top: var(--s-2); min-height: var(--touch); }
.core-climax__btn > .ds-btn__label { font-size: var(--fs-micro); }
.core-silenced { margin-bottom: var(--s-3); white-space: normal; }
.core-climax > .ds-corner { display: none; }

/* ---------- Hero: orb + reported corruption ---------- */
.core-hero { align-items: stretch; margin-bottom: var(--s-4); padding: var(--s-4); border-width: 0; border-top-width: 1px; border-radius: var(--r-lg); border-top-color: var(--c-cyan-dim); background-color: var(--c-glass); }
.core-orb { --ring-color: var(--c-cyan); --core-color: var(--c-cyan-glow); width: 220px; height: 220px; align-self: center; margin: var(--s-2) 0 var(--s-3) 0; }
.core-orb--amber { --ring-color: var(--c-amber); --core-color: var(--c-amber-glow); }
.core-orb--red { --ring-color: var(--c-red); --core-color: var(--c-red-glow); }
.core-hero__readout { align-items: center; }
.core-hero__readout > .row--baseline { justify-content: center; }
.core-hero__tags { margin-top: var(--s-1); align-self: stretch; }
.core-hero__meter { margin-top: var(--s-3); }
.core-status__band { margin-left: var(--s-4); padding-bottom: var(--s-2); }
.core-pills { margin-top: var(--s-4); align-items: stretch; }
.core-pill { flex-grow: 1; flex-basis: 0; align-items: center; margin: 0 var(--s-1); padding: var(--s-3) var(--s-2); border-width: 0; border-radius: var(--r-lg); background-color: var(--c-panel-sunken); }
.core-pill__icon { width: 36px; height: 36px; --icon-color: var(--c-cyan); }
.core-pill__key { font-size: var(--fs-micro); letter-spacing: var(--ls-tight); color: var(--c-text-dim); margin-top: var(--s-1); white-space: normal; -unity-text-align: middle-center; }
.core-kv__value { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-xs); color: var(--c-text); margin-top: var(--s-1); -unity-text-align: middle-center; }

/* ---------- Links and cards ---------- */
.core-links { align-items: stretch; margin-bottom: var(--s-4); }
.core-link { flex-direction: column; flex-basis: 0; margin: 0 var(--s-1); padding: var(--s-3) var(--s-2); border-width: 0; background-color: var(--c-violet-wash); }
.core-link__icon { width: 44px; height: 44px; margin-bottom: var(--s-1); --icon-color: var(--c-violet); }
.core-link > .ds-btn__label { font-size: var(--fs-micro); letter-spacing: var(--ls-label); color: var(--c-text); white-space: normal; -unity-text-align: middle-center; }
.core-link.is-new { border-left-width: 6px; border-color: var(--c-amber); background-color: var(--c-amber-wash); }
.core-link.is-new > .ds-btn__label { color: var(--c-amber); }
.core-crisis { margin-top: 0; }
.core-crisis.is-hidden { display: none; }
.core-audit__desc { margin-top: var(--s-1); font-size: var(--fs-xs); }
.core-audit__btn { margin-top: var(--s-1); }
.core-audit__reason { margin-top: var(--s-1); color: var(--c-amber); font-size: var(--fs-xs); white-space: normal; }

.core-dials { margin-top: var(--s-1); }
.core-dial { flex-grow: 1; flex-basis: 0; margin-right: var(--s-6); }
.core-dial.is-last { margin-right: 0; }
.core-dial__value { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-lg); color: var(--c-text); }
.core-line { flex-direction: row; align-items: center; min-height: 56px; border-top-width: 1px; border-color: var(--c-violet-wash); margin-top: var(--s-2); padding-top: var(--s-2); }
.core-line__value { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-sm); color: var(--c-text); }
.core-steps { margin-right: var(--s-4); }
.core-step { width: 26px; height: 12px; margin-left: 4px; background-color: var(--c-amber-wash); }
.core-step.is-on { background-color: var(--c-amber); }
.core-stage { min-width: 180px; -unity-text-align: middle-right; }

/* ---------- Transcript: holo terminal ---------- */
.core-transcript { padding: var(--s-3) var(--s-4); border-width: 0; border-left-width: 6px; border-radius: var(--r-lg); border-color: var(--c-cyan); background-color: var(--c-panel-sunken); }
.core-transcript__line { -unity-font-definition: resource("Fonts/ChakraPetch-Regular"); color: var(--c-phosphor-dim); font-size: var(--fs-xs); white-space: normal; margin-bottom: var(--s-1); }
.core-transcript__line.is-last { color: var(--c-cyan); }

.is-hidden { display: none; }

/* scroll content never squeezes its children */
.core-scroll > .unity-scroll-view__content-container { flex-shrink: 0; }
#status-view { flex-shrink: 0; }
.core-hero, .ds-card, .ds-section, .core-links, .core-transcript, .core-climax, .core-silenced, .core-line, .core-dials, .core-pills, .core-transcript__line { flex-shrink: 0; }

/* SPEC-046 r9: the one decision the core wants from you, above its status */
.core-next { flex-shrink: 0; margin-bottom: var(--s-4); padding: var(--s-4); border-top-color: var(--c-cyan); }
.core-next.is-hidden { display: none; }
.core-next__title { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-sm); letter-spacing: var(--ls-label); color: var(--c-cyan); }
.core-next__body { margin: var(--s-2) 0 var(--s-3) 0; white-space: normal; }
.core-next__btn { min-height: var(--touch); }
