/* CORE: the AI terminal (SPEC-007). Tokens only. */

.core { flex-grow: 1; padding: var(--s-4) var(--s-6) var(--s-2) var(--s-6); background-color: var(--c-scrim); }
.core-head { flex-direction: row; align-items: flex-end; margin-bottom: var(--s-3); }
.core-head__sub { margin-left: var(--s-4); padding-bottom: var(--s-1); }
.core-seg { flex-direction: row; border-width: var(--bw); border-color: var(--c-line-mid); margin-bottom: var(--s-3); }
.core-seg__item { flex-grow: 1; flex-basis: 0; min-height: 88px; align-items: center; justify-content: center; border-right-width: 1px; border-color: var(--c-line-mid); }
.core-seg__item:last-child { border-right-width: 0; }
.core-seg__item.is-selected { background-color: rgba(168, 213, 138, 0.14); }
.core-seg__label { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-xs); letter-spacing: 3px; color: var(--c-text-dim); }
.core-seg__item.is-selected > .core-seg__label { color: var(--c-phosphor); }
.core-section { margin-top: var(--s-4); margin-bottom: var(--s-2); }

.core-status__value { margin-top: var(--s-2); }
.core-status__band { margin-left: var(--s-4); padding-bottom: var(--s-2); }
.core-status__row { margin-top: var(--s-4); justify-content: space-between; }
.core-kv { flex-grow: 1; }
.core-kv__value { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-sm); color: var(--c-text); margin-top: var(--s-1); }

.core-audit { margin-top: var(--s-3); }
.core-audit__desc { margin-top: var(--s-1); font-size: var(--fs-xs); }
.core-audit__btn { margin-top: var(--s-3); }
.core-audit__reason { margin-top: var(--s-1); color: var(--c-amber); font-size: var(--fs-xs); }

.core-profile { margin-top: var(--s-3); }
.core-dials { margin-top: var(--s-3); }
.core-dial { flex-grow: 1; flex-basis: 0; margin-right: var(--s-6); }
.core-dial:last-child { margin-right: 0; }
.core-dial__value { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-lg); color: var(--c-text); }
.core-line { flex-direction: row; align-items: center; min-height: 56px; border-top-width: 1px; border-color: var(--c-line); margin-top: var(--s-2); padding-top: var(--s-2); }
.core-line__value { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-sm); color: var(--c-text); }
.core-steps { margin-right: var(--s-4); }
.core-step { width: 26px; height: 12px; margin-left: 4px; background-color: rgba(232, 180, 92, 0.16); }
.core-step.is-on { background-color: var(--c-amber); }
.core-stage { min-width: 180px; -unity-text-align: middle-right; }

.core-transcript { padding: var(--s-3) var(--s-4); border-width: 1px; border-color: var(--c-line); background-color: var(--c-panel-sunken); }
.core-transcript__line { color: var(--c-phosphor-dim); font-size: var(--fs-xs); white-space: normal; margin-bottom: var(--s-1); }
.core-transcript__line:last-child { color: var(--c-phosphor); }

.is-hidden { display: none; }
