/* Attack cinematic overlay (SPEC-039 D): letterbox bars, title card, aftermath stamp. Tokens only. */
.cine { position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: space-between; }
.cine-bar { height: 0; background-color: var(--c-world); overflow: hidden; }
.cine-bar--top { border-bottom-width: 2px; border-color: var(--c-red-glow); }
.cine-bar--bottom { border-top-width: 2px; border-color: var(--c-red-glow); justify-content: center; align-items: flex-end; padding-right: var(--s-6); }
.cine-skip { -unity-font-definition: resource("Fonts/ChakraPetch-SemiBold"); font-size: var(--fs-micro); letter-spacing: 4px; color: var(--c-text-faint); }

.cine-card {
    position: absolute;
    left: var(--s-8);
    right: var(--s-8);
    top: 38%;
    padding: var(--s-6) var(--s-8);
    align-items: center;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--c-amber);
    background-color: var(--c-scrim);
}

.cine-card--red { border-color: var(--c-red); }
.cine-card__pip { width: 40px; height: 40px; margin-right: var(--s-5); }
.cine-card__kind { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-hero); letter-spacing: 14px; color: var(--c-amber); text-shadow: 0 0 18px var(--c-amber-glow); }
.cine-card--red .cine-card__kind { color: var(--c-red); text-shadow: 0 0 18px var(--c-red-glow); }
.cine-card__line { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-xs); letter-spacing: 4px; color: var(--c-text); margin-top: var(--s-2); }

.cine-stamp {
    position: absolute;
    left: 0;
    right: 0;
    top: 22%;
    -unity-font-definition: resource("Fonts/ChakraPetch-Bold");
    -unity-text-align: middle-center;
    font-size: var(--fs-hero);
    letter-spacing: 12px;
    color: var(--c-phosphor);
    text-shadow: 0 0 18px var(--c-phosphor-glow);
}

.cine-stamp--bad { color: var(--c-red); text-shadow: 0 0 18px var(--c-red-glow); }
