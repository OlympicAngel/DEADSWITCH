<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="Report.uss" />
  <!-- After-action report (SPEC-006). Panels receive rendered stills; sample text is for the preview. -->
  <ui:VisualElement name="report" class="rep">
    <ui:VisualElement class="row rep-head">
      <ui:VisualElement class="grow">
        <ui:Label name="rep-title" text="AFTER-ACTION // RAID 1 // BREACHED" class="rep-title" />
        <ui:Label name="rep-vector" text="PREDICTED NORTH RIDGE  //  CONTACT SOUTH GATE" class="rep-vector is-mismatch" />
      </ui:VisualElement>
      <ui:VisualElement name="rep-close" class="rep-close"><ui:Label text="X" class="rep-close__x" /></ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement class="rep-grid">
      <ui:VisualElement name="panel-0" class="rep-panel rep-panel--wide"><ui:Label name="cap-0" text="D1 05:41 // Movement beyond the SOUTH GATE. I estimated 33." class="rep-cap" /></ui:VisualElement>
      <ui:VisualElement name="panel-1" class="rep-panel rep-panel--tall"><ui:Label name="cap-1" text="D1 06:01 // Contact at the SOUTH GATE. Strength 30 against defense 0." class="rep-cap rep-cap--bottom" /></ui:VisualElement>
      <ui:VisualElement name="panel-2" class="rep-panel rep-panel--tall"><ui:Label name="cap-2" text="They got through. The stores took the hit." class="rep-cap rep-cap--bottom" /></ui:VisualElement>
      <ui:VisualElement name="panel-3" class="rep-panel rep-panel--wide"><ui:Label name="cap-3" text="-60 ENERGY, -15 COMPUTE." class="rep-cap" /></ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement class="rep-box">
      <ui:VisualElement class="row">
        <ui:Label text="AI SUMMARY" class="ds-label grow" />
        <ui:VisualElement name="rep-state" class="ds-chip ds-chip--amber"><ui:Label name="rep-state-label" text="UNVERIFIED" class="ds-chip__label" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:Label name="rep-summary" text="&gt; Breach at the SOUTH GATE. Losses contained: -36 ENERGY, -15 COMPUTE." class="rep-say" />
    </ui:VisualElement>

    <ui:VisualElement class="rep-box">
      <ui:VisualElement class="row">
        <ui:Label text="LOSS LEDGER" class="ds-label grow" />
        <ui:Label text="STORE COUNT" class="ds-label" />
      </ui:VisualElement>
      <ui:Label name="rep-ledger" text="-60 ENERGY, -15 COMPUTE" class="rep-ledger" />
      <ui:VisualElement name="rep-findings" class="rep-findings is-hidden" />
    </ui:VisualElement>

    <ui:VisualElement name="rep-verify" class="ds-btn rep-verify">
      <ui:Label name="rep-verify-label" text="VERIFY // 20 COMPUTE" class="ds-btn__label" />
    </ui:VisualElement>
    <ui:Label name="rep-reason" text="" class="ds-body rep-reason" />
  </ui:VisualElement>
</ui:UXML>
