/* FULL GAME (F-036). Tokens only (the five swatches show the real theme colors from Tokens.uss themes). Honest and calm:
   no urgency, no scarcity, no shame. Optional things look optional (ghost buttons); the one purchase is the one primary. */

.prm { flex-grow: 1; background-color: var(--c-world); }
.prm-body { padding: var(--s-5) var(--s-5) var(--s-4) var(--s-5); }

/* the offer */
.prm-card { padding-bottom: var(--s-5); }
.prm-state { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-micro); letter-spacing: var(--ls-label); margin-top: 2px; }
.prm-state.t-amber { color: var(--c-amber); }
.prm-state.t-phosphor { color: var(--c-phosphor); }
.prm-group { margin-top: var(--s-3); margin-bottom: var(--s-2); }
.prm-item { min-height: 64px; margin-bottom: 0; padding: var(--s-2) 0; }
.prm-item__icon { width: 32px; height: 32px; flex-shrink: 0; margin-right: var(--s-3); --icon-color: var(--c-cyan); }
.prm-item__text { color: var(--c-text); flex-shrink: 1; }
.prm-item--have .prm-item__icon { --icon-color: var(--c-phosphor); }
.prm-item--have .prm-item__text { color: var(--c-phosphor); }
.prm-promise { flex-direction: row; align-items: center; margin-top: var(--s-4); padding: var(--s-3); border-width: 0; border-left-width: 6px; border-color: var(--c-phosphor); border-radius: var(--r-md); background-color: var(--c-phosphor-wash); }
.prm-promise__icon { width: 40px; height: 40px; flex-shrink: 0; margin-right: var(--s-3); --icon-color: var(--c-phosphor); }
.prm-promise__text { font-size: var(--fs-sm); color: var(--c-text); flex-shrink: 1; }
.prm-actions { margin-top: var(--s-4); }
.prm-actions--tight { margin-top: var(--s-3); }
.prm-gap { margin-left: var(--s-3); }

/* themes */
.prm-seg { flex-direction: row; }
.prm-theme { flex-grow: 1; flex-basis: 0; min-height: 140px; margin-right: var(--s-2); padding: var(--s-2) var(--s-1); align-items: center; justify-content: center; border-width: 0; border-radius: var(--r-md); background-color: var(--c-panel-sunken); }
.prm-theme.is-last { margin-right: 0; }
.prm-theme.is-selected { border-top-width: 3px; border-color: var(--c-cyan); background-color: var(--c-elev-2); }
.prm-theme.is-locked { opacity: 0.6; }
.prm-theme__mark { width: 32px; height: 32px; margin-bottom: var(--s-2); align-items: center; justify-content: center; }
.prm-theme__tick { display: none; width: 28px; height: 28px; --icon-color: var(--c-white); }
.prm-theme__lock { display: none; width: 28px; height: 28px; --icon-color: var(--c-text-dim); }
.prm-theme.is-selected .prm-theme__tick { display: flex; }
.prm-theme.is-locked .prm-theme__lock { display: flex; }
.prm-theme.is-locked .prm-theme__tick { display: none; }
.prm-theme__label { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-micro); letter-spacing: var(--ls-tight); color: var(--c-text-dim); margin-top: var(--s-2); white-space: normal; -unity-text-align: middle-center; }
.prm-theme.is-selected .prm-theme__label { color: var(--c-text); }
.prm-swatch { width: 56px; height: 16px; border-radius: var(--r-sm); }
.prm-swatch--phosphor { background-color: #A8D58A; }
.prm-swatch--cold { background-color: #8CC8D8; }
.prm-swatch--bone { background-color: #D9D2BE; }
.prm-swatch--verdigris { background-color: #7CC2AE; }
.prm-swatch--ash { background-color: #B9BEC6; }
.prm-note { margin-top: var(--s-3); }
.prm-note--first { margin-top: 0; }
.prm-ad > .ds-btn__label { font-size: var(--fs-xs); letter-spacing: var(--ls-label); white-space: normal; -unity-text-align: middle-center; }
.prm-stack { margin-top: var(--s-2); }

/* season link */
.prm-season { margin-top: var(--s-2); }
.prm-season__icon { width: 36px; height: 36px; margin-right: var(--s-3); --icon-color: var(--c-cyan); }
.prm-reason { margin-top: var(--s-3); min-height: 40px; }
