/* SEASON (F-048). Tokens only. Cyan = the track (interactive), violet = the premium pass, phosphor = unlocked. */

.ssn { flex-grow: 1; background-color: var(--c-world); }
.ssn-body { padding: var(--s-5) var(--s-5) var(--s-4) var(--s-5); }

.ssn-card { padding-bottom: var(--s-5); }
.ssn-rank { margin-top: var(--s-1); min-height: 96px; }
.ssn-rank__of { margin-left: var(--s-3); }
.ssn-meter { height: 16px; margin-top: var(--s-3); }
.ssn-xp { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-xs); color: var(--c-cyan); margin-top: var(--s-3); min-height: 36px; }
.ssn-note { margin-top: var(--s-2); }


/* reward rows: no boxes. A tonal plate for the rank, hairline divider between rows, one accent at most */
.ssn-r { align-items: center; padding: var(--s-3) 0; margin-bottom: 0; border-width: 0; border-bottom-width: 1px; border-color: var(--c-line); background-color: rgba(0, 0, 0, 0); }
.ssn-r__rank { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-md); color: var(--c-text-faint); width: 72px; height: 72px; flex-shrink: 0; margin-right: var(--s-3); -unity-text-align: middle-center; border-width: 0; border-radius: var(--r-md); background-color: var(--c-panel-sunken); }
.ssn-r__well { width: 56px; height: 56px; flex-shrink: 0; align-items: center; justify-content: center; margin-right: var(--s-3); border-width: 0; border-radius: var(--r-md); background-color: var(--c-panel-sunken); }
.ssn-r__icon { width: 34px; height: 34px; --icon-color: var(--c-text-faint); }
.ssn-r__body { flex-shrink: 1; flex-basis: 0; }
.ssn-r__name { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-xs); letter-spacing: var(--ls-label); color: var(--c-text-dim); white-space: normal; }
.ssn-r__state { -unity-font-definition: resource("Fonts/IBMPlexMono-Medium"); font-size: var(--fs-micro); color: var(--c-text-faint); margin-top: var(--s-1); white-space: normal; }
.ssn-r__codex { color: var(--c-text); margin-top: var(--s-2); }
.ssn-r__btn { width: 160px; margin-left: var(--s-3); padding: 0 var(--s-2); }
.ssn-r.is-unlocked > .ssn-r__rank { color: var(--c-phosphor); background-color: var(--c-phosphor-wash); }
.ssn-r.is-unlocked .ssn-r__well { background-color: var(--c-phosphor-wash); }
.ssn-r.is-unlocked .ssn-r__icon { --icon-color: var(--c-phosphor); }
.ssn-r.is-unlocked .ssn-r__name { color: var(--c-text); }
.ssn-r.is-unlocked .ssn-r__state { color: var(--c-phosphor); }
.ssn-r.is-equipped { background-color: var(--c-phosphor-wash); }
.ssn-reason { margin: var(--s-2) var(--s-5) var(--s-2) var(--s-5); min-height: 40px; }
