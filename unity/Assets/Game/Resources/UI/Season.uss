/* SEASON (F-048). Tokens only. Cyan = the track (interactive), violet = the premium pass, phosphor = unlocked. */

.ssn { flex-grow: 1; background-color: var(--c-world); }
.ssn-close { width: var(--touch); height: var(--touch); align-items: center; justify-content: center; border-width: 1px; border-radius: var(--r-md); border-color: var(--c-line-mid); background-color: var(--c-elev-2); }
.ssn-close:active { background-color: var(--c-cyan-wash); }
.ssn-close__x { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-md); color: var(--c-text-dim); }
.ssn-body { padding: var(--s-5) var(--s-5) var(--s-4) var(--s-5); }

.ssn-card { padding-bottom: var(--s-5); }
.ssn-rank { margin-top: var(--s-1); min-height: 96px; }
.ssn-rank__of { margin-left: var(--s-3); }
.ssn-meter { height: 16px; margin-top: var(--s-3); }
.ssn-xp { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-xs); color: var(--c-cyan); margin-top: var(--s-3); min-height: 36px; }
.ssn-note { font-size: var(--fs-micro); color: var(--c-text-dim); margin-top: var(--s-2); white-space: normal; }

.ssn-pass { padding: var(--s-3) var(--s-4); }
.ssn-pass__head { margin-bottom: 0; }
.ssn-pass__title { font-size: var(--fs-xs); letter-spacing: var(--ls-label); white-space: normal; }
.ssn-buy { width: 220px; margin-left: var(--s-3); padding: 0 var(--s-3); }
.ssn-buy > .ds-btn__label { font-size: var(--fs-xs); letter-spacing: var(--ls-label); color: var(--c-violet); }
.ssn-buy { border-color: var(--c-violet); background-color: var(--c-violet-wash); }

/* reward rows: rank plate, kind icon, name + state, optional equip */
.ssn-r { align-items: center; padding: var(--s-3); margin-bottom: var(--s-3); border-width: 1px; border-radius: var(--r-md); border-color: var(--c-line); border-top-color: var(--c-edge-hi); border-bottom-color: var(--c-edge-lo); background-color: var(--c-elev-1); }
.ssn-r__rank { -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold"); font-size: var(--fs-md); color: var(--c-text-faint); width: 72px; height: 72px; flex-shrink: 0; margin-right: var(--s-3); -unity-text-align: middle-center; border-width: 1px; border-radius: var(--r-md); border-color: var(--c-line); background-color: var(--c-panel-sunken); }
.ssn-r__well { width: 56px; height: 56px; flex-shrink: 0; align-items: center; justify-content: center; margin-right: var(--s-3); border-radius: var(--r-md); border-width: 1px; border-color: var(--c-line); background-color: var(--c-panel-sunken); }
.ssn-r__icon { width: 34px; height: 34px; --icon-color: var(--c-text-faint); }
.ssn-r__body { flex-shrink: 1; flex-basis: 0; }
.ssn-r__name { -unity-font-definition: resource("Fonts/ChakraPetch-Bold"); font-size: var(--fs-micro); letter-spacing: var(--ls-label); color: var(--c-text-dim); white-space: normal; }
.ssn-r__state { -unity-font-definition: resource("Fonts/IBMPlexMono-Medium"); font-size: var(--fs-micro); color: var(--c-text-faint); margin-top: var(--s-1); white-space: normal; }
.ssn-r__codex { -unity-font-definition: resource("Fonts/IBMPlexMono-Medium"); font-size: var(--fs-micro); color: var(--c-text); margin-top: var(--s-2); white-space: normal; }
.ssn-r__btn { width: 160px; margin-left: var(--s-3); padding: 0 var(--s-2); }
.ssn-r.is-premium { border-left-width: 4px; border-left-color: var(--c-violet-dim); }
.ssn-r.is-premium .ssn-r__state { color: var(--c-violet); }
.ssn-r.is-unlocked { border-color: var(--c-phosphor-dim); }
.ssn-r.is-unlocked > .ssn-r__rank { color: var(--c-phosphor); border-color: var(--c-phosphor-dim); background-color: var(--c-phosphor-wash); }
.ssn-r.is-unlocked .ssn-r__well { border-color: var(--c-phosphor-dim); background-color: var(--c-phosphor-wash); }
.ssn-r.is-unlocked .ssn-r__icon { --icon-color: var(--c-phosphor); }
.ssn-r.is-unlocked .ssn-r__name { color: var(--c-text); }
.ssn-r.is-unlocked .ssn-r__state { color: var(--c-phosphor); }
.ssn-r.is-equipped { background-color: var(--c-phosphor-wash); border-color: var(--c-phosphor); }
.ssn-reason { margin: var(--s-2) var(--s-5) var(--s-2) var(--s-5); min-height: 40px; }
