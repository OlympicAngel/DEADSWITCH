<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ds_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#E6111412">
    <TextView android:id="@+id/ds_threat" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="DEADSWITCH" android:textColor="#E8B45C" android:textSize="15sp" android:textStyle="bold" android:letterSpacing="0.1" />
    <TextView android:id="@+id/ds_heat" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#D8D1BC" android:textSize="13sp" android:layout_marginTop="4dp" android:fontFamily="monospace" />
    <TextView android:id="@+id/ds_next" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#A8D58A" android:textSize="13sp" android:layout_marginTop="2dp" android:fontFamily="monospace" />
</LinearLayout>
